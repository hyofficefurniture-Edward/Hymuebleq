---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Salón Premium Villas Lujo | Fabricante";
const pageDescription = "Mobiliario de salón premium para villas de lujo. Sofás modulares, mesas de mármol y acabados en acero PVD. Fabricación para proyectos residenciales exclusivos.";
const canonicalUrl = "/productos-residenciales/mobiliario-salon-premium-villas-lujo-espacios-amplos/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario de Salón Premium para Villas con Mármol y Acero",
    "description": "Mobiliario de salón premium para villas de lujo. Sofás modulares, mesas de mármol y acabados en acero PVD. Fabricación para proyectos residenciales ex",
    "category": "Villa",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Residencial", "item": "https://hymueble.com/productos-residenciales/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario de Salón Premium para Villas con Mármol y Acero"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Pueden fabricar un sofá de más de cinco metros?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Los sofás modulares se pueden extender todo lo que permita el espacio. Cada módulo se transporta por separado y se ensambla in situ."}}, {"@type": "Question", "name": "¿El mármol de las mesas necesita soporte especial?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. La estructura metálica interior se calcula según el tamaño y peso de la losa para evitar fisuras. Entregamos planos de anclaje."}}, {"@type": "Question", "name": "¿Pueden combinar piel y tela en el mismo sofá?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Es habitual combinar cuerpo en tela y cojines en piel, o viceversa. Realizamos muestras de la combinación elegida antes de fabricar."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-residenciales/">Mobiliario Residencial</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario de Salón Premium para Villas con Mármol y Acero</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-residenciales/res-11/res-11-01.jpg" alt="Mobiliario de Salón Premium para Villas con Mármol y Acero para proyectos residenciales y viviendas" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario de Salón Premium para Villas con Mármol y Acero</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-residenciales/res-11/res-11-01.jpg" alt="Mobiliario de Salón Premium para Villas con Mármol y Acero vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-11/res-11-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-11/res-11-02.jpg" alt="Mobiliario de Salón Premium para Villas con Mármol y Acero vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-11/res-11-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-11/res-11-03.jpg" alt="Mobiliario de Salón Premium para Villas con Mármol y Acero vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-11/res-11-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-11/res-11-04.jpg" alt="Mobiliario de Salón Premium para Villas con Mármol y Acero vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-11/res-11-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Villa</span>
        <h1>Mobiliario de Salón Premium para Villas con Mármol y Acero</h1>
        <p class="producto-intro">El mobiliario de salón premium para villas de lujo está pensado para espacios generosos donde el diseño debe imponer presencia sin sacrificar confort. Sofás modulares de gran formato, mesas de centro con tapas de mármol y detalles en acero PVD conforman una colección dirigida a proyectos residenciales exclusivos. Cada pieza se fabrica con materiales de alto rendimiento y acabados que cumplen normativas internacionales.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Los sofás modulares permiten configurar composiciones de más de cuatro metros, adaptándose a salones de doble altura o plantas abiertas. Los módulos se unen con sistemas ocultos que evitan movimientos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La espuma de alta resiliencia de 55 kg/m³ mantiene la forma del asiento tras 100.000 ciclos de compresión. Esta densidad garantiza que el sofá conserve su silueta original incluso en uso intensivo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las telas y pieles cumplen normas ignífugas CAL 117 y BS 5852, imprescindibles para proyectos comerciales e internacionales. Esta certificación agiliza la aprobación de obras en cualquier mercado.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los marcos interiores de madera de alerce secada en horno reducen la humedad por debajo del 10 %, evitando deformaciones. La combinación con acero PVD aporta solidez y un acabado metálico sofisticado.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La producción incluye prototipos a escala real y muestras de acabado para aprobación del cliente. Este proceso reduce cambios en obra y acelera la toma de decisiones del equipo de diseño.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Material</th><th>Uso</th><th>Plazo estimado</th></tr>
            </thead>
            <tbody>
              <tr><td>Sofá modular 4 m</td><td>Madera + piel</td><td>Salón principal villa</td><td>35-40 días</td></tr><tr><td>Mesa centro mármol</td><td>Acero PVD + mármol</td><td>Área recepción</td><td>25-30 días</td></tr><tr><td>Conjunto completo</td><td>Madera + mármol + metal</td><td>Salón + comedor</td><td>45-55 días</td></tr><tr><td>A medida</td><td>A especificación</td><td>Proyecto exclusivo</td><td>Según alcance</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Madera de alerce secada en horno</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Espuma</td>
                            <td class="spec-value">Alta resiliencia 55 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tapicería</td>
                            <td class="spec-value">Piel anilina, terciopelo performance</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mármol</td>
                            <td class="spec-value">Italiano seleccionado, espesor 20 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Metal</td>
                            <td class="spec-value">Acero inoxidable con PVD dorado, negro o niquel</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">BIFMA, SGS, CAL 117, BS 5852</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Configuración</td>
                            <td class="spec-value">Modular a medida</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Garantía</td>
                            <td class="spec-value">10 años estructural</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">1 proyecto completo</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos residenciales</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Salones principales de villas: crear zonas de estar amplias con sofás modulares y mesas de mármol.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Villas de alquiler de lujo: mobiliario que resiste el uso de huéspedes sin perder el nivel estético.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Residencias privadas internacionales: piezas certificadas para cumplir normativas de distintos países.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Pueden fabricar un sofá de más de cinco metros?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Los sofás modulares se pueden extender todo lo que permita el espacio. Cada módulo se transporta por separado y se ensambla in situ.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El mármol de las mesas necesita soporte especial?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. La estructura metálica interior se calcula según el tamaño y peso de la losa para evitar fisuras. Entregamos planos de anclaje.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Pueden combinar piel y tela en el mismo sofá?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Es habitual combinar cuerpo en tela y cojines en piel, o viceversa. Realizamos muestras de la combinación elegida antes de fabricar.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-residenciales/conjuntos-residenciales-integrales-dormitorio-salon-comedor/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-12/res-12-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Conjuntos</span>
            <h3>Conjuntos Residenciales Integrales de Dormitorio Salón y Comedor</h3>
          </div>
        </a>
        <a href="/productos-residenciales/suite-completa-mobiliario-apartamento-madera-natural/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-01/res-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Apartamento</span>
            <h3>Suite Completa de Mobiliario para Apartamento con Madera Natural</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-penthouse-lujo-medida-ffe-integral/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-02/res-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Penthouse</span>
            <h3>Mobiliario de Penthouse de Lujo a Medida con FF&E Integral</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión residencial para el hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-residenciales/res-11-sofa-modular-lujo-mesa-centro-marmol.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto residencial</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
  .card-mini-cat { display: block; font-size: 11px; color: var(--color-text-light, #6B6358); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
  .card-mini-info h3 { font-size: 14px; color: var(--color-text, #2C2416); line-height: 1.4; margin: 0; }
  .cross-domain-link { background: #F8F6F1; padding: 20px 0; border-top: 1px solid var(--color-border, #E8E3D9); text-align: center; }
  .cross-domain-link p { font-size: 14px; color: var(--color-text-light, #6B6358); margin: 0; }
  .cross-domain-link a { color: var(--color-primary, #1a3a5c); font-weight: 600; text-decoration: none; }
  .cross-domain-link a:hover { text-decoration: underline; }
