---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Equipamiento Llave en Mano Apartamentos | Fábrica";
const pageDescription = "Equipamiento llave en mano para apartamentos: salón, dormitorio, cocina y baño desde una sola fábrica. Plazos cortos y acabados personalizables para promotores.";
const canonicalUrl = "/productos-residenciales/equipamiento-llave-mano-apartamentos-fabrica-propia/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Equipamiento Llave en Mano para Apartamentos con Fábrica Propio",
    "description": "Equipamiento llave en mano para apartamentos: salón, dormitorio, cocina y baño desde una sola fábrica. Plazos cortos y acabados personalizables para p",
    "category": "Apartamento Llave en Mano",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Residencial", "item": "https://hymueble.com/productos-residenciales/"},
      {"@type": "ListItem", "position": 3, "name": "Equipamiento Llave en Mano para Apartamentos con Fábrica Propio"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Pueden adaptar el equipamiento a una marca de apartamentos?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Desarrollamos acabados, colores y detalles propios de la marca para que todos los apartamentos compartan identidad visual."}}, {"@type": "Question", "name": "¿Qué ocurre si hay retrasos en la obra?", "acceptedAnswer": {"@type": "Answer", "text": "Planificamos la producción en fases y almacenamos los lotes listos hasta que la obra esté preparada para recibirlos. Así evitamos daños por almacenaje prolongado en obra."}}, {"@type": "Question", "name": "¿El precio incluye transporte y montaje?", "acceptedAnswer": {"@type": "Answer", "text": "Ofrecemos opciones con suministro EXW o entrega llave en mano con montaje incluido. El presupuesto se ajusta a la opción que mejor se adapte al proyecto."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-residenciales/">Mobiliario Residencial</a>
        <span aria-hidden="true">›</span>
        <span>Equipamiento Llave en Mano para Apartamentos con Fábrica Propio</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-residenciales/res-08/res-08-01.jpg" alt="Equipamiento Llave en Mano para Apartamentos con Fábrica Propio para proyectos residenciales y viviendas" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Equipamiento Llave en Mano para Apartamentos con Fábrica Propio</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-residenciales/res-08/res-08-01.jpg" alt="Equipamiento Llave en Mano para Apartamentos con Fábrica Propio vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-08/res-08-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-08/res-08-02.jpg" alt="Equipamiento Llave en Mano para Apartamentos con Fábrica Propio vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-08/res-08-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-08/res-08-03.jpg" alt="Equipamiento Llave en Mano para Apartamentos con Fábrica Propio vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-08/res-08-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-08/res-08-04.jpg" alt="Equipamiento Llave en Mano para Apartamentos con Fábrica Propio vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-08/res-08-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Apartamento Llave en Mano</span>
        <h1>Equipamiento Llave en Mano para Apartamentos con Fábrica Propio</h1>
        <p class="producto-intro">El equipamiento llave en mano para apartamentos permite a promotores y gestores recibir la vivienda completa desde una única fuente. La fábrica propia controla cada etapa: diseño, producción de mobiliario fijo y suelto, acabados, embalaje y logística. Este modelo reduce los tiempos de coordinación y garantiza que salón, dormitorio, cocina y baño compartan un mismo criterio estético y técnico.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La producción integrada elimina intermediarios y reduce los plazos de entrega en un 20 % respecto a la compra dispersa. Todo se fabrica bajo el mismo techo, lo que facilita la coordinación de acabados y medidas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La maquinaria CNC asegura tolerancias inferiores a 0,2 mm en piezas modulares como cocinas y baños. Esta precisión permite un encaje perfecto en la obra, con mínimos retoques durante el montaje.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los tableros de alta densidad, con 780 kg/m³, resisten el uso intensivo y la humedad ambiental. Esta densidad superior evita que las puertas y cajones pierdan calibrado con el tiempo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los acabados antiarañazos y melaminas hidrófugas pasan más de 1.500 ciclos de abrasión sin deterioro. Esta resistencia es fundamental en apartamentos de alquiler o uso corporativo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El embalaje se planifica por vivienda y por estancia, con manuales de montaje específicos. El instalador local recibe todo lo necesario para montar el apartamento en una sola jornada.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Material</th><th>Uso</th><th>Plazo estimado</th></tr>
            </thead>
            <tbody>
              <tr><td>Estudio equipado</td><td>MDF HMR + melamina</td><td>Alquiler urbano</td><td>20-25 días</td></tr><tr><td>Apartamento 1-2 hab.</td><td>MDF + chapa</td><td>Venta o alquiler</td><td>25-30 días</td></tr><tr><td>Apartamento premium</td><td>Roble + laca</td><td>Residencia corporativa</td><td>35-40 días</td></tr><tr><td>Torre completa</td><td>A especificación</td><td>Promoción completa</td><td>Por fases</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Base</td>
                            <td class="spec-value">Tablero HMR hidrófugo, densidad 780 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Melamina antiarañazos, laca UV</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Herrajes</td>
                            <td class="spec-value">Blum/DTC, 60.000 ciclos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cocina</td>
                            <td class="spec-value">Módulos base y colgantes con cajones soft-close</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Baño</td>
                            <td class="spec-value">Vanidad suspendida con lavamanos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dormitorio</td>
                            <td class="spec-value">Cama, mesillas y armario coordinados</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Salón</td>
                            <td class="spec-value">Sofá, mesa de centro y almacenaje</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 apartamentos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo</td>
                            <td class="spec-value">20-40 días según tipología</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos residenciales</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Promociones de vivienda nueva: entregar apartamentos listos para estrenar con mobiliario completo.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Residencias corporativas: equipar suites para empleados o ejecutivos con plazos y acabados controlados.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Edificios de apartamentos turísticos: dotar de mobiliario duradero y homogéneo para gestión hotelera.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Pueden adaptar el equipamiento a una marca de apartamentos?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Desarrollamos acabados, colores y detalles propios de la marca para que todos los apartamentos compartan identidad visual.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué ocurre si hay retrasos en la obra?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Planificamos la producción en fases y almacenamos los lotes listos hasta que la obra esté preparada para recibirlos. Así evitamos daños por almacenaje prolongado en obra.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El precio incluye transporte y montaje?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Ofrecemos opciones con suministro EXW o entrega llave en mano con montaje incluido. El presupuesto se ajusta a la opción que mejor se adapte al proyecto.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-residenciales/mobiliario-modular-apartamentos-servicio-alto-standing/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-09/res-09-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Apartamento de Servicio</span>
            <h3>Mobiliario Modular para Apartamentos de Servicio de Alto Standing</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-bano-medida-villas-exclusivas-piedra-natural/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-10/res-10-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Baño</span>
            <h3>Mobiliario de Baño a Medida con Mármol para Villas Exclusivas</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-salon-premium-villas-lujo-espacios-amplos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-11/res-11-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Villa</span>
            <h3>Mobiliario de Salón Premium para Villas con Mármol y Acero</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión residencial para el hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-residenciales/res-08-pack-muebles-completo-estrenar-apartamento.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto residencial</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
  .card-mini-cat { display: block; font-size: 11px; color: var(--color-text-light, #6B6358); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
  .card-mini-info h3 { font-size: 14px; color: var(--color-text, #2C2416); line-height: 1.4; margin: 0; }
  .cross-domain-link { background: #F8F6F1; padding: 20px 0; border-top: 1px solid var(--color-border, #E8E3D9); text-align: center; }
  .cross-domain-link p { font-size: 14px; color: var(--color-text-light, #6B6358); margin: 0; }
  .cross-domain-link a { color: var(--color-primary, #1a3a5c); font-weight: 600; text-decoration: none; }
  .cross-domain-link a:hover { text-decoration: underline; }
