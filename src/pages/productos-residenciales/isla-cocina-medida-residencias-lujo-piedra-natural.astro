---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Isla Cocina Medida Residencias Lujo | Fabricante";
const pageDescription = "Islas de cocina a medida con piedra natural, cajones soft-close y configuración personalizable. Soluciones FF&E para residencias de lujo y proyectos de alto standing.";
const canonicalUrl = "/productos-residenciales/isla-cocina-medida-residencias-lujo-piedra-natural/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Isla de Cocina a Medida con Encimera de Piedra Natural",
    "description": "Islas de cocina a medida con piedra natural, cajones soft-close y configuración personalizable. Soluciones FF&E para residencias de lujo y proyectos d",
    "category": "Cocina",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Residencial", "item": "https://hymueble.com/productos-residenciales/"},
      {"@type": "ListItem", "position": 3, "name": "Isla de Cocina a Medida con Encimera de Piedra Natural"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Pueden integrar la placa y el horno en la isla?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Diseñamos la isla con huecos, conexiones eléctricas y salida de humos según los electrodomésticos que elijas. Entregamos planos de instalación para el equipo de obra."}}, {"@type": "Question", "name": "¿La piedra sinterizada resiste el calor de las ollas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. La piedra sinterizada soporta temperaturas superiores a 200 °C sin dañarse. Aun así, recomendamos usar salvamanteles para prolongar el acabado."}}, {"@type": "Question", "name": "¿Ofrecen muestras de materiales antes de fabricar?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Enviamos muestras de piedra, chapas y herrajes para aprobación. También realizamos un renderizado de la isla en tu cocina antes de iniciar la producción."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-residenciales/">Mobiliario Residencial</a>
        <span aria-hidden="true">›</span>
        <span>Isla de Cocina a Medida con Encimera de Piedra Natural</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-residenciales/res-03/res-03-01.jpg" alt="Isla de Cocina a Medida con Encimera de Piedra Natural para proyectos residenciales y viviendas" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Isla de Cocina a Medida con Encimera de Piedra Natural</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-residenciales/res-03/res-03-01.jpg" alt="Isla de Cocina a Medida con Encimera de Piedra Natural vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-03/res-03-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-03/res-03-02.jpg" alt="Isla de Cocina a Medida con Encimera de Piedra Natural vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-03/res-03-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-03/res-03-03.jpg" alt="Isla de Cocina a Medida con Encimera de Piedra Natural vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-03/res-03-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-03/res-03-04.jpg" alt="Isla de Cocina a Medida con Encimera de Piedra Natural vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-03/res-03-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Cocina</span>
        <h1>Isla de Cocina a Medida con Encimera de Piedra Natural</h1>
        <p class="producto-intro">La isla de cocina a medida para residencias de lujo combina diseño arquitectónico con funcionalidad profesional. Fabricada con estructuras multicapa de madera sólida, soportes reforzados para losas de piedra y sistemas de cierre silencioso, cada isla se convierte en el centro de trabajo de una cocina de alto standing. El servicio abarca desde la selección de mármoles y cuarzos hasta la integración de electrodomésticos y puntos de iluminación.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La estructura interior utiliza contrachapado marino y refuerzos metálicos capaces de soportar losas de piedra natural de hasta 500 kg. Este refuerzo evita fisuras y asentamientos en encimeras de gran formato, un problema habitual en islas de baja calidad.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las encimeras se fabrican con mármol Calacatta, cuarzo tecnológico o piedra sinterizada, con cantos en inglete de menos de 0,5 mm de separación. El acabado nanotecnológico anti-huellas mantiene la superficie limpia incluso en uso intensivo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los cajones y gavetas incorporan correderas Blum o Hettich de cierre suave con capacidad de carga de hasta 70 kg. Esta resistencia permite almacenar ollas, electrodomésticos pequeños y vajilla sin deterioro del mecanismo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El grado de personalización alcanza el 95 %: se pueden integrar botelleros climatizados, cajones para cuchillos, enchufes embutidos y puntos de carga USB. Esta flexibilidad permite responder a los requerimientos específicos de cada proyecto residencial.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El proceso de producción incluye un ensamblaje en fábrica y desmontaje por módulos para facilitar el transporte y montaje final. Esta metodología reduce los errores en obra y acelera la puesta en marcha de la cocina.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Material</th><th>Uso</th><th>Plazo estimado</th></tr>
            </thead>
            <tbody>
              <tr><td>Isla lineal 2,4 m</td><td>Cuarzo + madera</td><td>Cocina residencial</td><td>25-30 días</td></tr><tr><td>Isla con península</td><td>Mármol + chapa</td><td>Penthouse</td><td>30-40 días</td></tr><tr><td>Isla con barra</td><td>Piedra sinterizada</td><td>Vivienda familiar</td><td>35-45 días</td></tr><tr><td>A medida integral</td><td>A especificación</td><td>Proyecto de lujo</td><td>Según diseño</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Encimera</td>
                            <td class="spec-value">Mármol Calacatta, cuarzo o piedra sinterizada</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Contrachapado marino / multicapa macizo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Capacidad de carga</td>
                            <td class="spec-value">Reforzada hasta 500 kg en zona de piedra</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabado superficie</td>
                            <td class="spec-value">Nanotecnología anti-huellas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cajones</td>
                            <td class="spec-value">Soft-close, carga 70 kg, guías telescópicas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Herrajes</td>
                            <td class="spec-value">Blum/Hettich con 60.000 ciclos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">FSC, SGS no tóxico</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">1 unidad para proyecto; 5 para catálogo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-45 días según material</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos residenciales</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Cocinas de penthouse: isla central que organiza cocción, almacenamiento y desayuno en un mismo módulo de gran formato.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Viviendas unifamiliares de lujo: configuración con barra para comidas informales y zona de preparación amplia.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Proyectos de interiorismo: integración de electrodomésticos, iluminación y acabados a medida bajo plano del diseñador.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Pueden integrar la placa y el horno en la isla?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Diseñamos la isla con huecos, conexiones eléctricas y salida de humos según los electrodomésticos que elijas. Entregamos planos de instalación para el equipo de obra.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La piedra sinterizada resiste el calor de las ollas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. La piedra sinterizada soporta temperaturas superiores a 200 °C sin dañarse. Aun así, recomendamos usar salvamanteles para prolongar el acabado.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Ofrecen muestras de materiales antes de fabricar?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Enviamos muestras de piedra, chapas y herrajes para aprobación. También realizamos un renderizado de la isla en tu cocina antes de iniciar la producción.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-residenciales/mobiliario-salon-dormitorio-moderno-madera-certificada/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-04/res-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Salón y Dormitorio</span>
            <h3>Mobiliario de Salón y Dormitorio Moderno con Madera Certificada FSC</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-vivienda-multifamiliar-entrega-llave-mano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-05/res-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Vivienda Multifamiliar</span>
            <h3>Mobiliario para Vivienda Multifamiliar con Entrega Llave en Mano</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-residencial-premium-proyectos-lujo-volumen/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-06/res-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Residencial Premium</span>
            <h3>Mobiliario Residencial Premium para Proyectos de Lujo por Volumen</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión residencial para el hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-residenciales/res-03-isla-cocina-central-encimera-piedra-natural.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto residencial</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
