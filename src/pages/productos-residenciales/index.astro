---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Residencial - Mobiliario para Viviendas y Promociones | HYMUEBLE";
const pageDescription = "Fabricante de mobiliario residencial. 12 productos para apartamentos, viviendas multifamiliares, villas y residencias premium. Fabricacion a medida para promotores y proyectos residenciales.";
const canonicalUrl = "/productos-residenciales/";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath={canonicalUrl}>
  <article class="producto-listing">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario Residencial</span>
      </div>
    </nav>

    <div class="listing-header">
      <div class="content-container">
        <h1>Mobiliario Residencial</h1>
        <p>Fabricante de mobiliario residencial con 12 productos especializados. Desde suites completas para apartamentos hasta mobiliario premium para villas y aticos, pasando por cocinas, banos y soluciones compactas para viviendas pequenas. Fabricacion a medida para promotores, constructoras y proyectos llave en mano.</p>
      </div>
    </div>

    <section class="section">
      <div class="content-container">
        <div class="productos-grid">
        <a href="/productos-residenciales/suite-completa-mobiliario-apartamento-madera-natural/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-01/res-01-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Apartamento</span>
            <h3>Suite Completa de Mobiliario para Apartamento con Madera Natural</h3>
            <p>Suite completa de mobiliario para apartamento: dormitorio, salón, cocina y baño en un solo paquete. ...</p>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-penthouse-lujo-medida-ffe-integral/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-02/res-02-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Penthouse</span>
            <h3>Mobiliario de Penthouse de Lujo a Medida con FF&E Integral</h3>
            <p>Mobiliario de penthouse de lujo a medida para proyectos FF&E. Cabeceros escultóricos, mármol bookmat...</p>
          </div>
        </a>
        <a href="/productos-residenciales/isla-cocina-medida-residencias-lujo-piedra-natural/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-03/res-03-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Cocina</span>
            <h3>Isla de Cocina a Medida con Encimera de Piedra Natural</h3>
            <p>Islas de cocina a medida con piedra natural, cajones soft-close y configuración personalizable. Solu...</p>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-salon-dormitorio-moderno-madera-certificada/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-04/res-04-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Salón y Dormitorio</span>
            <h3>Mobiliario de Salón y Dormitorio Moderno con Madera Certificada FSC</h3>
            <p>Mobiliario moderno para salón y dormitorio con madera FSC, acabados al agua y uniones ocultas. Línea...</p>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-vivienda-multifamiliar-entrega-llave-mano/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-05/res-05-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Vivienda Multifamiliar</span>
            <h3>Mobiliario para Vivienda Multifamiliar con Entrega Llave en Mano</h3>
            <p>Mobiliario para vivienda multifamiliar: apartamentos completos con entrega llave en mano. Materiales...</p>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-residencial-premium-proyectos-lujo-volumen/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-06/res-06-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Residencial Premium</span>
            <h3>Mobiliario Residencial Premium para Proyectos de Lujo por Volumen</h3>
            <p>Mobiliario residencial premium para proyectos de lujo por volumen. Camas, sofás, armarios y cocinas ...</p>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-ahorra-espacio-viviendas-compactas-estudios/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-07/res-07-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Espacios Reducidos</span>
            <h3>Mobiliario Ahorra Espacio para Viviendas Compactas y Estudios</h3>
            <p>Mobiliario ahorra espacio para estudios y viviendas compactas. Camas con almacenaje, mesas anidables...</p>
          </div>
        </a>
        <a href="/productos-residenciales/equipamiento-llave-mano-apartamentos-fabrica-propia/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-08/res-08-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Apartamento Llave en Mano</span>
            <h3>Equipamiento Llave en Mano para Apartamentos con Fábrica Propio</h3>
            <p>Equipamiento llave en mano para apartamentos: salón, dormitorio, cocina y baño desde una sola fábric...</p>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-modular-apartamentos-servicio-alto-standing/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-residenciales/res-09/res-09-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Apartamento de Servicio</span>
            <h3>Mobiliario Modular para Apartamentos de Servicio de Alto Standing</h3>
            <p>Mobiliario modular para apartamentos de servicio de alto standing. Diseños flexibles, acabados resis...</p>
          </div>
        </a>
        </div>
        <div class="pagination"><a href="/productos-residenciales/pagina-2/" class="btn-page">Página 2 →</a></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-listing { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .listing-header { background: var(--color-surface, #FFFFFF); padding: 48px 0; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .listing-header h1 { font-size: 32px; margin-bottom: 12px; color: var(--color-text, #2C2416); }
  .listing-header p { font-size: 15px; color: var(--color-text-light, #6B6358); max-width: 800px; }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; }
  .productos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .producto-card { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .producto-card-img { height: 220px; background: #EEF0F3; background-size: cover; background-position: center; }
  .producto-card-info { padding: 20px; }
  .producto-card-cat { display: block; font-size: 11px; color: var(--color-text-light, #6B6358); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
  .producto-card-info h3 { font-size: 16px; color: var(--color-text, #2C2416); line-height: 1.4; margin: 0 0 8px; }
  .producto-card-info p { font-size: 13px; color: var(--color-text-light, #6B6358); line-height: 1.6; margin: 0; }
  .pagination { text-align: center; margin-top: 40px; }
  .btn-page { display: inline-block; padding: 12px 28px; background: var(--color-primary, #1a3a5c); color: #fff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 14px; }
  .btn-page:hover { background: #142d4a; }
  @media (max-width: 768px) { .productos-grid { grid-template-columns: 1fr; } .listing-header h1 { font-size: 24px; } }
</style>
