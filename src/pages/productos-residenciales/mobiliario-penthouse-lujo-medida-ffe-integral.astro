---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Penthouse Lujo Medida | FF&E Integral";
const pageDescription = "Mobiliario de penthouse de lujo a medida para proyectos FF&E. Cabeceros escultóricos, mármol bookmatched y acabados artesanales. Fabricación para desarrollos premium.";
const canonicalUrl = "/productos-residenciales/mobiliario-penthouse-lujo-medida-ffe-integral/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario de Penthouse de Lujo a Medida con FF&E Integral",
    "description": "Mobiliario de penthouse de lujo a medida para proyectos FF&E. Cabeceros escultóricos, mármol bookmatched y acabados artesanales. Fabricación para desa",
    "category": "Penthouse",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Residencial", "item": "https://hymueble.com/productos-residenciales/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario de Penthouse de Lujo a Medida con FF&E Integral"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Trabajan con estudios de interiorismo internacionales?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Recibimos planos, moodboards y especificaciones de diseñadores de cualquier país y aportamos dibujos técnicos, renderizados y muestras para validar cada pieza antes de la fabricación."}}, {"@type": "Question", "name": "¿Pueden reproducir materiales específicos del proyecto?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Localizamos mármoles, chapas, tejidos y herrajes según las muestras del cliente. También desarrollamos acabados personalizados bajo petición."}}, {"@type": "Question", "name": "¿Cómo se gestiona la logística hasta el ático?", "acceptedAnswer": {"@type": "Answer", "text": "Organizamos embalaje profesional, seguro de transporte y descarga en planta. Para piezas de gran tamaño realizamos visita previa al edificio para verificar accesos y montacargas."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-residenciales/">Mobiliario Residencial</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario de Penthouse de Lujo a Medida con FF&E Integral</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-residenciales/res-02/res-02-01.jpg" alt="Mobiliario de Penthouse de Lujo a Medida con FF&E Integral para proyectos residenciales y viviendas" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario de Penthouse de Lujo a Medida con FF&E Integral</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-residenciales/res-02/res-02-01.jpg" alt="Mobiliario de Penthouse de Lujo a Medida con FF&E Integral vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-02/res-02-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-02/res-02-02.jpg" alt="Mobiliario de Penthouse de Lujo a Medida con FF&E Integral vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-02/res-02-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-02/res-02-03.jpg" alt="Mobiliario de Penthouse de Lujo a Medida con FF&E Integral vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-02/res-02-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-02/res-02-04.jpg" alt="Mobiliario de Penthouse de Lujo a Medida con FF&E Integral vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-02/res-02-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Penthouse</span>
        <h1>Mobiliario de Penthouse de Lujo a Medida con FF&E Integral</h1>
        <p class="producto-intro">El mobiliario de penthouse de lujo a medida está pensado para áticos con vistas panorámicas y espacios generosos. Cada pieza combina maderas macizas de primera calidad, mármoles seleccionados y tejidos de alto rendimiento para crear ambientes que reflejen exclusividad. Desde cabeceros de gran formato hasta tocadores de mármol, ofrecemos un servicio FF&E integral que abarca diseño, fabricación, logística y montaje final en obra.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La precisión del mecanizado CNC permite tolerancias inferiores a 1 mm en uniones complejas, lo que resulta esencial para cabeceros con paneles geométricos y revestimientos tridimensionales. Esta exactitud reduce el tiempo de ajuste en obra y garantiza acabados impecables en proyectos de gran escala.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los materiales superan las pruebas de abrasión Martindale con más de 50.000 ciclos, lo que garantiza que sofás, butacas y cabeceros mantengan su apariencia en entornos de alto tránsito. Esta durabilidad es clave para desarrollos de lujo destinados al alquiler o a la venta premium.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El proceso de lacado UV en siete capas incrementa la dureza superficial en un 45 % respecto a acabados convencionales. Esta protección adicional resiste rayones, productos de limpieza y la exposición a la luz solar directa que entra por grandes ventanales de ático.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La capacidad productiva permite fabricar más de 500 piezas personalizadas al mes bajo un mismo control de calidad. Esta escala resulta ideal para promotores que necesitan equipar varias unidades de penthouse manteniendo una estética uniforme y plazos de entrega predecibles.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El servicio incluye planos técnicos, renderizado de ambientes y muestras de materiales para aprobación del equipo de interiorismo. De este modo, cada proyecto se valida antes de entrar en producción, minimizando cambios durante la ejecución.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Material</th><th>Uso</th><th>Plazo estimado</th></tr>
            </thead>
            <tbody>
              <tr><td>Dormitorio principal</td><td>Roble + mármol Calacatta</td><td>Ático premium</td><td>35-40 días</td></tr><tr><td>Salón formal</td><td>Madera maciza + terciopelo</td><td>Recepciones privadas</td><td>30-35 días</td></tr><tr><td>Suite completa</td><td>Madera + metal PVD + mármol</td><td>Penthouse integral</td><td>45-55 días</td></tr><tr><td>A medida</td><td>A especificación del diseñador</td><td>Proyecto exclusivo</td><td>Según alcance</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Madera maciza de abedul/roble secado en horno</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acolchados</td>
                            <td class="spec-value">Espuma de alta resiliencia 45-55 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mármol</td>
                            <td class="spec-value">Calacatta/selecto, espesor 20 mm, canto pulido</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Laca mate/brillo, hoja de oro aplicada a mano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tejidos</td>
                            <td class="spec-value">Terciopelo performance, piel anilina, seda mezcla</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, BIFMA, FSC</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tolerancia</td>
                            <td class="spec-value">±1 mm en uniones y encajes</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">1 penthouse completo o 20 piezas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Garantía estructural</td>
                            <td class="spec-value">10 años</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos residenciales</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Áticos de edificios de lujo: equipamiento integral de dormitorios, salones y áreas de baño con materiales de alto nivel.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Proyectos FF&E residenciales: coordinación completa de mobiliario fijo y loose furniture bajo un mismo proveedor.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Viviendas de marca para inversores: creación de ambientes diferenciadores que elevan el valor percibido de la propiedad.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Trabajan con estudios de interiorismo internacionales?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Recibimos planos, moodboards y especificaciones de diseñadores de cualquier país y aportamos dibujos técnicos, renderizados y muestras para validar cada pieza antes de la fabricación.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Pueden reproducir materiales específicos del proyecto?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Localizamos mármoles, chapas, tejidos y herrajes según las muestras del cliente. También desarrollamos acabados personalizados bajo petición.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Cómo se gestiona la logística hasta el ático?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Organizamos embalaje profesional, seguro de transporte y descarga en planta. Para piezas de gran tamaño realizamos visita previa al edificio para verificar accesos y montacargas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-residenciales/isla-cocina-medida-residencias-lujo-piedra-natural/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-03/res-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Cocina</span>
            <h3>Isla de Cocina a Medida con Encimera de Piedra Natural</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-salon-dormitorio-moderno-madera-certificada/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-04/res-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Salón y Dormitorio</span>
            <h3>Mobiliario de Salón y Dormitorio Moderno con Madera Certificada FSC</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-vivienda-multifamiliar-entrega-llave-mano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-05/res-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Vivienda Multifamiliar</span>
            <h3>Mobiliario para Vivienda Multifamiliar con Entrega Llave en Mano</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión residencial para el hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-residenciales/res-02-muebles-lujo-atico-marmol-madera-noble.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto residencial</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
  .card-mini-cat { display: block; font-size: 11px; color: var(--color-text-light, #6B6358); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
