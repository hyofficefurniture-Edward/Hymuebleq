---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Suite Completa Mobiliario Apartamento | Fabricante Proyectos";
const pageDescription = "Suite completa de mobiliario para apartamento: dormitorio, salón, cocina y baño en un solo paquete. Solución llave en mano para promotores y proyectos residenciales.";
const canonicalUrl = "/productos-residenciales/suite-completa-mobiliario-apartamento-madera-natural/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Suite Completa de Mobiliario para Apartamento con Madera Natural",
    "description": "Suite completa de mobiliario para apartamento: dormitorio, salón, cocina y baño en un solo paquete. Solución llave en mano para promotores y proyectos",
    "category": "Apartamento",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Residencial", "item": "https://hymueble.com/productos-residenciales/"},
      {"@type": "ListItem", "position": 3, "name": "Suite Completa de Mobiliario para Apartamento con Madera Natural"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Pueden adaptar las medidas a apartamentos pequeños?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El equipo de ingeniería revisa los planos de cada vivienda y ajusta las medidas de camas, armarios y cocina para sacar el máximo rendimiento a cada metro cuadrado sin sacrificar funcionalidad. Se entregan planos CAD aprobados antes de fabricar."}}, {"@type": "Question", "name": "¿Incluyen el montaje en obra?", "acceptedAnswer": {"@type": "Answer", "text": "Ofrecemos dos modalidades: suministro de kits con manual de montaje para equipos locales, o servicio completo de instalación con técnicos especializados. El montaje de un apartamento completo requiere entre 4 y 6 horas."}}, {"@type": "Question", "name": "¿Cuál es el volumen mínimo para un pedido?", "acceptedAnswer": {"@type": "Answer", "text": "El pedido mínimo es de 10 apartamentos equipados, aunque también podemos trabajar por metros cuadrados o número de piezas equivalente. Para proyectos grandes se aplican condiciones comerciales escalonadas."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-residenciales/">Mobiliario Residencial</a>
        <span aria-hidden="true">›</span>
        <span>Suite Completa de Mobiliario para Apartamento con Madera Natural</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-residenciales/res-01/res-01-01.jpg" alt="Suite Completa de Mobiliario para Apartamento con Madera Natural para proyectos residenciales y viviendas" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Suite Completa de Mobiliario para Apartamento con Madera Natural</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-residenciales/res-01/res-01-01.jpg" alt="Suite Completa de Mobiliario para Apartamento con Madera Natural vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-01/res-01-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-01/res-01-02.jpg" alt="Suite Completa de Mobiliario para Apartamento con Madera Natural vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-01/res-01-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-01/res-01-03.jpg" alt="Suite Completa de Mobiliario para Apartamento con Madera Natural vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-01/res-01-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-residenciales/res-01/res-01-04.jpg" alt="Suite Completa de Mobiliario para Apartamento con Madera Natural vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-residenciales/res-01/res-01-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Apartamento</span>
        <h1>Suite Completa de Mobiliario para Apartamento con Madera Natural</h1>
        <p class="producto-intro">La suite completa de mobiliario para apartamento integra salón, dormitorio, cocina y baño en un único paquete coordinado. Diseñada para promotores de edificios residenciales y gestores de viviendas en alquiler, cada pieza se fabrica con tableros E1, chapas de madera natural y herrajes de cierre suave. El resultado es un ambiente visualmente armónico que reduce los tiempos de montaje en obra y ofrece a los futuros inquilinos un hogar listo para habitar desde el primer día.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El paquete incluye cama, mesillas, armario, sofá, mesa de centro, muebles de cocina y lavabo, todos con un mismo lenguaje de acabados y tiradores. Esta coordinación evita incompatibilidades de tonos entre estancias y permite entregar el apartamento completo en una sola fase de obra, sin depender de múltiples proveedores.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los tableros E1 con chapa de roble o nogal se seleccionan por su estabilidad dimensional en climas cálidos y húmedos. Las superficies reciben un tratamiento antiarañazos que soporta el uso continuo de inquilinos, manteniendo el aspecto nuevo durante más tiempo en proyectos de alquiler de larga duración.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las bisagras y correderas Blum o Hettich garantizan 60.000 ciclos de apertura sin pérdida de suavidad. En proyectos de alta rotación, como apartamentos turísticos o corporativos, este hardware reduce las incidencias de mantenimiento y alarga la vida útil de cocinas y armarios.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El equipo técnico elabora planos de distribución ajustados a la tipología de cada vivienda, desde estudios de 35 m² hasta dúplex de 90 m². Esta personalización incluye ajustes de medidas, acabados y configuración de almacenamiento, con prototipos disponibles antes de la producción en serie.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La entrega se organiza por ambientes en kits numerados, lo que agiliza el montaje in situ y minimiza errores de instalación. Los plazos de fabricación se ajustan al calendario del proyecto, con capacidad para suministrar de 20 a 200 apartamentos por fase.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Material principal</th><th>Uso</th><th>Plazo estimado</th></tr>
            </thead>
            <tbody>
              <tr><td>Estudio compacto</td><td>E1 MDF + chapa natural</td><td>Alquiler residencial</td><td>25-30 días</td></tr><tr><td>Apartamento 2 hab.</td><td>E1 MDF + laca mate</td><td>Venta directa</td><td>30-35 días</td></tr><tr><td>Dúplex premium</td><td>Roble macizo + mármol</td><td>Vivienda de lujo</td><td>40-50 días</td></tr><tr><td>A medida</td><td>A especificación</td><td>Proyecto personalizado</td><td>Según volumen</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Tablero MDF E1 con chapa de roble, nogal o laca mate</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ambientes incluidos</td>
                            <td class="spec-value">Dormitorio, salón, cocina y baño</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cama</td>
                            <td class="spec-value">Estructura king/queen con cabecero acolchado en tela de 1,8 m</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Armario</td>
                            <td class="spec-value">Módulo de 2 a 3 puertas con interior configurable</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cocina</td>
                            <td class="spec-value">Gabinetes base y colgantes con cajones soft-close</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Baño</td>
                            <td class="spec-value">Vanidad suspendida con lavamanos integrado y espejo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Herrajes</td>
                            <td class="spec-value">Bisagras y correderas Blum/Hettich</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa natural, laca mate o alto brillo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 apartamentos o equivalente en piezas</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos residenciales</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Edificios de viviendas en alquiler: entrega de apartamentos completos con una estética uniforme que acelera el alquiler y reduce vacantes.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Proyectos de apartamentos turísticos: mobiliario duradero y fácil de mantener para pisos de corta y media estancia.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Residencias corporativas: suites equipadas para ejecutivos con diseño profesional y materiales de alto rendimiento.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Pueden adaptar las medidas a apartamentos pequeños?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El equipo de ingeniería revisa los planos de cada vivienda y ajusta las medidas de camas, armarios y cocina para sacar el máximo rendimiento a cada metro cuadrado sin sacrificar funcionalidad. Se entregan planos CAD aprobados antes de fabricar.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Incluyen el montaje en obra?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Ofrecemos dos modalidades: suministro de kits con manual de montaje para equipos locales, o servicio completo de instalación con técnicos especializados. El montaje de un apartamento completo requiere entre 4 y 6 horas.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Cuál es el volumen mínimo para un pedido?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El pedido mínimo es de 10 apartamentos equipados, aunque también podemos trabajar por metros cuadrados o número de piezas equivalente. Para proyectos grandes se aplican condiciones comerciales escalonadas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-residenciales/mobiliario-penthouse-lujo-medida-ffe-integral/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-02/res-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Penthouse</span>
            <h3>Mobiliario de Penthouse de Lujo a Medida con FF&E Integral</h3>
          </div>
        </a>
        <a href="/productos-residenciales/isla-cocina-medida-residencias-lujo-piedra-natural/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-03/res-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Cocina</span>
            <h3>Isla de Cocina a Medida con Encimera de Piedra Natural</h3>
          </div>
        </a>
        <a href="/productos-residenciales/mobiliario-salon-dormitorio-moderno-madera-certificada/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-residenciales/res-04/res-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Salón y Dormitorio</span>
            <h3>Mobiliario de Salón y Dormitorio Moderno con Madera Certificada FSC</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión residencial para el hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-residenciales/res-01-conjunto-muebles-apartamento-estilo-actual.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto residencial</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
