---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Seating Corporativo Integral | Fabricante Sillería B2B";
const pageDescription = "Solución integral de seating para corporativos. Sillas de reunión, butacas de espera y sillones ejecutivos en una línea coordinada. Certificación BIFMA. Pedido mínimo 50 unidades.";
const canonicalUrl = "/productos-oficina/solucion-integral-seating-corporativos/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Solución Integral de Seating para Corporativos",
    "description": "Solución integral de seating para corporativos. Sillas de reunión, butacas de espera y sillones ejecutivos en una línea coordinada. Certificación BIFMA. Pedido mínimo 50 unidades.",
    "category": "Seating Comercial",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Solución Integral de Seating para Corporativos"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Se pueden mezclar tipologías en el mismo pedido?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El pedido mínimo de 50 unidades puede combinar cualquier tipología de la línea. Cada tipología mantiene los mismos acabados de estructura y tapizado, garantizando la coherencia estética del conjunto."}}, {"@type": "Question", "name": "¿Las fundas se pueden reemplazar después de la compra?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Las fundas desenfundables se pueden pedir por separado en cualquier color del catálogo, sin necesidad de cambiar la silla. Esto permite renovar el aspecto del mobiliario cuando se actualiza la imagen corporativa."}}, {"@type": "Question", "name": "¿Los componentes mecánicos son intercambiables entre tipologías?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El gas lift, el mecanismo sincronizado, los reposabrazos y las ruedas son comunes a todas las tipologías que los incorporan. El equipo de mantenimiento solo necesita un kit de recambios para todo el parque de sillería."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Solución Integral de Seating para Corporativos</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-12/of-12-01.jpg" alt="Solución Integral de Seating para Corporativos para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Solución Integral de Seating para Corporativos</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-12/of-12-01.jpg" alt="Solución Integral de Seating para Corporativos para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-12/of-12-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-12/of-12-02.jpg" alt="Detalle Solución Integral de Seating para Corporativos corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-12/of-12-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-12/of-12-03.jpg" alt="Solución Integral de Seating para Corporativos mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-12/of-12-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-12/of-12-04.jpg" alt="Solución Integral de Seating para Corporativos instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-12/of-12-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Seating Comercial</span>
        <h1>Solución Integral de Seating para Corporativos</h1>
        <p class="producto-intro">La solución integral de seating para corporativos reúne en una sola línea coordinada todas las tipologías de sillería que necesita una oficina: sillas operativas, sillas de reunión, butacas de espera y sillones ejecutivos. Todas comparten el mismo lenguaje de diseño, los mismos acabados y la misma certificación BIFMA, garantizando coherencia estética en todo el espacio corporativo.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La línea coordina 6 tipologías de sillería con el mismo lenguaje formal y los mismos materiales: silla operativa, silla de reunión, butaca de espera, sillón ejecutivo, taburete de barra y banco de sala. Cada tipología está disponible en 3 acabados de estructura (aluminio pulido, acero pintado negro o blanco) y 24 colores de tapizado, permitiendo crear un programa de mobiliario coherente en toda la oficina.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Todas las sillas comparten componentes mecánicos comunes: gas lift clase 4, mecanismo sincronizado con bloqueo en 4 posiciones, reposabrazos 4D y ruedas de nylon o goma. Esta unificación reduce el coste de mantenimiento del parque de mobiliario en un 40%, ya que los recambios son intercambiables entre tipologías y el equipo de mantenimiento solo necesita un kit de herramientas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El tapizado se realiza con sistema de fundas desenfundables en todas las tipologías. Esto permite reemplazar el tapizado desgastado sin cambiar la silla completa, reduciendo el coste de renovación del parque mobiliario. Las fundas están disponibles en tela ignífuga Clase 1 (24 colores), piel sintética (12 colores) y piel natural LWG (8 colores).</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Cada tipología pasa los mismos tests de certificación: BIFMA X5.1 para sillas operativas y de reunión, BIFMA X5.4 para butacas y sillones, y EN 16139 para uso intensivo en espacios públicos. La garantía de 10 años cubre estructura y componentes mecánicos en todas las tipologías, con 5 años adicionales para tapizado.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Tipología</th><th>Uso</th><th>Certificación</th><th>Componentes</th></tr>
            </thead>
            <tbody>
              <tr><td>Silla operativa</td><td>Puesto de trabajo 8h</td><td>BIFMA X5.1</td><td>Reposabrazos 4D, lumbar dinámico</td></tr><tr><td>Silla de reunión</td><td>Sala de juntas</td><td>BIFMA X5.1</td><td>Reposabrazos fijos, patín</td></tr><tr><td>Butaca de espera</td><td>Recepción y sala espera</td><td>BIFMA X5.4</td><td>Estructura 4 patas, apilable</td></tr><tr><td>Sillón ejecutivo</td><td>Despacho de dirección</td><td>BIFMA X5.1</td><td>Reposabrazos 4D, cuero natural</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Tipologías coordinadas</td>
                            <td class="spec-value">Silla operativa, reunión, butaca espera, sillón ejecutivo, taburete, banco</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Aluminio pulido, acero pintado negro/blanco (3 acabados)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mecanismo</td>
                            <td class="spec-value">Sincronizado común, bloqueo 4 posiciones, gas lift clase 4</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Reposabrazos</td>
                            <td class="spec-value">4D (operativa y ejecutiva), fijos (reunión), sin (butaca y banco)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tapizado</td>
                            <td class="spec-value">Tela ignífuga Clase 1 (24 colores), piel sintética (12), piel natural (8)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Fundas</td>
                            <td class="spec-value">Desenfundables con cremallera en todas las tipologías</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">BIFMA X5.1, X5.4, EN 16139, Greenguard Gold, ignífugo Clase 1</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">50 unidades (combinación libre de tipologías)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Garantía</td>
                            <td class="spec-value">10 años estructura, 5 años tapizado y componentes</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Proyecto de oficina completa: 200 sillas operativas, 50 sillas de reunión, 20 butacas de espera y 10 sillones ejecutivos con el mismo acabado de estructura y tapizado para coherencia en todo el espacio.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Renovación progresiva: pedido inicial de 50 sillas operativas para el área de trabajo, con plan de renovación a 3 años para sustituir las sillas de reunión y recepción con la misma línea coordinada.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Espacio multi-tipológico: combinación de sillas, butacas y sillones para crear zonas de trabajo, reunión y descanso con un lenguaje visual unificado en una oficina de planta abierta.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden mezclar tipologías en el mismo pedido?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El pedido mínimo de 50 unidades puede combinar cualquier tipología de la línea. Cada tipología mantiene los mismos acabados de estructura y tapizado, garantizando la coherencia estética del conjunto.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las fundas se pueden reemplazar después de la compra?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Las fundas desenfundables se pueden pedir por separado en cualquier color del catálogo, sin necesidad de cambiar la silla. Esto permite renovar el aspecto del mobiliario cuando se actualiza la imagen corporativa.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los componentes mecánicos son intercambiables entre tipologías?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El gas lift, el mecanismo sincronizado, los reposabrazos y las ruedas son comunes a todas las tipologías que los incorporan. El equipo de mantenimiento solo necesita un kit de recambios para todo el parque de sillería.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-12-juego-sillas-comedor-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
