---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario de Oficina Corporativa — Página 2 | HYMUEBLE";
const pageDescription = "Segunda página del catálogo de mobiliario de oficina corporativa.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/productos-oficina/" noindex>
  <main class="productos-listing">
    <header class="listado-header">
      <div class="content-container">
        <h1>Mobiliario de Oficina Corporativa — Página 2 | HYMUEBLE</h1>
        <p class="listado-subtitle">Segunda página del catálogo de mobiliario de oficina corporativa.</p>
      </div>
    </header>
    <section class="productos-grid-section">
      <div class="content-container">
        <div class="productos-grid">
        <a href="/productos-oficina/mobiliario-modular-zonas-breakout/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-07/of-07-01.jpg)">
            <span class="producto-card-cat">Mobiliario Colaborativo</span>
          </div>
          <div class="producto-card-info">
            <h3>Mobiliario Modular para Zonas de Breakout</h3>
            <p class="producto-card-desc">El mobiliario modular para zonas de breakout transforma los espacios muertos de la oficina en zonas productivas. Bancos ...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/mostrador-recepcion-corporativa-medida/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-08/of-08-01.jpg)">
            <span class="producto-card-cat">Recepción</span>
          </div>
          <div class="producto-card-info">
            <h3>Mostrador de Recepción Corporativa a Medida</h3>
            <p class="producto-card-desc">El mostrador de recepción corporativa a medida es la primera imagen que recibe el visitante al entrar en las instalacion...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/workstation-diseno-premium-paneles-acusticos/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-09/of-09-01.jpg)">
            <span class="producto-card-cat">Estaciones Premium</span>
          </div>
          <div class="producto-card-info">
            <h3>Workstation de Diseño Premium con Paneles Acústicos</h3>
            <p class="producto-card-desc">El workstation de diseño premium con paneles acústicos está concebido para oficinas corporativas que exigen el máximo ni...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/cabina-acustica-insonorizada-oficina/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-10/of-10-01.jpg)">
            <span class="producto-card-cat">Cabinas Acústicas</span>
          </div>
          <div class="producto-card-info">
            <h3>Cabina Acústica Insonorizada para Oficina</h3>
            <p class="producto-card-desc">La cabina acústica insonorizada para oficina crea un espacio de privacidad dentro del open space sin necesidad de obras....</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/libreria-oficina-ejecutiva-chapa-madera/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-11/of-11-01.jpg)">
            <span class="producto-card-cat">Almacenamiento</span>
          </div>
          <div class="producto-card-info">
            <h3>Librería de Oficina Ejecutiva con Chapa de Madera</h3>
            <p class="producto-card-desc">La librería de oficina ejecutiva con chapa de madera natural combina capacidad de archivo con presencia institucional. D...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/solucion-integral-seating-corporativos/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-12/of-12-01.jpg)">
            <span class="producto-card-cat">Seating Comercial</span>
          </div>
          <div class="producto-card-info">
            <h3>Solución Integral de Seating para Corporativos</h3>
            <p class="producto-card-desc">La solución integral de seating para corporativos reúne en una sola línea coordinada todas las tipologías de sillería qu...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        </div>
      <nav class="paginacion" aria-label="Paginación">
        <a href="/productos-oficina/" class="pag-link">← Página 1</a>
        <span class="pag-actual">Página 2</span>
      </nav>
      </div>
    </section>
    <section class="cta-section">
      <div class="content-container">
        <h2>¿Busca algo específico para su proyecto corporativo?</h2>
        <p>Consulte con nuestro equipo comercial. Fabricamos mobiliario de oficina a medida.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .productos-listing { background: #FDFCF9; }
  .listado-header { background: #1a3a5c; color: #fff; padding: 64px 0 48px; text-align: center; }
  .listado-header h1 { font-size: 36px; margin-bottom: 12px; letter-spacing: -0.5px; }
  .listado-subtitle { font-size: 16px; opacity: 0.85; max-width: 600px; margin: 0 auto; }
  .productos-grid-section { padding: 48px 0; }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .productos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .producto-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.2s; display: block; }
  .producto-card:hover { box-shadow: 0 8px 32px rgba(44,36,22,0.12); transform: translateY(-2px); }
  .producto-card-img { background: #EEF0F3; height: 200px; background-size: cover; background-position: center; display: flex; align-items: flex-start; justify-content: flex-end; padding: 16px; }
  .producto-card-cat { background: #1a3a5c; color: #fff; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 4px 10px; border-radius: 4px; }
  .producto-card-info { padding: 20px; }
  .producto-card-info h3 { font-size: 16px; line-height: 1.3; margin-bottom: 8px; color: #2C2416; }
  .producto-card-desc { font-size: 13.5px; color: #6B6358; line-height: 1.6; margin-bottom: 12px; }
  .producto-card-link { font-size: 13px; font-weight: 600; color: #1a3a5c; }
  .paginacion { display: flex; justify-content: center; gap: 16px; margin-top: 40px; padding-top: 32px; border-top: 1px solid #E8E3D9; }
  .pag-actual { padding: 8px 16px; background: #1a3a5c; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600; }
  .pag-link { padding: 8px 16px; border: 2px solid #E8E3D9; border-radius: 6px; font-size: 14px; color: #1a3a5c; text-decoration: none; font-weight: 600; }
  .pag-link:hover { border-color: #1a3a5c; }
  .cta-section { padding: 48px 0; border-top: 1px solid #E8E3D9; text-align: center; background: #fff; }
  .cta-section h2 { font-size: 22px; margin-bottom: 12px; color: #2C2416; }
  .cta-section p { color: #6B6358; margin-bottom: 24px; }
  .btn-primary { background: #1a3a5c; color: #fff; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .btn-primary:hover { background: #142d4a; }
  @media (max-width: 768px) { .productos-grid { grid-template-columns: 1fr; } }
</style>