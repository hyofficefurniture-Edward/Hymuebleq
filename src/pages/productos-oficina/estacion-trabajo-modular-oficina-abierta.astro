---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Estación Trabajo Modular Oficina Abierta | Fabricante B2B";
const pageDescription = "Estación de trabajo modular para oficina abierta. Configuraciones de 2 a 8 puestos, paneles divisores acústicos, gestión de cables integrada. Pedido mínimo 30 puestos.";
const canonicalUrl = "/productos-oficina/estacion-trabajo-modular-oficina-abierta/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Estación de Trabajo Modular para Oficina Abierta",
    "description": "Estación de trabajo modular para oficina abierta. Configuraciones de 2 a 8 puestos, paneles divisores acústicos, gestión de cables integrada. Pedido mínimo 30 puestos.",
    "category": "Estaciones de Trabajo",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Estación de Trabajo Modular para Oficina Abierta"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Se pueden reconfigurar los puestos después de la instalación?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el sistema modular está diseñado para ello. Las uniones entre puestos son mecánicas y se liberan con una llave allen. Un equipo de dos personas puede reconfigurar un cluster de 4 puestos en menos de una hora."}}, {"@type": "Question", "name": "¿Qué reducción acústica ofrecen los paneles divisores?", "acceptedAnswer": {"@type": "Answer", "text": "Los paneles de 40 mm con núcleo de lana de roca reducen la transmisión de sonido en 12 dB, lo que equivale a percibir una conversación normal a 3 metros de distancia como un murmullo bajo."}}, {"@type": "Question", "name": "¿Incluyen instalación y montaje?", "acceptedAnswer": {"@type": "Answer", "text": "Para proyectos de más de 50 puestos incluimos servicio de montaje con equipo técnico desplazado. Para pedidos menores, el mobiliario se entrega con kit de montaje y manual ilustrado en español."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Estación de Trabajo Modular para Oficina Abierta</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-02/of-02-01.jpg" alt="Estación de Trabajo Modular para Oficina Abierta para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Estación de Trabajo Modular para Oficina Abierta</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-02/of-02-01.jpg" alt="Estación de Trabajo Modular para Oficina Abierta para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-02/of-02-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-02/of-02-02.jpg" alt="Detalle Estación de Trabajo Modular para Oficina Abierta corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-02/of-02-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-02/of-02-03.jpg" alt="Estación de Trabajo Modular para Oficina Abierta mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-02/of-02-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-02/of-02-04.jpg" alt="Estación de Trabajo Modular para Oficina Abierta instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-02/of-02-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Estaciones de Trabajo</span>
        <h1>Estación de Trabajo Modular para Oficina Abierta</h1>
        <p class="producto-intro">La estación de trabajo modular para oficina abierta está diseñada para maximizar la productividad en espacios corporativos compartidos. Cada configuración se adapta al equipo: desde agrupaciones de 2 puestos hasta baterías de 8 puestos con pasillo central. Los paneles divisores acústicos reducen el ruido entre puestos adyacentes sin bloquear la luz natural ni la comunicación visual del equipo.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El sistema modular permite reconfigurar el espacio de trabajo sin obras ni reemplazos. Los puestos se enlazan mediante uniones mecánicas de acero que un equipo de dos personas monta en menos de 30 minutos por cluster. Esta flexibilidad reduce el coste de reorganización corporativa en un 60% frente a mobiliario fijo convencional.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los paneles divisores de 40 mm de espesor incorporan núcleo de lana de roca con absorbente acústico, reduciendo la transmisión de sonido entre puestos en 12 dB. La superficie del panel está tapizada en tela ignífuga Clase 1, disponible en 24 colores, y incluye riel porta-clips y bandeja para cables en su parte inferior.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Cada puesto integra gestión de cables completa: canaleta perimetral con tapa abatible, caja de conexiones empotrada con 4 tomas Schuko y 2 puertos USB, y paso vertical por el panel divisor. El cableado queda totalmente oculto, facilitando la limpieza del puesto y reduciendo el riesgo de tropiezos certificado según norma EN 527.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Fabricamos con tablero MDF E1 de 25 mm con chapa de madera natural o laminado de alta presión (HPL) según el presupuesto del proyecto. Los cantos van sellados con banda de PVC de 2 mm en color a juego. Todas las superficies horizontales soportan 60 kg de carga uniforme sin deformación permanente.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Puestos por cluster</th><th>Superficie por puesto</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Lineal de 2</td><td>2 puestos</td><td>1400 × 700 mm</td><td>Parejas de trabajo</td></tr><tr><td>Lineal de 4</td><td>4 puestos</td><td>1400 × 700 mm</td><td>Equipos pequeños</td></tr><tr><td>Espina de pez 4</td><td>4 puestos</td><td>1200 × 800 mm</td><td>Call center y back-office</td></tr><tr><td>Cluster de 8</td><td>8 puestos</td><td>1200 × 700 mm</td><td>Open space corporativo</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">MDF E1 25 mm con chapa natural o HPL según especificación</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones por puesto</td>
                            <td class="spec-value">Largo 1200-1600 mm × Fondo 700-800 mm × Alto 750 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Paneles divisores</td>
                            <td class="spec-value">Altura 400-1200 mm, núcleo lana de roca, tela ignífuga Clase 1</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Gestión de cables</td>
                            <td class="spec-value">Canaleta perimetral, caja de conexiones con 4 Schuko + 2 USB por puesto</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Configuraciones</td>
                            <td class="spec-value">Lineal de 2/4/6, espina de pez 4/6, cluster 4/6/8 puestos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa natural, HPL, lacado RAL; 24 colores de tela divisor</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">E1 emisiones, ignífugo Clase 1, estabilidad EN 527-2</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 puestos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables según volumen</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Open space corporativo de 200+ puestos: baterías de 6 puestos en espina de pez con pasillos de 1200 mm, paneles de 800 mm para privacidad visual sin perder luminosidad.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Centro de atención telefónica: configuración lineal de 4 puestos con paneles de 1200 mm para aislamiento acústico, caja de conexiones para headset y doble monitor.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Sala de proyecto temporal: clusters de 8 puestos con uniones de montaje rápido, reconfigurables cuando el equipo cambia de composición o de ubicación dentro del edificio.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden reconfigurar los puestos después de la instalación?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el sistema modular está diseñado para ello. Las uniones entre puestos son mecánicas y se liberan con una llave allen. Un equipo de dos personas puede reconfigurar un cluster de 4 puestos en menos de una hora.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué reducción acústica ofrecen los paneles divisores?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Los paneles de 40 mm con núcleo de lana de roca reducen la transmisión de sonido en 12 dB, lo que equivale a percibir una conversación normal a 3 metros de distancia como un murmullo bajo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Incluyen instalación y montaje?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Para proyectos de más de 50 puestos incluimos servicio de montaje con equipo técnico desplazado. Para pedidos menores, el mobiliario se entrega con kit de montaje y manual ilustrado en español.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        <a href="/productos-oficina/silla-ergonomica-oficina-soporte-lumbar/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-04/of-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sillería</span>
            <h3>Silla Ergonómica de Oficina con Soporte Lumbar</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-02-escritorio-modular-home-office.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
