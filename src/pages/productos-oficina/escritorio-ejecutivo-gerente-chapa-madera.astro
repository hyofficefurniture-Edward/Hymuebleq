---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Escritorio Ejecutivo Gerente Chapa Madera | Fabricante Oficina";
const pageDescription = "Escritorio ejecutivo para gerente con chapa de madera natural. Fabricación a medida para oficinas corporativas. Acabados personalizables, herrajes premium, pedido mínimo 20 unidades.";
const canonicalUrl = "/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Escritorio Ejecutivo para Gerente con Chapa de Madera",
    "description": "Escritorio ejecutivo para gerente con chapa de madera natural. Fabricación a medida para oficinas corporativas. Acabados personalizables, herrajes premium, pedido mínimo 20 unidades.",
    "category": "Escritorios",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Escritorio Ejecutivo para Gerente con Chapa de Madera"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Se puede fabricar el escritorio en formato esquinero o en L?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Fabricamos configuraciones en L, en U y lineales. El departamento técnico necesita las dimensiones del despacho y la ubicación de tomas eléctricas para diseñar la solución óptima en 4 días hábiles."}}, {"@type": "Question", "name": "¿Qué opciones de bloqueo incluye la cajonera?", "acceptedAnswer": {"@type": "Answer", "text": "Ofrecemos dos sistemas: bloqueo individual por cajón con cerradura de seguridad o bloqueo centralizado con una sola llave que asegura todos los cajones del módulo. Ambos sistemas utilizan cilindros europeos de doble paletón."}}, {"@type": "Question", "name": "¿Cuál es el plazo de entrega para un lote de 50 escritorios?", "acceptedAnswer": {"@type": "Answer", "text": "El plazo estándar es de 30 días laborables desde la confirmación del pedido y validación de planos. Para volúmenes superiores a 100 unidades, el plazo se amplía a 40 días. Incluye embalaje reforzado para transporte internacional."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Escritorio Ejecutivo para Gerente con Chapa de Madera</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-01/of-01-01.jpg" alt="Escritorio Ejecutivo para Gerente con Chapa de Madera para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Escritorio Ejecutivo para Gerente con Chapa de Madera</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-01/of-01-01.jpg" alt="Escritorio Ejecutivo para Gerente con Chapa de Madera para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-01/of-01-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-01/of-01-02.jpg" alt="Detalle Escritorio Ejecutivo para Gerente con Chapa de Madera corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-01/of-01-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-01/of-01-03.jpg" alt="Escritorio Ejecutivo para Gerente con Chapa de Madera mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-01/of-01-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-01/of-01-04.jpg" alt="Escritorio Ejecutivo para Gerente con Chapa de Madera instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-01/of-01-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Escritorios</span>
        <h1>Escritorio Ejecutivo para Gerente con Chapa de Madera</h1>
        <p class="producto-intro">El escritorio ejecutivo para gerente con chapa de madera combina presencia institucional con funcionalidad operativa. Diseñado para despachos corporativos de nivel directivo, cada pieza se fabrica bajo pedido con maderas nobles y herrajes de primera línea. La chapa natural aporta calidez al entorno de trabajo mientras los módulos integrados resuelven las necesidades de gestión diaria del ejecutivo.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Fabricado con chapa de madera natural sobre tablero MDF E1 de 25 mm de espesor, el sobre del escritorio soporta más de 80 kg sin deformación. Los cantos están sellados con banda de ABS de 2 mm en color a juego, evitando la absorción de humedad y garantizando una vida útil superior a 12 años en entornos corporativos de uso intensivo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El diseño incluye un módulo lateral con tres cajones de corrido completo, equipados con guías metálicas de cierre suave y carga de 45 kg por cajón. El módulo frontal incorpora un panel de gestión de cables con tapa desenfundable, dos tomas Schuko y dos puertos USB integrados, eliminando el cableado visible sobre la superficie de trabajo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Cada escritorio se personaliza según el proyecto: tipo de chapa (roble, nogal, wengué), tono de barnizado, sentido de la veta y configuración de módulos. El departamento técnico entrega planos a medida en 4 días hábiles y fabrica prototipos para validación antes de la producción en serie, asegurando que cada lote cumpla con los estándares de la marca corporativa.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La estructura incorpora patas regulables en altura con tornillo de ajuste de 20 mm, compensando desniveles de suelo de hasta 5 mm por pata. El conjunto pasa un control de estabilidad según norma EN 527-2, soportando 400 N de carga horizontal sin desplazamiento. Certificación FSC y emisiones E1 disponibles bajo solicitud.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Tipo de chapa</th><th>Tono</th><th>Resistencia</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Roble natural</td><td>Miel medio</td><td>Alta — 200 ciclos Taber</td><td>Despachos de gerencia 4★</td></tr><tr><td>Nogal europeo</td><td>Chocolate oscuro</td><td>Media-alta — 180 ciclos</td><td>Oficinas VIP y director</td></tr><tr><td>Wengué</td><td>Negro carbón</td><td>Alta — 210 ciclos</td><td>Corporativos de diseño</td></tr><tr><td>Lacado RAL</td><td>Según carta</td><td>Media — 150 ciclos</td><td>Cadenas con manual de marca</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Chapa de madera natural sobre MDF E1 de 25 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones estándar</td>
                            <td class="spec-value">Largo 1800-2400 mm × Fondo 800-900 mm × Alto 750 mm (configurable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Módulo principal + módulo lateral con cajonera, patas regulables en altura</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Herrajes</td>
                            <td class="spec-value">Guías metálicas telescópicas de cierre suave, carga 45 kg por cajón</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Gestión de cables</td>
                            <td class="spec-value">Panel frontal con tapa, 2 tomas Schuko + 2 USB, pasacables circular</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa natural barnizada mate, lacado RAL a medida, canto ABS 2 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">FSC, E1 emisiones, estabilidad EN 527-2, fuego Clase B (bajo pedido)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables según volumen</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Despacho de gerencia corporativa: escritorio en L con módulo de reuniones integrado, gestión de cables para doble monitor y portátil, acabado en nogal europeo con barnizado mate.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Oficina de director financiero: configuración compacta con cajonera para archivo documental, bloqueo centralizado y superficie ampliable para reuniones de equipo reducido.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Sala de juntas anexa: escritorio ejecutivo como pieza complementaria para trabajo individual del director entre reuniones, con módulo de carga para dispositivos móviles.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede fabricar el escritorio en formato esquinero o en L?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Fabricamos configuraciones en L, en U y lineales. El departamento técnico necesita las dimensiones del despacho y la ubicación de tomas eléctricas para diseñar la solución óptima en 4 días hábiles.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué opciones de bloqueo incluye la cajonera?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Ofrecemos dos sistemas: bloqueo individual por cajón con cerradura de seguridad o bloqueo centralizado con una sola llave que asegura todos los cajones del módulo. Ambos sistemas utilizan cilindros europeos de doble paletón.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Cuál es el plazo de entrega para un lote de 50 escritorios?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El plazo estándar es de 30 días laborables desde la confirmación del pedido y validación de planos. Para volúmenes superiores a 100 unidades, el plazo se amplía a 40 días. Incluye embalaje reforzado para transporte internacional.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        <a href="/productos-oficina/silla-ergonomica-oficina-soporte-lumbar/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-04/of-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sillería</span>
            <h3>Silla Ergonómica de Oficina con Soporte Lumbar</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-01-escritorio-ejecutivo-home-office.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
