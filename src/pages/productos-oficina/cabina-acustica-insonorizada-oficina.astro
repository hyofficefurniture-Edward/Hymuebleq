---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Cabina Acústica Insonorizada Oficina | Fabricante B2B";
const pageDescription = "Cabina acústica insonorizada para oficina. Reducción de 35 dB, ventilación forzada, iluminación LED. Para llamadas y reuniones privadas. Pedido mínimo 5 cabinas.";
const canonicalUrl = "/productos-oficina/cabina-acustica-insonorizada-oficina/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Cabina Acústica Insonorizada para Oficina",
    "description": "Cabina acústica insonorizada para oficina. Reducción de 35 dB, ventilación forzada, iluminación LED. Para llamadas y reuniones privadas. Pedido mínimo 5 cabinas.",
    "category": "Cabinas Acústicas",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Cabina Acústica Insonorizada para Oficina"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Necesita obra civil para instalar la cabina?", "acceptedAnswer": {"@type": "Answer", "text": "No. La cabina se monta sobre el suelo existente sin anclaje al edificio. Solo necesita una toma eléctrica estándar a 1 metro de distancia. Dos personas montan la cabina en 4 horas con herramientas manuales incluidas en el envío."}}, {"@type": "Question", "name": "¿Se puede desmontar y trasladar a otra oficina?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. La cabina está diseñada para desmontaje y reubicación. Se desmonta en 2 horas y se transporta en panel plano. El certificado acústico se mantiene después del reensamblaje, siempre que se siga el protocolo de montaje."}}, {"@type": "Question", "name": "¿La ventilación es suficiente para reuniones largas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El sistema de 50 m³/h renueva el aire de la cabina cada 4 minutos para 1 persona y cada 7 minutos para 2 personas, cumpliendo la norma EN 16798-1 de calidad del aire interior. El sensor de CO2 opcional ajusta la ventilación según ocupación."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Cabina Acústica Insonorizada para Oficina</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-10/of-10-01.jpg" alt="Cabina Acústica Insonorizada para Oficina para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Cabina Acústica Insonorizada para Oficina</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-10/of-10-01.jpg" alt="Cabina Acústica Insonorizada para Oficina para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-10/of-10-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-10/of-10-02.jpg" alt="Detalle Cabina Acústica Insonorizada para Oficina corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-10/of-10-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-10/of-10-03.jpg" alt="Cabina Acústica Insonorizada para Oficina mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-10/of-10-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-10/of-10-04.jpg" alt="Cabina Acústica Insonorizada para Oficina instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-10/of-10-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Cabinas Acústicas</span>
        <h1>Cabina Acústica Insonorizada para Oficina</h1>
        <p class="producto-intro">La cabina acústica insonorizada para oficina crea un espacio de privacidad dentro del open space sin necesidad de obras. Con una reducción acústica certificada de 35 dB, permite realizar llamadas confidenciales y reuniones reducidas sin molestar al resto del equipo. Ventilación forzada e iluminación LED integradas.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La cabina consigue una reducción acústica de 35 dB certificada según norma ISO 23351-1. Esto significa que una conversación normal a 65 dB dentro de la cabina se percibe a 30 dB en el exterior, por debajo del umbral de audición de una conversación susurrada. La confidencialidad de las llamadas está garantizada sin perturbar el entorno.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El sistema de ventilación forzada extrae 50 m³/h de aire renovado, garantizando la calidad del aire interior según norma EN 16798-1 para ocupación de 1-2 personas. El ventilador de bajo consumo (18W) funciona de forma silenciosa a 28 dB, imperceptible durante una llamada. El aire entra por la parte inferior y sale por la superior, creando flujo cruzado.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La iluminación LED de techo ofrece 500 lux sobre la superficie de trabajo con temperatura de color de 4000K (blanco neutro). El interruptor de presencia enciende la luz al entrar y la apaga al salir. Consumo total de la cabina en operación: 26W (iluminación + ventilación), lo que equivale a una bombilla tradicional.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La estructura se monta sin obras: 4 paneles laterales, techo y suelo que se encajan con uniones mecánicas de precisión. Dos personas montan la cabina en 4 horas sin herramientas especiales ni anclaje al edificio. Se puede desmontar y reubicar cuando se reorganiza el espacio, manteniendo el certificado acústico.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Modelo</th><th>Plazas</th><th>Dimensiones</th><th>Reducción acústica</th></tr>
            </thead>
            <tbody>
              <tr><td>Phone Booth</td><td>1 persona</td><td>1000 × 1000 × 2200 mm</td><td>35 dB</td></tr><tr><td>Focus Pod</td><td>1-2 personas</td><td>1200 × 1000 × 2200 mm</td><td>33 dB</td></tr><tr><td>Meeting Pod S</td><td>2-4 personas</td><td>1500 × 1200 × 2200 mm</td><td>32 dB</td></tr><tr><td>Meeting Pod L</td><td>4-6 personas</td><td>2000 × 1500 × 2200 mm</td><td>30 dB</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Reducción acústica</td>
                            <td class="spec-value">35 dB (ISO 23351-1), 33 dB (Meeting Pod S), 30 dB (Meeting Pod L)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Paneles de 80 mm: chapa exterior + MDF + lana de roca + tela acústica interior</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ventilación</td>
                            <td class="spec-value">Forzada 50 m³/h, ventilador 18W silencioso (28 dB), flujo cruzado</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Iluminación</td>
                            <td class="spec-value">LED 500 lux, 4000K, sensor de presencia, consumo 8W</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Puerta</td>
                            <td class="spec-value">Vidrio templado laminado acústico de 10+10 mm, cierre magnético</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Interior</td>
                            <td class="spec-value">Techo y suelo acústicos, mesa plegable, 2 tomas Schuko + 2 USB</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 23351-1, EN 16798-1, CE eléctrico, ignífugo Clase 1</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">5 cabinas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">35-45 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Open space corporativo: conjunto de phone booths y meeting pods para llamadas privadas y reuniones reducidas sin construir tabiques, reconfigurables cuando cambia el equipo.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de grabación de podcasts: meeting pod L con acústica tratada para grabación de contenido audiovisual sin necesidad de acondicionamiento del espacio.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Sala de lactancia o descanso: focus pod con ventilación e iluminación para crear un espacio privado y confortable dentro de la oficina, cumpliendo la normativa de espacios de descanso.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Necesita obra civil para instalar la cabina?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>No. La cabina se monta sobre el suelo existente sin anclaje al edificio. Solo necesita una toma eléctrica estándar a 1 metro de distancia. Dos personas montan la cabina en 4 horas con herramientas manuales incluidas en el envío.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede desmontar y trasladar a otra oficina?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. La cabina está diseñada para desmontaje y reubicación. Se desmonta en 2 horas y se transporta en panel plano. El certificado acústico se mantiene después del reensamblaje, siempre que se siga el protocolo de montaje.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La ventilación es suficiente para reuniones largas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El sistema de 50 m³/h renueva el aire de la cabina cada 4 minutos para 1 persona y cada 7 minutos para 2 personas, cumpliendo la norma EN 16798-1 de calidad del aire interior. El sensor de CO2 opcional ajusta la ventilación según ocupación.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-10-cabina-insonorizada-llamadas-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
