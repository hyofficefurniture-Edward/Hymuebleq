---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Modular Zonas Breakout | Fabricante Oficina B2B";
const pageDescription = "Mobiliario modular para zonas de breakout corporativo. Bancos, mesas auxiliares y paneles acústicos. Configuraciones flexibles, tapizado ignífugo. Pedido mínimo 15 piezas.";
const canonicalUrl = "/productos-oficina/mobiliario-modular-zonas-breakout/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario Modular para Zonas de Breakout",
    "description": "Mobiliario modular para zonas de breakout corporativo. Bancos, mesas auxiliares y paneles acústicos. Configuraciones flexibles, tapizado ignífugo. Pedido mínimo 15 piezas.",
    "category": "Mobiliario Colaborativo",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario Modular para Zonas de Breakout"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las piezas se pueden comprar por separado o hay que pedir un set completo?", "acceptedAnswer": {"@type": "Answer", "text": "Se pueden comprar por separado. El pedido mínimo de 15 piezas puede combinar cualquier tipología (bancos, mesas, paneles) según las necesidades del espacio. Cada pieza funciona de forma independiente."}}, {"@type": "Question", "name": "¿El panel acústico móvil lo puede mover una sola persona?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El panel pesa 28 kg y tiene 4 ruedas pivotantes con freno. Una persona lo desplaza sin esfuerzo y lo fija en posición con el freno de pisar. No requiere montaje en obra ni anclaje al suelo."}}, {"@type": "Question", "name": "¿El baúl del banco tiene cerradura?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El baúl incorpora cerradura de seguridad con cilindro europeo y dos llaves. Para proyectos corporativos, ofrecemos sistema de llave maestra que abre todos los baúles de la misma zona con una sola llave."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario Modular para Zonas de Breakout</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-07/of-07-01.jpg" alt="Mobiliario Modular para Zonas de Breakout para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario Modular para Zonas de Breakout</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-07/of-07-01.jpg" alt="Mobiliario Modular para Zonas de Breakout para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-07/of-07-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-07/of-07-02.jpg" alt="Detalle Mobiliario Modular para Zonas de Breakout corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-07/of-07-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-07/of-07-03.jpg" alt="Mobiliario Modular para Zonas de Breakout mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-07/of-07-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-07/of-07-04.jpg" alt="Mobiliario Modular para Zonas de Breakout instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-07/of-07-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Mobiliario Colaborativo</span>
        <h1>Mobiliario Modular para Zonas de Breakout</h1>
        <p class="producto-intro">El mobiliario modular para zonas de breakout transforma los espacios muertos de la oficina en zonas productivas. Bancos con almacenamiento integrado, mesas auxiliares a varias alturas y paneles acústicos móviles que crean micro-espacios de reunión sin obras. Diseñado para oficinas que fomentan la colaboración informal.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El sistema combina tres tipologías de mobiliario (banco, mesa auxiliar y panel acústico) que se configuran según el espacio. Cada pieza funciona de forma independiente o agrupada, permitiendo crear una zona de breakout completa en una mañana y reconfigurarla cuando cambian las necesidades del equipo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El banco incorpora baúl de almacenamiento con apertura superior y cerradura, capacidad 200 litros por módulo. El interior está tapizado en tela ignífuga para evitar que los objetos guardados produzcan ruido al moverse. La tapa soporta 120 kg de carga, funcionando también como superficie de asiento o apoyo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los paneles acústicos móviles con ruedas pivotantes crean separaciones visuales y acústicas en el espacio abierto. Con 1200 mm de altura y núcleo de lana de roca de 50 mm, reducen el ruido de conversación en 15 dB. Las ruedas con freno permiten fijar el panel en posición y reubicarlo por una sola persona.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Todas las superficies de asiento y respaldo utilizan tapizado ignífugo Clase 1 con espuma de alta resilencia de 40 kg/m³. Las mesas auxiliares tienen sobre de HPL de 12 mm resistente a rayaduras y líquidos. El acabado de las estructuras está disponible en 6 colores de lacado RAL para integrar con la paleta del espacio.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Pieza</th><th>Dimensiones</th><th>Función</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Banco con baúl</td><td>1400 × 600 mm</td><td>Asiento + almacenamiento</td><td>Zona breakout 4-6 personas</td></tr><tr><td>Mesa auxiliar alta</td><td>Ø 700 mm, 1100 mm alto</td><td>Trabajo de pie</td><td>Reuniones rápidas</td></tr><tr><td>Panel acústico móvil</td><td>1200 × 800 mm</td><td>Separación visual + acústica</td><td>Open space</td></tr><tr><td>Mesa baja colaborativa</td><td>1200 × 600 mm, 400 mm</td><td>Trabajo informal sentado</td><td>Sesiones de brainstorming</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Banco</td>
                            <td class="spec-value">1400 × 600 × 450 mm, baúl 200 L, carga 120 kg, espuma HR 40 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesa auxiliar alta</td>
                            <td class="spec-value">Ø 700 mm, alto 1100 mm, sobre HPL 12 mm, base de fundición</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Panel acústico móvil</td>
                            <td class="spec-value">1200 × 800 mm, núcleo lana de roca 50 mm, ruedas con freno</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesa baja</td>
                            <td class="spec-value">1200 × 600 × 400 mm, sobre MDF E1 con chapa, estructura tubo acero</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tapizado</td>
                            <td class="spec-value">Tela ignífuga Clase 1, 24 colores; piel sintética 12 colores</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Acero pintado epoxi, 6 colores RAL; aluminio anodizado (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">Ignífugo Clase 1, EN 16139, E1 emisiones</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">15 piezas (combinación libre de tipologías)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Zona breakout en open space: banco con baúl para sentarse informalmente, mesa alta para reuniones rápidas de pie y panel móvil que separa la zona del resto de la oficina.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Pasillo productivo: conjunto de mesas auxiliares a varias alturas aprovechando el espacio de paso para reuniones informales y trabajo colaborativo rápido.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Área de descanso activo: mesas bajas colaborativas con bancos y paneles para sesiones de brainstorming en posición relajada, lejos del escritorio convencional.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las piezas se pueden comprar por separado o hay que pedir un set completo?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Se pueden comprar por separado. El pedido mínimo de 15 piezas puede combinar cualquier tipología (bancos, mesas, paneles) según las necesidades del espacio. Cada pieza funciona de forma independiente.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El panel acústico móvil lo puede mover una sola persona?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El panel pesa 28 kg y tiene 4 ruedas pivotantes con freno. Una persona lo desplaza sin esfuerzo y lo fija en posición con el freno de pisar. No requiere montaje en obra ni anclaje al suelo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El baúl del banco tiene cerradura?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El baúl incorpora cerradura de seguridad con cilindro europeo y dos llaves. Para proyectos corporativos, ofrecemos sistema de llave maestra que abre todos los baúles de la misma zona con una sola llave.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-07-conjunto-modular-sala-estar.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
