---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Workstation Premium Paneles Acústicos | Fabricante Oficina B2B";
const pageDescription = "Workstation de diseño premium con paneles acústicos para oficinas corporativas de alto nivel. Chapa de madera, iluminación LED, gestión de cables. Pedido mínimo 20 puestos.";
const canonicalUrl = "/productos-oficina/workstation-diseno-premium-paneles-acusticos/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Workstation de Diseño Premium con Paneles Acústicos",
    "description": "Workstation de diseño premium con paneles acústicos para oficinas corporativas de alto nivel. Chapa de madera, iluminación LED, gestión de cables. Pedido mínimo 20 puestos.",
    "category": "Estaciones Premium",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Workstation de Diseño Premium con Paneles Acústicos"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Qué nivel de reducción acústica ofrecen los paneles?", "acceptedAnswer": {"@type": "Answer", "text": "Los paneles de 60 mm con núcleo de lana de roca alcanzan un coeficiente NRC de 0.85, absorbiendo el 85% del sonido incidente. Esto reduce la percepción de una conversación normal a 3 metros a un murmullo apenas perceptible."}}, {"@type": "Question", "name": "¿La lámpara LED se puede regular?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. La lámpara empotrada ofrece 3 temperaturas de color (3000K cálida, 4000K neutra, 5000K fría) y regulación de intensidad de 10% a 100%. El control táctil está integrado en el panel frontal del puesto."}}, {"@type": "Question", "name": "¿Los paneles se pueden tapizar con tela del cliente?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Para proyectos de más de 30 puestos, aceptamos tela suministrada por el cliente siempre que cumpla la certificación de ignífugación Clase 1. El departamento técnico valida la tela antes de la producción."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Workstation de Diseño Premium con Paneles Acústicos</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-09/of-09-01.jpg" alt="Workstation de Diseño Premium con Paneles Acústicos para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Workstation de Diseño Premium con Paneles Acústicos</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-09/of-09-01.jpg" alt="Workstation de Diseño Premium con Paneles Acústicos para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-09/of-09-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-09/of-09-02.jpg" alt="Detalle Workstation de Diseño Premium con Paneles Acústicos corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-09/of-09-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-09/of-09-03.jpg" alt="Workstation de Diseño Premium con Paneles Acústicos mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-09/of-09-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-09/of-09-04.jpg" alt="Workstation de Diseño Premium con Paneles Acústicos instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-09/of-09-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Estaciones Premium</span>
        <h1>Workstation de Diseño Premium con Paneles Acústicos</h1>
        <p class="producto-intro">El workstation de diseño premium con paneles acústicos está concebido para oficinas corporativas que exigen el máximo nivel en mobiliario de trabajo. Cada puesto combina chapa de madera natural, paneles acústicos de alta absorción, iluminación LED individual y gestión completa de cables. Diseñado en colaboración con estudios de interiorismo corporativo.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Los paneles acústicos laterales y frontales utilizan núcleo de lana de roca de 60 mm con tejido técnico de alta absorción, alcanzando un coeficiente NRC de 0.85. Esto significa que el panel absorbe el 85% del sonido que incide sobre él, reduciendo el ruido de conversación entre puestos adyacentes a niveles que permiten trabajar sin distracciones en un open space de 100+ personas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El sobre del escritorio está fabricado con chapa de madera natural seleccionada (roble, nogal o wengué) sobre tablero MDF E1 de 25 mm. La madera se barniza con un sistema de tres capas de poliuretano de dos componentes que proporciona resistencia a la abrasión de 200 ciclos Taber y a las manchas de café, tinta y productos de limpieza comunes en entorno corporativo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La iluminación LED individual incorpora una lámpara de trabajo empotrada en el panel frontal con sensor de presencia. La lámpara ofrece 3 temperaturas de color (3000K, 4000K, 5000K) y regulación de intensidad de 10% a 100%. El sensor apaga la luz cuando el puesto está vacío más de 15 minutos, reduciendo el consumo eléctrico en un 40% según tests internos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El sistema de gestión de cables es completo: canaleta perimetral con tapa abatible de aluminio, caja de conexiones empotrada con 4 Schuko + 2 USB + 1 HDMI + 1 RJ45, y paso vertical por el panel. Todo el cableado del puesto queda oculto, facilitando la limpieza del puesto y cumpliendo la normativa de seguridad EN 527 para prevención de tropiezos.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Modelo</th><th>Paneles</th><th>Iluminación</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Premium Lineal</td><td>Laterales 800 mm</td><td>LED con sensor</td><td>Open space ejecutivo</td></tr><tr><td>Premium Esquinero</td><td>Laterales + frontal</td><td>LED + lámpara empotrada</td><td>Despacho de dirección</td></tr><tr><td>Premium Cluster 4</td><td>Laterales compartidos</td><td>LED individual por puesto</td><td>Equipos de proyecto</td></tr><tr><td>Premium Individual</td><td>3 paneles (laterales + frontal)</td><td>LED + lámpara + USB</td><td>Puesto VIP</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material del sobre</td>
                            <td class="spec-value">Chapa de madera natural sobre MDF E1 25 mm, barniz 3 capas PU</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Paneles acústicos</td>
                            <td class="spec-value">Núcleo lana de roca 60 mm, NRC 0.85, tejido técnico ignífugo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Iluminación</td>
                            <td class="spec-value">LED empotrada con sensor de presencia, 3 temperaturas, regulable 10-100%</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Gestión de cables</td>
                            <td class="spec-value">Canaleta aluminio, caja 4 Schuko + 2 USB + 1 HDMI + 1 RJ45</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Reposabrazos integrado</td>
                            <td class="spec-value">Panel lateral con acolchado, altura 350 mm opcional</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa natural (roble, nogal, wengué); 24 colores de tela</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">E1, ignífugo Clase 1, EN 527, Greenguard Gold</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 puestos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">35-45 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Open space ejecutivo: baterías de 6 puestos premium con paneles acústicos de 800 mm y iluminación con sensor para equipos de dirección en planta abierta.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de proyecto VIP: cluster de 4 puestos con paneles compartidos, iluminación individual y lámpara empotrada para equipos de alto rendimiento.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Despacho individual premium: puesto con 3 paneles (laterales y frontal) para máxima privacidad acústica, con iluminación regulable y gestión completa de cables.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué nivel de reducción acústica ofrecen los paneles?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Los paneles de 60 mm con núcleo de lana de roca alcanzan un coeficiente NRC de 0.85, absorbiendo el 85% del sonido incidente. Esto reduce la percepción de una conversación normal a 3 metros a un murmullo apenas perceptible.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La lámpara LED se puede regular?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. La lámpara empotrada ofrece 3 temperaturas de color (3000K cálida, 4000K neutra, 5000K fría) y regulación de intensidad de 10% a 100%. El control táctil está integrado en el panel frontal del puesto.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los paneles se pueden tapizar con tela del cliente?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Para proyectos de más de 30 puestos, aceptamos tela suministrada por el cliente siempre que cumpla la certificación de ignífugación Clase 1. El departamento técnico valida la tela antes de la producción.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-09-escritorio-premium-paneles-acusticos.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
