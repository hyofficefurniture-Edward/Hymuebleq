---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Librería Oficina Ejecutiva Chapa Madera | Fabricante B2B";
const pageDescription = "Librería de oficina ejecutiva con chapa de madera natural. Configurable en altura y anchura, estantes regulables, iluminación LED. Para despachos corporativos. Pedido mínimo 15 unidades.";
const canonicalUrl = "/productos-oficina/libreria-oficina-ejecutiva-chapa-madera/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Librería de Oficina Ejecutiva con Chapa de Madera",
    "description": "Librería de oficina ejecutiva con chapa de madera natural. Configurable en altura y anchura, estantes regulables, iluminación LED. Para despachos corporativos. Pedido mínimo 15 unidades.",
    "category": "Almacenamiento",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Librería de Oficina Ejecutiva con Chapa de Madera"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Los estantes soportan libros de formato grande?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Cada estante soporta 60 kg de carga uniforme, suficiente para una hilera completa de libros A3 de arte o arquitectura. Los soportes metálicos de 5 mm garantizan la estabilidad según norma EN 14073."}}, {"@type": "Question", "name": "¿Se puede integrar la librería con escritorio y mobiliario existente?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Fabricamos a medida según las dimensiones del espacio y coordinamos el acabado de la chapa con el del escritorio y otros muebles del despacho. El departamento técnico verifica la compatibilidad de tonos con muestras físicas."}}, {"@type": "Question", "name": "¿Incluyen sistema anti-vuelco?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Todas las librerías superiores a 1200 mm de altura incluyen tirantes de fijación a pared según norma EN 14073. El sistema es invisible desde el frente y se instala en menos de 30 minutos por unidad."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Librería de Oficina Ejecutiva con Chapa de Madera</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-11/of-11-01.jpg" alt="Librería de Oficina Ejecutiva con Chapa de Madera para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Librería de Oficina Ejecutiva con Chapa de Madera</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-11/of-11-01.jpg" alt="Librería de Oficina Ejecutiva con Chapa de Madera para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-11/of-11-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-11/of-11-02.jpg" alt="Detalle Librería de Oficina Ejecutiva con Chapa de Madera corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-11/of-11-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-11/of-11-03.jpg" alt="Librería de Oficina Ejecutiva con Chapa de Madera mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-11/of-11-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-11/of-11-04.jpg" alt="Librería de Oficina Ejecutiva con Chapa de Madera instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-11/of-11-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Almacenamiento</span>
        <h1>Librería de Oficina Ejecutiva con Chapa de Madera</h1>
        <p class="producto-intro">La librería de oficina ejecutiva con chapa de madera natural combina capacidad de archivo con presencia institucional. Diseñada para despachos corporativos de nivel directivo, cada pieza se fabrica bajo pedido con maderas nobles y herrajes de primera calidad. Los estantes regulables y la iluminación LED opcional adaptan la librería a cualquier necesidad de archivo y exhibición.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La estructura está fabricada con tablero MDF E1 de 25 mm con chapa de madera natural sobre las caras visibles. Los estantes, de 30 mm de espesor, soportan 60 kg de carga uniforme sin deformación, certificado según norma EN 14073. Los cantos van sellados con banda de ABS de 2 mm en color a juego con la chapa.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los estantes son regulables en altura cada 32 mm mediante soportes metálicos de 5 mm de espesor. Esta flexibilidad permite combinar libros de formato grande (A3), archivadores, objetos de decoración y equipamiento ofimático en la misma librería, adaptando la distribución según las necesidades cambiantes del despacho.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La iluminación LED opcional, empotrada bajo cada estante, ofrece 300 lux sobre la balda inferior con consumo de 5W por metro lineal. La temperatura de color de 4000K (blanco neutro) no altera la percepción cromática de los lomos de los libros. El sistema se alimenta por transformador de 12V integrado en la base, con interruptor táctil.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El departamento técnico diseña la librería a medida según las dimensiones del despacho y las necesidades de archivo del cliente. Para proyectos corporativos, fabricamos configuraciones de pared a pared con módulos de unión, esquineros y vitrinas con puertas de cristal para objetos de valor. Planos en 4 días hábiles.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Dimensiones</th><th>Estantes</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Librería baja</td><td>1800 × 350 × 900 mm</td><td>4 fijos</td><td>Despacho pequeño</td></tr><tr><td>Librería estándar</td><td>1800 × 350 × 2100 mm</td><td>6 regulables</td><td>Despacho corporativo</td></tr><tr><td>Librería alta</td><td>2400 × 400 × 2400 mm</td><td>8 regulables + LED</td><td>Despacho de dirección</td></tr><tr><td>Librería pared a pared</td><td>A medida × 400 × 2400 mm</td><td>10+ regulables + LED</td><td>Sala de juntas</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Chapa de madera natural sobre MDF E1 25 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estantes</td>
                            <td class="spec-value">30 mm de espesor, carga 60 kg, regulables cada 32 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Soportes</td>
                            <td class="spec-value">Metálicos de 5 mm, cromados, con bloqueo anti-vuelco</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Iluminación</td>
                            <td class="spec-value">LED 4000K bajo estante, 5W/m, interruptor táctil (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa natural (roble, nogal, wengué); lacado RAL; canto ABS 2 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Anclaje</td>
                            <td class="spec-value">Tirantes de fijación a pared incluidos, norma EN 14073</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">FSC, E1 emisiones, estabilidad EN 14073, fuego Clase B</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">15 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Despacho de dirección: librería de pared a pared con chapa de nogal, estantes con LED y vitrina con puertas de cristal para archivos confidenciales y objetos de representación.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de juntas anexa: librería estándar con estantes regulables para manuales, catálogos de producto y dossiers de proyecto, acabada en chapa de roble natural.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Biblioteca corporativa: configuración alta con 10 estantes regulables y LED para sala de consulta y archivo documental de acceso frecuente.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los estantes soportan libros de formato grande?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Cada estante soporta 60 kg de carga uniforme, suficiente para una hilera completa de libros A3 de arte o arquitectura. Los soportes metálicos de 5 mm garantizan la estabilidad según norma EN 14073.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede integrar la librería con escritorio y mobiliario existente?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Fabricamos a medida según las dimensiones del espacio y coordinamos el acabado de la chapa con el del escritorio y otros muebles del despacho. El departamento técnico verifica la compatibilidad de tonos con muestras físicas.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Incluyen sistema anti-vuelco?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Todas las librerías superiores a 1200 mm de altura incluyen tirantes de fijación a pared según norma EN 14073. El sistema es invisible desde el frente y se instala en menos de 30 minutos por unidad.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-11-libreria-despacho-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
