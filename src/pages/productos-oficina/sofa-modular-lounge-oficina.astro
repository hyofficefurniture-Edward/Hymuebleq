---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Sofá Modular Lounge Oficina | Fabricante Mobiliario Corporativo";
const pageDescription = "Sofá modular de lounge para oficina. Configuraciones de 2 a 6 plazas, tapizado ignífugo, estructura metálica. Ideal para zonas comunes corporativas. Pedido mínimo 10 unidades.";
const canonicalUrl = "/productos-oficina/sofa-modular-lounge-oficina/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Sofá Modular de Lounge para Oficina",
    "description": "Sofá modular de lounge para oficina. Configuraciones de 2 a 6 plazas, tapizado ignífugo, estructura metálica. Ideal para zonas comunes corporativas. Pedido mínimo 10 unidades.",
    "category": "Lounge Corporativo",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Sofá Modular de Lounge para Oficina"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las fundas se pueden lavar o hay que llevarlas a tintorería?", "acceptedAnswer": {"@type": "Answer", "text": "Las fundas de tela ignífuga se pueden lavar en seco. Las de piel sintética se limpian con paño húmedo y jabón neutro. Ofrecemos servicio de reemplazo de fundas con cualquier color del catálogo sin necesidad de cambiar el sofá completo."}}, {"@type": "Question", "name": "¿Se pueden añadir módulos después de la compra inicial?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el sistema modular permite añadir módulos en cualquier momento. Solo necesitas indicar el modelo y el tapizado original para que el nuevo módulo coincida en color y textura con los existentes."}}, {"@type": "Question", "name": "¿El tapizado cumple la normativa de incendios para oficinas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Todos los tapizados disponibles (tela, piel sintética y piel natural) cumplen la clasificación de reacción al fuego Clase 1 según norma UNE-EN 13501-1, necesaria para edificios de uso comercial y oficinas."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Sofá Modular de Lounge para Oficina</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-06/of-06-01.jpg" alt="Sofá Modular de Lounge para Oficina para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Sofá Modular de Lounge para Oficina</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-06/of-06-01.jpg" alt="Sofá Modular de Lounge para Oficina para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-06/of-06-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-06/of-06-02.jpg" alt="Detalle Sofá Modular de Lounge para Oficina corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-06/of-06-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-06/of-06-03.jpg" alt="Sofá Modular de Lounge para Oficina mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-06/of-06-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-06/of-06-04.jpg" alt="Sofá Modular de Lounge para Oficina instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-06/of-06-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Lounge Corporativo</span>
        <h1>Sofá Modular de Lounge para Oficina</h1>
        <p class="producto-intro">El sofá modular de lounge para oficina está diseñado para zonas comunes corporativas donde el equipo se reúne de forma informal. Los módulos independientes permiten crear configuraciones lineales, en L o en U según el espacio disponible. El tapizado ignífugo Clase 1 cumple con la normativa de edificios de uso comercial.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El sistema modular permite crear configuraciones de 2 a 6 plazas combinando tres tipos de módulo: recto, esquinero y chaise longue. Las uniones entre módulos son mecánicas con anclaje de seguridad, evitando que los módulos se separen con el uso. Un equipo de montaje configura una sala lounge completa en 2 horas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La estructura interna está fabricada en tubo de acero de 32 mm de diámetro soldado en continuo, soportando 300 kg de carga estática por módulo. El relleno combina espuma de poliuretano de alta resilencia (40 kg/m³) con fibra hueca siliconada en los cojines de respaldo, manteniendo la forma original tras 50.000 ciclos de carga según norma EN 16139.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El tapizado está disponible en tres opciones: tela ignífuga Clase 1 (24 colores), piel sintética comercial (12 colores) y piel natural con certificación LWG (8 colores). Todas las opciones cumplen la normativa de ignífugación para edificios de uso comercial. Las fundas son desenfundables con cierre de cremallera para facilitar la limpieza y el reemplazo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Las patas regulables en altura (15 mm de ajuste) compensan desniveles de suelo. La altura del asiento (420 mm) está optimizada para uso corporativo: permite levantarse con facilidad, a diferencia de los sofás residenciales más bajos que dificultan la incorporación. Disponible con patas en aluminio pulido o en acero pintado.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Plazas</th><th>Dimensiones</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Lineal 2 plazas</td><td>2</td><td>1400 × 850 mm</td><td>Sala de espera pequeña</td></tr><tr><td>Lineal 3 plazas</td><td>3</td><td>2000 × 850 mm</td><td>Zona lounge corporativa</td></tr><tr><td>Esquinero en L</td><td>4-5</td><td>2400 × 1800 mm</td><td>Zona colaborativa</td></tr><tr><td>U con chaise</td><td>5-6</td><td>3000 × 2200 mm</td><td>Sala informal de reuniones</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Tubo de acero 32 mm soldado, carga 300 kg por módulo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Relleno asiento</td>
                            <td class="spec-value">Espuma HR 40 kg/m³ + fibra hueca siliconada</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Relleno respaldo</td>
                            <td class="spec-value">Fibra hueca siliconada con núcleo de espuma 30 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tapizado</td>
                            <td class="spec-value">Tela ignífuga Clase 1 (24 colores), piel sintética o natural</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Fundas</td>
                            <td class="spec-value">Desenfundables con cremallera para limpieza y reemplazo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Patas</td>
                            <td class="spec-value">Aluminio pulido o acero pintado, regulables 15 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Altura del asiento</td>
                            <td class="spec-value">420 mm (optimizada para uso corporativo)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">Ignífugo Clase 1, EN 16139, Greenguard Gold</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 módulos</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Zona de descanso corporativa: configuración en L con 5 plazas en zona común de oficina, tapizado en tela ignífuga a tono con la paleta del espacio.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de reuniones informal: sofá en U con módulo chaise longue para sesiones de brainstorming y trabajo colaborativo fuera del despacho convencional.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Recepción corporativa: sofá lineal de 3 plazas con butacas individuales a juego para sala de espera de visitas, tapizado en piel natural con logo bordado.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las fundas se pueden lavar o hay que llevarlas a tintorería?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Las fundas de tela ignífuga se pueden lavar en seco. Las de piel sintética se limpian con paño húmedo y jabón neutro. Ofrecemos servicio de reemplazo de fundas con cualquier color del catálogo sin necesidad de cambiar el sofá completo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden añadir módulos después de la compra inicial?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el sistema modular permite añadir módulos en cualquier momento. Solo necesitas indicar el modelo y el tapizado original para que el nuevo módulo coincida en color y textura con los existentes.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El tapizado cumple la normativa de incendios para oficinas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Todos los tapizados disponibles (tela, piel sintética y piel natural) cumplen la clasificación de reacción al fuego Clase 1 según norma UNE-EN 13501-1, necesaria para edificios de uso comercial y oficinas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-06-sofa-modular-salon-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
