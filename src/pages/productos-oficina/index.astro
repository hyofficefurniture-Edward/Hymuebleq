---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario de Oficina Corporativa | Fabricante B2B — HYMUEBLE";
const pageDescription = "Catálogo de mobiliario de oficina: escritorios, estaciones de trabajo, sillas ergonómicas, cabinas acústicas y más. Fabricación a medida para proyectos corporativos.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="productos-listing">
    <header class="listado-header">
      <div class="content-container">
        <h1>Mobiliario de Oficina Corporativa | Fabricante B2B — HYMUEBLE</h1>
        <p class="listado-subtitle">Catálogo de mobiliario de oficina: escritorios, estaciones de trabajo, sillas ergonómicas, cabinas acústicas y más. Fabricación a medida para proyectos corporativos.</p>
      </div>
    </header>
    <section class="productos-grid-section">
      <div class="content-container">
        <div class="productos-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)">
            <span class="producto-card-cat">Escritorios</span>
          </div>
          <div class="producto-card-info">
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
            <p class="producto-card-desc">El escritorio ejecutivo para gerente con chapa de madera combina presencia institucional con funcionalidad operativa. Di...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)">
            <span class="producto-card-cat">Estaciones de Trabajo</span>
          </div>
          <div class="producto-card-info">
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
            <p class="producto-card-desc">La estación de trabajo modular para oficina abierta está diseñada para maximizar la productividad en espacios corporativ...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)">
            <span class="producto-card-cat">Mesas de Reunión</span>
          </div>
          <div class="producto-card-info">
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
            <p class="producto-card-desc">La mesa de reuniones modular para corporativos está diseñada para salas que cambian de configuración según el tipo de re...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/silla-ergonomica-oficina-soporte-lumbar/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-04/of-04-01.jpg)">
            <span class="producto-card-cat">Sillería</span>
          </div>
          <div class="producto-card-info">
            <h3>Silla Ergonómica de Oficina con Soporte Lumbar</h3>
            <p class="producto-card-desc">La silla ergonómica de oficina con soporte lumbar está diseñada para jornadas de trabajo de 8 horas o más. Su sistema de...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/silla-diseno-respaldo-geometrico/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-05/of-05-01.jpg)">
            <span class="producto-card-cat">Sillería de Diseño</span>
          </div>
          <div class="producto-card-info">
            <h3>Silla de Diseño con Respaldo Geométrico</h3>
            <p class="producto-card-desc">La silla de diseño con respaldo geométrico une expresión formal y confort ergonómico en una pieza de autor para espacios...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        <a href="/productos-oficina/sofa-modular-lounge-oficina/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-oficina/of-06/of-06-01.jpg)">
            <span class="producto-card-cat">Lounge Corporativo</span>
          </div>
          <div class="producto-card-info">
            <h3>Sofá Modular de Lounge para Oficina</h3>
            <p class="producto-card-desc">El sofá modular de lounge para oficina está diseñado para zonas comunes corporativas donde el equipo se reúne de forma i...</p>
            <span class="producto-card-link">Ver producto →</span>
          </div>
        </a>
        </div>
      <nav class="paginacion" aria-label="Paginación">
        <span class="pag-actual">Página 1</span>
        <a href="/productos-oficina/pagina-2/" class="pag-link">Página 2 →</a>
      </nav>
      </div>
    </section>
    <section class="cta-section">
      <div class="content-container">
        <h2>¿Busca algo específico para su proyecto corporativo?</h2>
        <p>Consulte con nuestro equipo comercial. Fabricamos mobiliario de oficina a medida.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .productos-listing { background: #FDFCF9; }
  .listado-header { background: #1a3a5c; color: #fff; padding: 64px 0 48px; text-align: center; }
  .listado-header h1 { font-size: 36px; margin-bottom: 12px; letter-spacing: -0.5px; }
  .listado-subtitle { font-size: 16px; opacity: 0.85; max-width: 600px; margin: 0 auto; }
  .productos-grid-section { padding: 48px 0; }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .productos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .producto-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.2s; display: block; }
  .producto-card:hover { box-shadow: 0 8px 32px rgba(44,36,22,0.12); transform: translateY(-2px); }
  .producto-card-img { background: #EEF0F3; height: 200px; background-size: cover; background-position: center; display: flex; align-items: flex-start; justify-content: flex-end; padding: 16px; }
  .producto-card-cat { background: #1a3a5c; color: #fff; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 4px 10px; border-radius: 4px; }
  .producto-card-info { padding: 20px; }
  .producto-card-info h3 { font-size: 16px; line-height: 1.3; margin-bottom: 8px; color: #2C2416; }
  .producto-card-desc { font-size: 13.5px; color: #6B6358; line-height: 1.6; margin-bottom: 12px; }
  .producto-card-link { font-size: 13px; font-weight: 600; color: #1a3a5c; }
  .paginacion { display: flex; justify-content: center; gap: 16px; margin-top: 40px; padding-top: 32px; border-top: 1px solid #E8E3D9; }
  .pag-actual { padding: 8px 16px; background: #1a3a5c; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600; }
  .pag-link { padding: 8px 16px; border: 2px solid #E8E3D9; border-radius: 6px; font-size: 14px; color: #1a3a5c; text-decoration: none; font-weight: 600; }
  .pag-link:hover { border-color: #1a3a5c; }
  .cta-section { padding: 48px 0; border-top: 1px solid #E8E3D9; text-align: center; background: #fff; }
  .cta-section h2 { font-size: 22px; margin-bottom: 12px; color: #2C2416; }
  .cta-section p { color: #6B6358; margin-bottom: 24px; }
  .btn-primary { background: #1a3a5c; color: #fff; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .btn-primary:hover { background: #142d4a; }
  @media (max-width: 768px) { .productos-grid { grid-template-columns: 1fr; } }
</style>
