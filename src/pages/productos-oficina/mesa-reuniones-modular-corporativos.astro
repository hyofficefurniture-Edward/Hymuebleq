---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mesa Reuniones Modular Corporativos | Fabricante Oficina";
const pageDescription = "Mesa de reuniones modular para corporativos. Configurable de 6 a 20 personas, gestión de cables integrada, chapa de madera natural. Pedido mínimo 5 unidades.";
const canonicalUrl = "/productos-oficina/mesa-reuniones-modular-corporativos/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mesa de Reuniones Modular para Corporativos",
    "description": "Mesa de reuniones modular para corporativos. Configurable de 6 a 20 personas, gestión de cables integrada, chapa de madera natural. Pedido mínimo 5 unidades.",
    "category": "Mesas de Reunión",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Mesa de Reuniones Modular para Corporativos"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Se pueden unir mesas de diferente tamaño?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, siempre que compartan la misma altura (750 mm) y el mismo tipo de cerradura de unión. Los módulos están diseñados para combinarse en configuraciones mixtas, por ejemplo un módulo central de 2000 mm con dos extensibles de 1000 mm."}}, {"@type": "Question", "name": "¿Qué carga soporta la superficie de la mesa?", "acceptedAnswer": {"@type": "Answer", "text": "La superficie soporta 80 kg de carga uniforme distribuida, suficiente para equipos de vídeo, portátiles, documentos y material de presentación. Las patas en V de 80 mm garantizan la estabilidad según norma EN 12521."}}, {"@type": "Question", "name": "¿Ofrecéis sillas a juego con la mesa?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, disponemos de líneas de sillas de reunión con el mismo acabado de chapa. Consulta el catálogo de sillería corporativa para ver las opciones compatibles con cada configuración de mesa."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Mesa de Reuniones Modular para Corporativos</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-03/of-03-01.jpg" alt="Mesa de Reuniones Modular para Corporativos para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mesa de Reuniones Modular para Corporativos</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-03/of-03-01.jpg" alt="Mesa de Reuniones Modular para Corporativos para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-03/of-03-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-03/of-03-02.jpg" alt="Detalle Mesa de Reuniones Modular para Corporativos corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-03/of-03-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-03/of-03-03.jpg" alt="Mesa de Reuniones Modular para Corporativos mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-03/of-03-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-03/of-03-04.jpg" alt="Mesa de Reuniones Modular para Corporativos instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-03/of-03-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Mesas de Reunión</span>
        <h1>Mesa de Reuniones Modular para Corporativos</h1>
        <p class="producto-intro">La mesa de reuniones modular para corporativos está diseñada para salas que cambian de configuración según el tipo de reunión. Desde una sesión de equipo de 6 personas hasta una presentación corporativa de 20 asistentes, los módulos se combinan sin herramientas y se reconfiguran en minutos. La chapa de madera natural aporta presencia institucional al espacio.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El sistema modular permite pasar de configuración en U para 12 personas a formato rectangular para 8 en menos de 10 minutos. Los módulos se unen mediante cerraduras de leva de acero que garantizan la estabilidad del conjunto y la alineación perfecta de la superficie, sin herramientas ni personal técnico especializado.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Cada módulo incorpora gestión de cables independiente con caja de conexiones empotrada: 2 tomas Schuko, 2 puertos USB, 1 HDMI y 1 RJ45 por cada 4 plazas. La tapa abatible cierra a ras de superficie, manteniendo la estética cuando no se usan las conexiones.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La superficie está fabricada con chapa de madera natural sobre MDF E1 de 25 mm, tratada con barniz de poliuretano de dos componentes que resiste 200 ciclos Taber de abrasión. Los cantos van sellados con banda de ABS de 3 mm, evitando desportilladuras en el uso diario de la sala.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El departamento técnico diseña la configuración a medida según las dimensiones de la sala y el número de plazas requerido. Entrega planos en 3D con distribución de plazas, recorridos de cables y ubicación de tomas en 4 días hábiles. Fabricación de prototipo disponible para validación antes de la serie.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Plazas</th><th>Dimensiones</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Rectangular</td><td>6-10</td><td>3000 × 1400 mm</td><td>Reuniones de equipo</td></tr><tr><td>En U</td><td>12-16</td><td>6000 × 3000 mm</td><td>Presentaciones corporativas</td></tr><tr><td>Barco</td><td>10-14</td><td>4000 × 1600 mm</td><td>Juntas directivas</td></tr><tr><td>Modal entrenador</td><td>16-20</td><td>8000 × 2000 mm</td><td>Formación y workshops</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Chapa de madera natural sobre MDF E1 de 25 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones</td>
                            <td class="spec-value">Configurable: largo 2400-8000 mm × fondo 1200-2000 mm × alto 750 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Módulos unidos con cerraduras de leva de acero, patas en V de 80 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Gestión de cables</td>
                            <td class="spec-value">Caja empotrada cada 4 plazas: 2 Schuko, 2 USB, 1 HDMI, 1 RJ45</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa natural barnizada, lacado RAL, canto ABS 3 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">FSC, E1 emisiones, estabilidad EN 12521, fuego Clase B</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Configuraciones</td>
                            <td class="spec-value">Rectangular, en U, barco, modal entrenador, circular</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">5 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Sala de juntas directivas: configuración de barco para 12 personas con cajas de conexiones para portátiles en cada plaza, acabado en nogal europeo con barnizado mate.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de presentaciones corporativas: formato en U para 16 asistentes con paso central para presentador, tomas HDMI en cada módulo para conexión de proyector.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Espacio de formación: configuración modal entrenador para 20 personas con módulos que se separan en dos mesas de 10 para trabajo en grupos reducidos.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden unir mesas de diferente tamaño?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, siempre que compartan la misma altura (750 mm) y el mismo tipo de cerradura de unión. Los módulos están diseñados para combinarse en configuraciones mixtas, por ejemplo un módulo central de 2000 mm con dos extensibles de 1000 mm.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué carga soporta la superficie de la mesa?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>La superficie soporta 80 kg de carga uniforme distribuida, suficiente para equipos de vídeo, portátiles, documentos y material de presentación. Las patas en V de 80 mm garantizan la estabilidad según norma EN 12521.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Ofrecéis sillas a juego con la mesa?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, disponemos de líneas de sillas de reunión con el mismo acabado de chapa. Consulta el catálogo de sillería corporativa para ver las opciones compatibles con cada configuración de mesa.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/silla-ergonomica-oficina-soporte-lumbar/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-04/of-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sillería</span>
            <h3>Silla Ergonómica de Oficina con Soporte Lumbar</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-03-mesa-reuniones-oficina-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
  .card-mini-cat { display: block; font-size: 11px; color: var(--color-text-light, #6B6358); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
  .card-mini-info h3 { font-size: 14px; color: var(--color-text, #2C2416); line-height: 1.4; margin: 0; }
