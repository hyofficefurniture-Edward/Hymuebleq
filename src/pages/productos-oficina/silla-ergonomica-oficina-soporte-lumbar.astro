---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Silla Ergonómica Oficina Soporte Lumbar | Fabricante B2B";
const pageDescription = "Silla ergonómica de oficina con soporte lumbar dinámico. Certificación BIFMA, malla transpirable, ajuste multi-punto. Fabricación para proyectos corporativos, pedido mínimo 50 unidades.";
const canonicalUrl = "/productos-oficina/silla-ergonomica-oficina-soporte-lumbar/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Silla Ergonómica de Oficina con Soporte Lumbar",
    "description": "Silla ergonómica de oficina con soporte lumbar dinámico. Certificación BIFMA, malla transpirable, ajuste multi-punto. Fabricación para proyectos corporativos, pedido mínimo 50 unidades.",
    "category": "Sillería",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Silla Ergonómica de Oficina con Soporte Lumbar"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿La silla tiene certificación para jornada continua de 8 horas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. La silla está certificada según norma EN 1335 para uso intensivo de 8-10 horas diarias. El soporte lumbar dinámico y la espuma de densidad diferencial están diseñados para mantener el confort durante toda la jornada laboral."}}, {"@type": "Question", "name": "¿Se puede personalizar el color de la malla y del asiento?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Ofrecemos 18 colores de malla para el respaldo y 24 colores de tapizado para el asiento. Para proyectos de más de 100 unidades, podemos fabricar colores especiales según carta RAL o Pantone del cliente."}}, {"@type": "Question", "name": "¿Qué garantía incluye la silla?", "acceptedAnswer": {"@type": "Answer", "text": "10 años en estructura (base, columna, mecanismo) y 5 años en componentes mecánicos (reposabrazos, soporte lumbar, regulaciones). Los consumibles como ruedas y gas spring tienen garantía de 2 años."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Silla Ergonómica de Oficina con Soporte Lumbar</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-04/of-04-01.jpg" alt="Silla Ergonómica de Oficina con Soporte Lumbar para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Silla Ergonómica de Oficina con Soporte Lumbar</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-04/of-04-01.jpg" alt="Silla Ergonómica de Oficina con Soporte Lumbar para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-04/of-04-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-04/of-04-02.jpg" alt="Detalle Silla Ergonómica de Oficina con Soporte Lumbar corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-04/of-04-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-04/of-04-03.jpg" alt="Silla Ergonómica de Oficina con Soporte Lumbar mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-04/of-04-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-04/of-04-04.jpg" alt="Silla Ergonómica de Oficina con Soporte Lumbar instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-04/of-04-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Sillería</span>
        <h1>Silla Ergonómica de Oficina con Soporte Lumbar</h1>
        <p class="producto-intro">La silla ergonómica de oficina con soporte lumbar está diseñada para jornadas de trabajo de 8 horas o más. Su sistema de soporte lumbar dinámico se ajusta a la curva natural de la columna, reduciendo la fatiga lumbar en un 40% según tests independientes. Certificación BIFMA y garantía de 10 años en estructura.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El soporte lumbar dinámico se ajusta en altura (90 mm de recorrido) y en profundidad (30 mm), adaptándose a la morfología de cada usuario. El mecanismo sigue el movimiento natural del cuerpo al reclinar o inclinarse hacia adelante, manteniendo el contacto con la zona lumbar en todo momento y reduciendo la presión discal.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El respaldo de malla transpirable de doble capa mantiene la temperatura corporal estable durante jornadas largas. La malla exterior de poliéster de alta tenacidad soporta 120.000 ciclos de abrasión (norma Martindale), mientras que la capa interior proporciona amortiguación sin deformación permanente tras 50.000 ciclos de carga según norma EN 1335.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El asiento incorpora espuma de poliuretano moldeada de densidad diferencial: 55 kg/m³ en el núcleo y 40 kg/m³ en el perímetro. Esta configuración distribuye la presión corporal de forma uniforme, reduciendo los puntos de compresión en la zona isquial. La profundidad del asiento se ajusta con deslizamiento de 50 mm y bloqueo en 5 posiciones.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Fabricada bajo certificación BIFMA X5.1, la silla pasa tests de resistencia de 100.000 ciclos de carga en el asiento y 200.000 ciclos en el respaldo. La base de aluminio de 5 radios soporta 150 kg de carga estática. Garantía de 10 años en estructura y 5 años en componentes mecánicos.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Modelo</th><th>Respaldo</th><th>Soporte lumbar</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Luka Estándar</td><td>Malla simple</td><td>Fijo ajustable en altura</td><td>Puesto operativo 8h</td></tr><tr><td>Luka Pro</td><td>Malla doble capa</td><td>Dinámico altura + profundidad</td><td>Ejecutivo 10h+</td></tr><tr><td>Luka Task</td><td>Malla + reposabrazos 3D</td><td>Dinámico con memoria</td><td>Call center y back-office</td></tr><tr><td>Luka Conference</td><td>Malla baja</td><td>Sin soporte lumbar</td><td>Salas de reunión</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material del respaldo</td>
                            <td class="spec-value">Malla transpirable de poliéster de alta tenacidad, doble capa</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Material del asiento</td>
                            <td class="spec-value">Espuma de poliuretano moldeada, densidad diferencial 55/40 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Soporte lumbar</td>
                            <td class="spec-value">Dinámico: altura 90 mm, profundidad 30 mm, con memoria de posición</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Reposabrazos</td>
                            <td class="spec-value">4D: altura, anchura, profundidad, rotación 360°</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mecanismo</td>
                            <td class="spec-value">Sincronizado con bloqueo en 4 posiciones, tensión regulable</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Base</td>
                            <td class="spec-value">Aluminio pulido de 5 radios, diámetro 700 mm, carga 150 kg</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">Nylon para alfombra o goma blanda para suelo duro (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">BIFMA X5.1, EN 1335, Greenguard Gold</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Garantía</td>
                            <td class="spec-value">10 años estructura, 5 años componentes mecánicos</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Puesto de trabajo operativo 8h: silla con soporte lumbar dinámico y reposabrazos 4D para equipos que pasan toda la jornada sentados, reduciendo las bajas por dolor lumbar.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Despacho ejecutivo: modelo Pro con respaldo alto en malla de doble capa y mecanismo sincronizado para reuniones prolongadas y trabajo de gestión.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Sala de formación: configuración Task con ruedas de goma blanda para suelos duros, apilable en grupos de 5 para reorganizar la sala entre sesiones.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La silla tiene certificación para jornada continua de 8 horas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. La silla está certificada según norma EN 1335 para uso intensivo de 8-10 horas diarias. El soporte lumbar dinámico y la espuma de densidad diferencial están diseñados para mantener el confort durante toda la jornada laboral.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede personalizar el color de la malla y del asiento?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Ofrecemos 18 colores de malla para el respaldo y 24 colores de tapizado para el asiento. Para proyectos de más de 100 unidades, podemos fabricar colores especiales según carta RAL o Pantone del cliente.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué garantía incluye la silla?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>10 años en estructura (base, columna, mecanismo) y 5 años en componentes mecánicos (reposabrazos, soporte lumbar, regulaciones). Los consumibles como ruedas y gas spring tienen garantía de 2 años.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-04-silla-ergonomica-escritorio-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
