---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Silla Diseño Respaldo Geométrico Oficina | Fabricante B2B";
const pageDescription = "Silla de diseño con respaldo geométrico para oficinas de autor. Estructura de aluminio, tapizado premium, certificación BIFMA. Pedido mínimo 30 unidades para proyectos.";
const canonicalUrl = "/productos-oficina/silla-diseno-respaldo-geometrico/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Silla de Diseño con Respaldo Geométrico",
    "description": "Silla de diseño con respaldo geométrico para oficinas de autor. Estructura de aluminio, tapizado premium, certificación BIFMA. Pedido mínimo 30 unidades para proyectos.",
    "category": "Sillería de Diseño",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Productos Oficina", "item": "https://hymueble.com/productos-oficina/"},
      {"@type": "ListItem", "position": 3, "name": "Silla de Diseño con Respaldo Geométrico"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Se puede personalizar el color del respaldo geométrico?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El respaldo está disponible en 6 colores estándar: blanco, negro, gris, azul oscuro, verde oliva y terracota. Para pedidos de más de 100 unidades fabricamos colores especiales a carta RAL."}}, {"@type": "Question", "name": "¿El tapizado en piel natural incluye certificación de origen?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Utilizamos piel bovina de curtición vegetal con certificación LWG (Leather Working Group) y trazabilidad de origen. Disponible en 12 colores estándar con acabado semimate."}}, {"@type": "Question", "name": "¿Ofrecéis muestra física antes del pedido en serie?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Para proyectos de más de 50 unidades fabricamos una unidad de muestra con los acabados especificados. El cliente valida la muestra antes de iniciar la producción en serie, con un plazo de entrega de 15 días para la muestra."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-oficina/">Productos Oficina</a>
        <span aria-hidden="true">›</span>
        <span>Silla de Diseño con Respaldo Geométrico</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-oficina/of-05/of-05-01.jpg" alt="Silla de Diseño con Respaldo Geométrico para oficina corporativa y proyectos empresariales" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Silla de Diseño con Respaldo Geométrico</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-oficina/of-05/of-05-01.jpg" alt="Silla de Diseño con Respaldo Geométrico para oficina corporativa vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-05/of-05-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-05/of-05-02.jpg" alt="Detalle Silla de Diseño con Respaldo Geométrico corporativo perspectiva 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-05/of-05-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-05/of-05-03.jpg" alt="Silla de Diseño con Respaldo Geométrico mostrador corporativo imagen 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-05/of-05-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-oficina/of-05/of-05-04.jpg" alt="Silla de Diseño con Respaldo Geométrico instalado en oficina proyecto 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-oficina/of-05/of-05-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Sillería de Diseño</span>
        <h1>Silla de Diseño con Respaldo Geométrico</h1>
        <p class="producto-intro">La silla de diseño con respaldo geométrico une expresión formal y confort ergonómico en una pieza de autor para espacios corporativos de diseño. El respaldo de estructura reticular combina líneas rectas y curvas calculadas para distribuir la carga lumbar sin necesidad de soporte adicional. Una silla que comunica identidad de marca desde el primer vistazo.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El respaldo geométrico está fabricado en una sola pieza de poliamida reforzada con fibra de vidrio, moldeada con tecnología de doble inyección. La estructura reticular distribuye la carga lumbar en 7 puntos de contacto calculados por software de elementos finitos, reduciendo la presión discal en un 35% respecto a un respaldo convencional de malla.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El asiento incorpora espuma de memoria de forma de 50 kg/m³ sobre base de poliuretano moldeado de 60 kg/m³. La combinación proporciona amortiguación inicial suave y soporte firme en posición sostenida, manteniendo el confort durante 10 horas de uso continuo según protocolo de test interno basado en norma EN 1335.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La base estrella de 5 radios está fundida en aluminio pulido y anodizado, soportando 150 kg de carga estática con certificación BIFMA X5.1. El gas lift de clase 4 ofrece 100 mm de recorrido y está sellado con anillos tóricos de doble labio que garantizan 100.000 ciclos de ajuste sin pérdida de presión.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Cada silla se personaliza con tapizado en piel natural, piel sintética o tela técnica ignífuga. Para proyectos corporativos de más de 50 unidades, ofrecemos desarrollo de color a carta RAL y grabado láser del logotipo en la tapa trasera del respaldo. El departamento de diseño entrega muestras físicas antes de la producción en serie.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones y acabados</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Modelo</th><th>Respaldo</th><th>Tapizado</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Lucii Executive</td><td>Geométrico alto</td><td>Piel natural</td><td>Despachos de dirección</td></tr><tr><td>Lucii Conference</td><td>Geométrico medio</td><td>Tela técnica</td><td>Salas de reuniones</td></tr><tr><td>Lucii Lounge</td><td>Geométrico bajo</td><td>Piel sintética</td><td>Zonas comunes</td></tr><tr><td>Lucii Task</td><td>Geométrico + lumbar</td><td>Malla transpirable</td><td>Puestos de diseño</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material del respaldo</td>
                            <td class="spec-value">Poliamida reforzada con fibra de vidrio, doble inyección</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Material del asiento</td>
                            <td class="spec-value">Espuma de memoria 50 kg/m³ + poliuretano moldeado 60 kg/m³</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Base de aluminio anodizado de 5 radios, gas lift clase 4</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Reposabrazos</td>
                            <td class="spec-value">Fijos en aluminio pulido o ajustables 3D (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tapizado</td>
                            <td class="spec-value">Piel natural, piel sintética o tela ignífuga Clase 1</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">BIFMA X5.1, EN 1335, Greenguard Gold, fuego Clase B</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Garantía</td>
                            <td class="spec-value">10 años estructura, 5 años tapizado y componentes</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">35-45 días laborables según tapizado</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos corporativos</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Despacho de dirección: silla ejecutiva con respaldo geométrico alto y tapizado en piel natural, como pieza de autor que comunica la identidad de la marca.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de reuniones de diseño: conjunto de sillas Lucii Conference con tapizado en tela técnica a tono con la paleta del espacio corporativo.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Lobby y zonas comunes: sillas Lucii Lounge con respaldo bajo para crear puntos de reunión informales con presencia escultórica.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede personalizar el color del respaldo geométrico?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El respaldo está disponible en 6 colores estándar: blanco, negro, gris, azul oscuro, verde oliva y terracota. Para pedidos de más de 100 unidades fabricamos colores especiales a carta RAL.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El tapizado en piel natural incluye certificación de origen?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Utilizamos piel bovina de curtición vegetal con certificación LWG (Leather Working Group) y trazabilidad de origen. Disponible en 12 colores estándar con acabado semimate.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Ofrecéis muestra física antes del pedido en serie?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Para proyectos de más de 50 unidades fabricamos una unidad de muestra con los acabados especificados. El cliente valida la muestra antes de iniciar la producción en serie, con un plazo de entrega de 15 días para la muestra.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-01/of-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Escritorios</span>
            <h3>Escritorio Ejecutivo para Gerente con Chapa de Madera</h3>
          </div>
        </a>
        <a href="/productos-oficina/estacion-trabajo-modular-oficina-abierta/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-02/of-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Estaciones de Trabajo</span>
            <h3>Estación de Trabajo Modular para Oficina Abierta</h3>
          </div>
        </a>
        <a href="/productos-oficina/mesa-reuniones-modular-corporativos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-oficina/of-03/of-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesas de Reunión</span>
            <h3>Mesa de Reuniones Modular para Corporativos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-oficina/of-05-silla-diseno-estudio-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-main-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--color-primary, #1a3a5c); }
  .gallery-main-content p { font-size: 14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
