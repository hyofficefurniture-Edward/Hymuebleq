---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Biombo Médico Privacidad Hospitalaria Acero | Fabricante Médico";
const pageDescription = "Biombo médico de privacidad para hospital con estructura de acero y paneles antimicrobianos. Plegable, con ruedas, altura 180 cm. Para exploraciones y separación de camas.";
const canonicalUrl = "/productos-medicos/biombo-medico-privacidad-hospitalaria-acero/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Biombo Médico de Privacidad Hospitalaria con Estructura de Acero",
    "description": "Biombo médico de privacidad para hospital con estructura de acero y paneles antimicrobianos. Plegable, con ruedas, altura 180 cm. Para exploraciones y",
    "category": "Privacidad Médica",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Biombo Médico de Privacidad Hospitalaria con Estructura de Acero"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Los paneles se pueden personalizar con colores o imágenes?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos más de 20 colores de laminado HPL antimicrobiano. Para proyectos especiales, podemos imprimir imágenes o patrones en los paneles con tecnología de sublimación, siempre con recubrimiento antimicrobiano superficial."}}, {"@type": "Question", "name": "¿El biombo se puede fijar al suelo en posición fija?", "acceptedAnswer": {"@type": "Answer", "text": "El biombo está diseñado para uso móvil. Para separaciones fijas, recomendamos nuestros paneles de pared modulares. Sin embargo, el freno de las ruedas proporciona estabilidad suficiente para uso estático prolongado en una misma posición."}}, {"@type": "Question", "name": "¿Se puede desinfectar el biombo con productos hospitalarios?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, los paneles de HPL antimicrobiano resisten la desinfección con lejía al 10%, alcohol isopropílico al 70% y todos los desinfectantes hospitalarios estándar. La estructura de acero pintado epoxi también es resistente a productos de limpieza hospitalarios."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Biombo Médico de Privacidad Hospitalaria con Estructura de Acero</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-12/med-12-01.jpg" alt="Biombo Médico de Privacidad Hospitalaria con Estructura de Acero para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Biombo Médico de Privacidad Hospitalaria con Estructura de Acero</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-12/med-12-01.jpg" alt="Biombo Médico de Privacidad Hospitalaria con Estructura de Acero vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-12/med-12-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-12/med-12-02.jpg" alt="Biombo Médico de Privacidad Hospitalaria con Estructura de Acero vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-12/med-12-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-12/med-12-03.jpg" alt="Biombo Médico de Privacidad Hospitalaria con Estructura de Acero vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-12/med-12-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-12/med-12-04.jpg" alt="Biombo Médico de Privacidad Hospitalaria con Estructura de Acero vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-12/med-12-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Privacidad Médica</span>
        <h1>Biombo Médico de Privacidad Hospitalaria con Estructura de Acero</h1>
        <p class="producto-intro">El biombo médico de privacidad hospitalaria proporciona separación visual inmediata entre camas, zonas de exploración y áreas de paso en el hospital. La estructura de acero con paneles antimicrobianos y ruedas con freno permite desplegar el biombo en segundos, creando un espacio privado para la exploración del paciente o el descanso en habitaciones compartidas.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Los paneles utilizan laminado HPL antimicrobiano con núcleo de MDF E0 que reduce la carga bacteriana en un 99,9% según norma ISO 22196. Las superficies no porosas resisten más de 10.000 ciclos de limpieza con desinfectantes hospitalarios sin degradación, y los cantos sellados con ABS de 2 mm eliminan las juntas donde los patógenos se acumulan.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero pulvirremetallado de 1,5 mm de espesor soporta el uso continuo en entornos hospitalarios de alto tránsito. Las bisagras de acero inoxidable permiten 100.000 ciclos de plegado y desplegado sin holgura, y el sistema de bloqueo mantiene los paneles en posición abierta sin oscilación.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las cuatro ruedas de 75 mm con rodamiento de bolas y freno de pie permiten desplazar el biombo desplegado entre habitaciones sin plegarlo. Dos ruedas tienen dirección bloqueable para trazados rectos, y el freno inmoviliza el biombo en posición durante la exploración del paciente.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El sistema de plegado en acordeón reduce el biombo a un tercio de su tamaño desplegado en menos de 5 segundos. El biombo plegado ocupa solo 30 cm de profundidad, guardándose junto a la pared o en un rincón de la habitación cuando no se necesita.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El biombo se fabrica en configuraciones de 3, 4 o 5 paneles según el ancho requerido. Los paneles se personalizan con colores que coordinan con la decoración de la habitación, y la altura estándar de 180 cm proporciona privacidad visual completa tanto de pie como sentado.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Paneles</th><th>Ancho desplegado</th><th>Altura</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>3 paneles</td><td>180 cm</td><td>180 cm</td><td>Separación de cama</td></tr><tr><td>4 paneles</td><td>240 cm</td><td>180 cm</td><td>Zona de exploración</td></tr><tr><td>5 paneles</td><td>300 cm</td><td>180 cm</td><td>Sala grande</td></tr><tr><td>A medida</td><td>Configurable</td><td>Configurable</td><td>Proyectos específicos</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Acero pulvirremetallado 1,5 mm, bisagras inox</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Paneles</td>
                            <td class="spec-value">Laminado HPL antimicrobiano sobre MDF E0, canto ABS 2 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Configuración</td>
                            <td class="spec-value">3, 4 o 5 paneles (plegable en acordeón)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Altura</td>
                            <td class="spec-value">1800 mm (personalizable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ancho desplegado</td>
                            <td class="spec-value">1800-3000 mm según número de paneles</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">4 × 75 mm, 2 con freno, 2 con dirección</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, ISO 22196</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Habitación compartida: biombo entre camas para proporcionar privacidad visual durante la exploración médica, el aseo del paciente o la visita familiar en habitaciones de dos o más camas.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de exploraciones: biombo para crear zonas de exploración temporal en salas polivalentes, separando el área de espera del área de reconocimiento sin obra civil.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Urgencias: biombo desplegable para separar camas de observación en áreas de alta densidad, proporcionando privacidad acústica y visual entre pacientes en situación de urgencia.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los paneles se pueden personalizar con colores o imágenes?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos más de 20 colores de laminado HPL antimicrobiano. Para proyectos especiales, podemos imprimir imágenes o patrones en los paneles con tecnología de sublimación, siempre con recubrimiento antimicrobiano superficial.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El biombo se puede fijar al suelo en posición fija?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El biombo está diseñado para uso móvil. Para separaciones fijas, recomendamos nuestros paneles de pared modulares. Sin embargo, el freno de las ruedas proporciona estabilidad suficiente para uso estático prolongado en una misma posición.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede desinfectar el biombo con productos hospitalarios?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, los paneles de HPL antimicrobiano resisten la desinfección con lejía al 10%, alcohol isopropílico al 70% y todos los desinfectantes hospitalarios estándar. La estructura de acero pintado epoxi también es resistente a productos de limpieza hospitalarios.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/mobiliario-sala-consulta-medica-antibacteriano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-01/med-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Consulta Médica</span>
            <h3>Mobiliario para Sala de Consulta Médica Antibacteriano</h3>
          </div>
        </a>
        <a href="/productos-medicos/mobiliario-sala-exploracion-clinica-modular/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-02/med-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sala de Exploración</span>
            <h3>Mobiliario para Sala de Exploración Clínica Modular</h3>
          </div>
        </a>
        <a href="/productos-medicos/equipamiento-habitacion-hospitalaria-curacion/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-03/med-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Habitación Hospitalaria</span>
            <h3>Equipamiento Integral de Habitación Hospitalaria de Curación</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-12-biombo-plegable-privacidad-cuidados-domiciliarios.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
