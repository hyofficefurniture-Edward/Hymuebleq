---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Cama Hospitalaria Eléctrica Cinco Posiciones | Fabricante Médico";
const pageDescription = "Cama hospitalaria eléctrica con 5 posiciones ajustables incluyendo Trendelenburg. Estructura de acero, laterales abatibles, ruedas con freno. Certificación CE, FDA 510(k).";
const canonicalUrl = "/productos-medicos/cama-hospitalaria-electrica-cinco-posiciones/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente",
    "description": "Cama hospitalaria eléctrica con 5 posiciones ajustables incluyendo Trendelenburg. Estructura de acero, laterales abatibles, ruedas con freno. Certific",
    "category": "Cama Hospitalaria",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿La cama incluye colchón?", "acceptedAnswer": {"@type": "Answer", "text": "La cama se entrega con base de colchón perforada. El colchón de espuma viscoelástica de 12 cm con funda antimicrobiana es opcional y se puede solicitar junto con la cama. Para pacientes de riesgo de úlceras, ofrecemos colchón de presión alterna con motor de aire integrado."}}, {"@type": "Question", "name": "¿Las baterías de emergencia mantienen la cama funcionando durante un corte eléctrico?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, la cama incluye una batería de respaldo de 24V que mantiene el funcionamiento de los motores durante 30 ciclos completos de ajuste en caso de corte eléctrico. La batería se recarga automáticamente cuando se restablece la alimentación."}}, {"@type": "Question", "name": "¿Se puede integrar con sistemas de pesaje de paciente?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos módulo de pesaje integrado en la base de la cama con precisión de ±100 g. El peso se muestra en una pantalla LCD en el lateral y se puede transmitir al sistema de información hospitalaria (HIS) mediante conexión inalámbrica opcional."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-05/med-05-01.jpg" alt="Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-05/med-05-01.jpg" alt="Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-05/med-05-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-05/med-05-02.jpg" alt="Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-05/med-05-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-05/med-05-03.jpg" alt="Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-05/med-05-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-05/med-05-04.jpg" alt="Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-05/med-05-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Cama Hospitalaria</span>
        <h1>Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente</h1>
        <p class="producto-intro">La cama hospitalaria eléctrica de cinco posiciones está diseñada para pacientes hospitalizados que requieren ajuste postural continuo. Los cinco motores eléctricos permiten modificar la altura, el respaldo, la sección de piernas y la inclinación Trendelenburg de forma independiente. La estructura de acero con recubrimiento antimicrobiano soporta 250 kg de carga dinámica y cumple las certificaciones FDA 510(k) y CE para dispositivo médico.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Los cinco motores eléctricos de 24V permiten ajustar la altura entre 480 y 780 mm, el respaldo de 0 a 75°, la sección de piernas de 0 a 45°, y las posiciones Trendelenburg y anti-Trendelenburg. El control se realiza mediante mando manual con cable de 2 metros y botones de membrana lavables.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero pulvirremetallizado con acabado antimicrobiano soporta 250 kg de carga dinámica y 400 kg estática. Las pruebas de fatiga superan los 100.000 ciclos de carga según norma IEC 60601-2-52, garantizando una vida útil superior a 10 años en uso hospitalario continuo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los cuatro laterales abatibles de aluminio con recubrimiento antibacteriano se bajan con una sola mano para facilitar la transferencia del paciente. Incluyen controles integrados para el ajuste de la cama desde el propio laterar, permitiendo al paciente autónomo modificar su posición sin asistencia del personal.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Las cuatro ruedas de 125 mm con rodamiento de bolas y freno centralizado permiten el desplazamiento silencioso por pasillos hospitalarios. El sistema de freno se acciona con el pie desde cualquier punto de la cama, y dos ruedas tienen dirección bloqueable para trazados rectos en traslados largos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La base de colchón de chapa perforada facilita la ventilación del colchón y previene la formación de úlceras por presión. El colchón opcional de espuma viscoelástica de 12 cm con funda de vinilo antimicrobiano reduce el riesgo de úlceras en un 35% comparado con colchones convencionales de hospital.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Motores</th><th>Carga</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Estándar 5 motor</td><td>5 × 24V DC</td><td>250 kg</td><td>Hospital de agudos</td></tr><tr><td>UCI/Críticos</td><td>5 + alarma salida</td><td>250 kg</td><td>Cuidados intensivos</td></tr><tr><td>Bariátrica</td><td>5 reforzados</td><td>350 kg</td><td>Pacientes bariátricos</td></tr><tr><td>Geriatría</td><td>3 motor + manual</td><td>200 kg</td><td>Residencias de mayores</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Dimensiones</td>
                            <td class="spec-value">2150 × 980 × 480-780 mm (altura ajustable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga dinámica</td>
                            <td class="spec-value">250 kg (550 lbs)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ajustes eléctricos</td>
                            <td class="spec-value">Altura, respaldo 0-75°, piernas 0-45°, Trendelenburg ±15°</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Acero pulvirremetallizado con recubrimiento antimicrobiano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Base colchón</td>
                            <td class="spec-value">Chapa de acero perforada para ventilación</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Laterales</td>
                            <td class="spec-value">4 laterales de aluminio abatibles con control integrado</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">4 × 125 mm, freno centralizado, 2 con dirección</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Alimentación</td>
                            <td class="spec-value">24V DC, adaptador 110/220V AC</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">FDA 510(k), CE, ISO 13485, IEC 60601-2-52</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Hospital de agudos: cama eléctrica de cinco posiciones para planta de hospitalización, con laterales abatibles y ruedas para traslado intrahospitalario durante pruebas diagnósticas.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Unidad de cuidados intensivos: configuración con alarma de salida de cama, colchón de presión alterna y compatibilidad con monitor de constantes vitales y bomba de infusión.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Residencia geriátrica: versión simplificada de tres motores con altura mínima reducida a 380 mm para prevención de caídas en pacientes ancianos con deterioro de movilidad.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La cama incluye colchón?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>La cama se entrega con base de colchón perforada. El colchón de espuma viscoelástica de 12 cm con funda antimicrobiana es opcional y se puede solicitar junto con la cama. Para pacientes de riesgo de úlceras, ofrecemos colchón de presión alterna con motor de aire integrado.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las baterías de emergencia mantienen la cama funcionando durante un corte eléctrico?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, la cama incluye una batería de respaldo de 24V que mantiene el funcionamiento de los motores durante 30 ciclos completos de ajuste en caso de corte eléctrico. La batería se recarga automáticamente cuando se restablece la alimentación.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede integrar con sistemas de pesaje de paciente?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos módulo de pesaje integrado en la base de la cama con precisión de ±100 g. El peso se muestra en una pantalla LCD en el lateral y se puede transmitir al sistema de información hospitalaria (HIS) mediante conexión inalámbrica opcional.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/sistema-almacenamiento-medico-estanteria-antimicrobiana/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-06/med-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Almacenamiento Médico</span>
            <h3>Sistema de Almacenamiento Médico con Estantería Antimicrobiana</h3>
          </div>
        </a>
        <a href="/productos-medicos/carro-medico-movil-cajones-seguridad/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-07/med-07-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Carros Médicos</span>
            <h3>Carro Médico Móvil con Cajones de Seguridad para Hospital</h3>
          </div>
        </a>
        <a href="/productos-medicos/conjunto-mesa-silla-comedor-residencia-geriatrica/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-08/med-08-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Comedor Geriátrico</span>
            <h3>Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-05-cama-articulada-electrica-cuidados-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
