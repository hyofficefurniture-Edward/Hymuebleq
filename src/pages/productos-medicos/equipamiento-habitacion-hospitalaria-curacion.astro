---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Equipamiento Habitación Hospitalaria Curación | Fabricante Médico";
const pageDescription = "Equipamiento integral para habitación hospitalaria: cabecero, mesita, armario y sillón de acompañante. Diseño basado en evidencia, materiales antimicrobianos, fabricación a medida.";
const canonicalUrl = "/productos-medicos/equipamiento-habitacion-hospitalaria-curacion/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Equipamiento Integral de Habitación Hospitalaria de Curación",
    "description": "Equipamiento integral para habitación hospitalaria: cabecero, mesita, armario y sillón de acompañante. Diseño basado en evidencia, materiales antimicr",
    "category": "Habitación Hospitalaria",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Equipamiento Integral de Habitación Hospitalaria de Curación"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿El cabecero clínico incluye la instalación de las tomas médicas?", "acceptedAnswer": {"@type": "Answer", "text": "El cabecero se entrega con los racores de conexión para gases medicinales según norma DIN 13620-2. La instalación de las tuberías y la conexión al sistema central de gases la realiza el instalador sanitario certificado de la obra, coordinado con nuestro equipo técnico."}}, {"@type": "Question", "name": "¿El sillón de acompañante soporta peso elevado?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el sillón-cama está diseñado para soportar hasta 150 kg en posición de cama desplegada. La estructura de tubo de acero de 1,5 mm de espesor y las articulaciones reforzadas garantizan la estabilidad durante el descanso nocturno del familiar."}}, {"@type": "Question", "name": "¿Se puede personalizar el color de la chapa de madera?", "acceptedAnswer": {"@type": "Answer", "text": "Ofrecemos más de 30 acabados de chapa antimicrobiana: roble natural, nogal europeo, fresno tintado, wengué y lacados RAL a medida. El departamento técnico prepara muestras físicas para que el equipo de arquitectura del hospital valide el acabado antes de la producción."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Equipamiento Integral de Habitación Hospitalaria de Curación</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-03/med-03-01.jpg" alt="Equipamiento Integral de Habitación Hospitalaria de Curación para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Equipamiento Integral de Habitación Hospitalaria de Curación</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-03/med-03-01.jpg" alt="Equipamiento Integral de Habitación Hospitalaria de Curación vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-03/med-03-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-03/med-03-02.jpg" alt="Equipamiento Integral de Habitación Hospitalaria de Curación vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-03/med-03-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-03/med-03-03.jpg" alt="Equipamiento Integral de Habitación Hospitalaria de Curación vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-03/med-03-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-03/med-03-04.jpg" alt="Equipamiento Integral de Habitación Hospitalaria de Curación vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-03/med-03-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Habitación Hospitalaria</span>
        <h1>Equipamiento Integral de Habitación Hospitalaria de Curación</h1>
        <p class="producto-intro">El equipamiento integral de habitación hospitalaria de curación reúne todos los elementos necesarios para crear un entorno terapéutico: cabecero clínico con tomas médicas, mesita de noche con cajones, armario para pertenencias del paciente y sillón de acompañante. El diseño se basa en principios de arquitectura centrada en la evidencia, utilizando acabados en madera que reducen el estrés del paciente y aceleran la recuperación.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El cabecero clínico integra tomas de oxígeno, vacío, aire comprimido y conexiones eléctricas en un solo módulo de chapa de madera. El diseño oculta las instalaciones médicas tras un panel abatible que permite el acceso técnico sin alterar la estética de la habitación. Cumbe la norma UNE-EN 7375 para sistemas de distribución de gases medicinales.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La mesita de noche hospitalera dispone de cajones con cierre suave y superficie superior en Silestone antibacteriano. El cajón superior incluye cerradura con llave para objetos de valor del paciente, mientras que el inferior se utiliza para material de higiene y cuidado personal.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El armario para pertenencias del paciente se fabrica en chapa de madera natural sobre MDF E1, con puerta abatible y interior forrado. Las bisagras son de cierre suave con ángulo de apertura de 110 grados, y el interior incluye una repisa regulable y una barra para colgar batas y ropa de cama.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El sillón de acompañante se convierte en cama de descanso mediante un mecanismo de despliegue sencillo. El colchón de espuma de alta densidad de 8 cm permite el descanso del familiar durante la noche, con funda de vinilo ignífugo desmontable y lavable para mantener la higiene entre usos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El conjunto completo se personaliza según el nivel asistencial: habitación estándar, suite VIP o unidad de cuidados intensivos. El departamento técnico coordina la instalación con los equipos de obra, ajustando las medidas a las particularidades de cada habitación y garantizando la integración con los sistemas médicos existentes.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Nivel asistencial</th><th>Cabecero</th><th>Materiales</th><th>Destinatario</th></tr>
            </thead>
            <tbody>
              <tr><td>Estándar</td><td>Básico con tomas</td><td>MDF E1 + chapa</td><td>Hospital general</td></tr><tr><td>Premium</td><td>Multifunción LED</td><td>Madera noble + Silestone</td><td>Suite VIP</td></tr><tr><td>UCI/Críticos</td><td>Técnico con monitor</td><td>Acero + antimicrobiano</td><td>Cuidados intensivos</td></tr><tr><td>Geriatría</td><td>Ergonómico bajo</td><td>Madera cálida + barras</td><td>Residencias mayores</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">MDF E0 con chapa de madera natural, cantos ABS 2 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cabecero clínico</td>
                            <td class="spec-value">Módulo con tomas O2, vacío, aire, eléctricas, panel abatible</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesita de noche</td>
                            <td class="spec-value">2 cajones + superficie Silestone, 450 × 400 × 750 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Armario paciente</td>
                            <td class="spec-value">1 puerta + repisa + barra, 600 × 550 × 1800 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Sillón acompañante</td>
                            <td class="spec-value">Convierte en cama 190 × 600 mm, espuma 8 cm, vinilo ignífugo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">UNE-EN 7375, ISO 9001, CE, CAL117, FSC</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 conjuntos (habitaciones completas)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">35-45 días laborables según configuración</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Hospital de agudos: habitación individual con cabecero clínico completo, mesita con superficies antibacterianas y sillón-cama para acompañante durante el ingreso.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Suite hospitalaria VIP: equipamiento premium con cabecero multifunción LED, armario vestidor y sillón de diseño que se convierte en cama de descanso para el familiar.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Residencia geriátrica: conjunto con acabados cálidos en madera, barras de apoyo integradas y mobiliario a altura reducida para facilitar la autonomía del residente mayor.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El cabecero clínico incluye la instalación de las tomas médicas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El cabecero se entrega con los racores de conexión para gases medicinales según norma DIN 13620-2. La instalación de las tuberías y la conexión al sistema central de gases la realiza el instalador sanitario certificado de la obra, coordinado con nuestro equipo técnico.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El sillón de acompañante soporta peso elevado?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el sillón-cama está diseñado para soportar hasta 150 kg en posición de cama desplegada. La estructura de tubo de acero de 1,5 mm de espesor y las articulaciones reforzadas garantizan la estabilidad durante el descanso nocturno del familiar.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede personalizar el color de la chapa de madera?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Ofrecemos más de 30 acabados de chapa antimicrobiana: roble natural, nogal europeo, fresno tintado, wengué y lacados RAL a medida. El departamento técnico prepara muestras físicas para que el equipo de arquitectura del hospital valide el acabado antes de la producción.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/mostrador-recepcion-hospitalaria-antimicrobiano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-04/med-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Recepción Hospitalaria</span>
            <h3>Mostrador de Recepción Hospitalaria Antimicrobiano Modular</h3>
          </div>
        </a>
        <a href="/productos-medicos/cama-hospitalaria-electrica-cinco-posiciones/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-05/med-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Cama Hospitalaria</span>
            <h3>Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente</h3>
          </div>
        </a>
        <a href="/productos-medicos/sistema-almacenamiento-medico-estanteria-antimicrobiana/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-06/med-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Almacenamiento Médico</span>
            <h3>Sistema de Almacenamiento Médico con Estantería Antimicrobiana</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-03-set-muebles-habitacion-cuidados-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
