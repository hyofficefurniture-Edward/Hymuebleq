---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mesa Cama Hospitalaria Regulable Ruedas | Fabricante Médico";
const pageDescription = "Mesa de cama hospitalaria regulable en altura e inclinación. Estructura de acero con ruedas, superficie antimicrobiana. Para comida, lectura y trabajo del paciente encamado.";
const canonicalUrl = "/productos-medicos/mesa-cama-hospitalaria-regulable-ruedas/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente",
    "description": "Mesa de cama hospitalaria regulable en altura e inclinación. Estructura de acero con ruedas, superficie antimicrobiana. Para comida, lectura y trabajo",
    "category": "Mesa de Cama",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿La mesa soporta un ordenador portátil?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, la superficie soporta 25 kg de carga, suficiente para un ordenador portátil, libros y material de escritura. La superficie de 80 × 40 cm ofrece espacio adecuado para trabajar cómodamente desde la cama."}}, {"@type": "Question", "name": "¿Las ruedas rayan el suelo del hospital?", "acceptedAnswer": {"@type": "Answer", "text": "No, las ruedas de 75 mm están fabricadas en material TPR no marcante que no daña suelos de vinilo, cerámica, epoxy o madera. Se deslizan silenciosamente y no producen marcas en el suelo."}}, {"@type": "Question", "name": "¿Se puede desmontar la columna para limpieza profunda?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, la columna de gas se desmonta de la base y la superficie con dos tornillos, facilitando la limpieza profunda entre pacientes. El proceso toma 2 minutos y no requiere herramientas especiales."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-11/med-11-01.jpg" alt="Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-11/med-11-01.jpg" alt="Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-11/med-11-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-11/med-11-02.jpg" alt="Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-11/med-11-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-11/med-11-03.jpg" alt="Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-11/med-11-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-11/med-11-04.jpg" alt="Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-11/med-11-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Mesa de Cama</span>
        <h1>Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente</h1>
        <p class="producto-intro">La mesa de cama hospitalaria regulable permite al paciente encamado comer, leer, escribir o utilizar un ordenador portátil con autonomía. La superficie de acero con recubrimiento antimicrobiano se ajusta en altura e inclinación, y las ruedas con freno permiten posicionar la mesa sobre la cama sin obstaculizar el trabajo del personal sanitario.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El ajuste de altura mediante columna de gas permite elevar la mesa de 65 a 110 cm con una sola mano. El paciente puede ajustar la altura desde la cama sin asistencia, encontrando la posición ideal para comer, leer o trabajar con el ordenador. El mecanismo de gas mantiene la posición de forma estable sin deslizamientos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La superficie de acero pintado epoxi con tratamiento antimicrobiano mide 80 × 40 cm y soporta 25 kg de carga. El borde perimetral elevado de 15 mm evita que los objetos se deslicen al inclinar la mesa, y la superficie se limpia con desinfectantes hospitalarios sin degradarse.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La base en H de acero de 60 × 40 cm con cuatro ruedas de 75 mm permite deslizar la mesa bajo la cama y colocarla exactamente sobre el paciente. Dos ruedas tienen freno de pie para inmovilizar la mesa durante su uso, y el diseño de la base no obstaculiza los pies del paciente ni del personal.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La inclinación de la superficie se ajusta de 0 a 45° mediante una palanca lateral, permitiendo leer o ver una tableta sin sujetar el dispositivo con las manos. El mecanismo de bloqueo mantiene la inclinación de forma segura, y un tope inferior evita la caída de objetos al cambiar el ángulo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La mesa se fabrica en dos versiones: estándar para planta de hospitalización y reforzada para UCI con columna de acero de mayor diámetro y superficie ampliada de 90 × 45 cm. Ambas versiones cumplen la normativa IEC 60601-2-52 para mobiliario eléctrico en entornos de cuidado del paciente.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Modelo</th><th>Superficie</th><th>Altura</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Estándar</td><td>80 × 40 cm</td><td>65-110 cm</td><td>Hospitalización</td></tr><tr><td>Reforzada UCI</td><td>90 × 45 cm</td><td>60-115 cm</td><td>Cuidados intensivos</td></tr><tr><td>Con inclinación</td><td>80 × 40 cm + 0-45°</td><td>65-110 cm</td><td>Lectura/rehabilitación</td></tr><tr><td>A medida</td><td>Configurable</td><td>Configurable</td><td>Proyectos especiales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">Acero epoxi antimicrobiano 80 × 40 cm, borde 15 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Altura ajustable</td>
                            <td class="spec-value">65-110 cm mediante columna de gas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Inclinación</td>
                            <td class="spec-value">0 a 45° con palanca lateral y bloqueo de seguridad</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Base</td>
                            <td class="spec-value">Acero en H, 60 × 40 cm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">4 × 75 mm, 2 con freno de pie</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga máxima</td>
                            <td class="spec-value">25 kg sobre la superficie</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, IEC 60601-2-52</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Planta de hospitalización: mesa de cama para que el paciente coma, lea o utilice dispositivos electrónicos durante el ingreso, con ajuste de altura autónomo desde la cama.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Unidad de cuidados intensivos: mesa reforzada con superficie ampliada para equipos de monitorización portátil, con ruedas que permiten reposicionar la mesa sin mover al paciente.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Rehabilitación: mesa con inclinación para ejercicios de lectura y escritura durante la recuperación motora, ajustable en ángulo para adaptarse a la capacidad del paciente.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La mesa soporta un ordenador portátil?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, la superficie soporta 25 kg de carga, suficiente para un ordenador portátil, libros y material de escritura. La superficie de 80 × 40 cm ofrece espacio adecuado para trabajar cómodamente desde la cama.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las ruedas rayan el suelo del hospital?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>No, las ruedas de 75 mm están fabricadas en material TPR no marcante que no daña suelos de vinilo, cerámica, epoxy o madera. Se deslizan silenciosamente y no producen marcas en el suelo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede desmontar la columna para limpieza profunda?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, la columna de gas se desmonta de la base y la superficie con dos tornillos, facilitando la limpieza profunda entre pacientes. El proceso toma 2 minutos y no requiere herramientas especiales.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/biombo-medico-privacidad-hospitalaria-acero/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-12/med-12-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Privacidad Médica</span>
            <h3>Biombo Médico de Privacidad Hospitalaria con Estructura de Acero</h3>
          </div>
        </a>
        <a href="/productos-medicos/mobiliario-sala-consulta-medica-antibacteriano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-01/med-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Consulta Médica</span>
            <h3>Mobiliario para Sala de Consulta Médica Antibacteriano</h3>
          </div>
        </a>
        <a href="/productos-medicos/mobiliario-sala-exploracion-clinica-modular/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-02/med-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sala de Exploración</span>
            <h3>Mobiliario para Sala de Exploración Clínica Modular</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-11-mesa-cama-regulable-paciente-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
