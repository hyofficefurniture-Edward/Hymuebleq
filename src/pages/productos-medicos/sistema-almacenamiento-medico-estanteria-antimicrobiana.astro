---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Sistema Almacenamiento Médico Estantería Antimicrobiano | Fabricante";
const pageDescription = "Sistema de almacenamiento médico con estantería antimicrobiana de acero 304. Módulos móviles de alta densidad, capacidad 150 kg/estante. Para CSSD, farmacia y quirófano.";
const canonicalUrl = "/productos-medicos/sistema-almacenamiento-medico-estanteria-antimicrobiana/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Sistema de Almacenamiento Médico con Estantería Antimicrobiana",
    "description": "Sistema de almacenamiento médico con estantería antimicrobiana de acero 304. Módulos móviles de alta densidad, capacidad 150 kg/estante. Para CSSD, fa",
    "category": "Almacenamiento Médico",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Sistema de Almacenamiento Médico con Estantería Antimicrobiana"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Los módulos móviles requieren obra civil para los rieles?", "acceptedAnswer": {"@type": "Answer", "text": "Los rieles del sistema móvil manual se instalan sobre el suelo existente con anclaje químico, sin necesidad de obra civil. Para el sistema motorizado, se recomienda un suelo nivelado con tolerancia de ±2 mm. El equipo técnico verifica la idoneidad del suelo antes de la producción."}}, {"@type": "Question", "name": "¿El sistema incluye el software de gestión de inventario?", "acceptedAnswer": {"@type": "Answer", "text": "El sistema electrónico de cerraduras RFID incluye software básico de registro de accesos y trazabilidad. Para gestión integral de inventario, ofrecemos integración con el sistema de información de farmacia (PhIS) o el ERP del hospital mediante API REST."}}, {"@type": "Question", "name": "¿Se puede ampliar el sistema en el futuro?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el sistema es 100% modular. Se pueden añadir módulos adicionales en cualquier momento, tanto en configuración estática como móvil. Los rieles del sistema móvil se prolongan según sea necesario, y los nuevos módulos comparten el mismo sistema de cerraduras y etiquetado."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Sistema de Almacenamiento Médico con Estantería Antimicrobiana</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-06/med-06-01.jpg" alt="Sistema de Almacenamiento Médico con Estantería Antimicrobiana para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Sistema de Almacenamiento Médico con Estantería Antimicrobiana</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-06/med-06-01.jpg" alt="Sistema de Almacenamiento Médico con Estantería Antimicrobiana vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-06/med-06-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-06/med-06-02.jpg" alt="Sistema de Almacenamiento Médico con Estantería Antimicrobiana vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-06/med-06-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-06/med-06-03.jpg" alt="Sistema de Almacenamiento Médico con Estantería Antimicrobiana vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-06/med-06-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-06/med-06-04.jpg" alt="Sistema de Almacenamiento Médico con Estantería Antimicrobiana vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-06/med-06-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Almacenamiento Médico</span>
        <h1>Sistema de Almacenamiento Médico con Estantería Antimicrobiana</h1>
        <p class="producto-intro">El sistema de almacenamiento médico con estantería antimicrobiana está diseñado para maximizar la capacidad de almacenamiento en espacios hospitalarios limitados. Los módulos de acero inoxidable 304 con recubrimiento antimicrobiano se configuran en estantería estática o móvil de alta densidad, aumentando la capacidad de inventario entre un 35% y un 50% frente a sistemas convencionales. Cada estante soporta 150 kg y se ajusta en altura cada 25 mm.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El sistema de estantería móvil de alta densidad utiliza rieles empotrados en el suelo que permiten desplazar los módulos manualmente o con motor eléctrico. Al eliminar los pasillos innecesarios, se aumenta la capacidad de almacenamiento entre un 35% y un 50% sin ampliar la superficie de la sala, optimizando el coste por metro cuadrado hospitalario.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El acero inoxidable 304 con recubrimiento antimicrobiano ISO 22196 reduce la carga bacteriana en un 99,9% y resiste la corrosión por desinfectantes hospitalarios. Las superficies no porosas no absorben líquidos derramados, y las rejillas de ventilación en los estantes impiden la acumulación de polvo sobre el material estéril almacenado.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los módulos incluyen bandejas extraíbles con divisores modulares que se ajustan según el tamaño del material: cajas de guantes, paquetes de gasas, instrumental envasado o frascos de medicación. El sistema de etiquetado con códigos de color facilita la identificación visual del contenido, reduciendo el tiempo de búsqueda en un 20%.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Las cerraduras electrónicas opcionales con lector de tarjeta RFID restringen el acceso a medicamentos controlados y material de alto valor. El sistema registra cada apertura con fecha, hora y usuario, generando un informe trazable que cumple los requisitos de la normativa de farmacia hospitalaria.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El sistema se fabrica a medida según los planos arquitectónicos de la sala, coordinando la instalación con las conducciones de HVAC, iluminación y tomas eléctricas existentes. El equipo técnico entrega el diseño en 3D antes de la producción para validación por parte del responsable de farmacia o CSSD.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Tipo</th><th>Material</th><th>Densidad</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Estantería estática</td><td>Acero 304</td><td>Estándar</td><td>Almacén general</td></tr><tr><td>Móvil alta densidad</td><td>Acero 304 + antimicrobiano</td><td>+50% capacidad</td><td>CSSD y farmacia</td></tr><tr><td>Empotrado en pared</td><td>Inox + cristal</td><td>+35% capacidad</td><td>Quirófano</td></tr><tr><td>Móvil motorizado</td><td>Inox + motor</td><td>Máxima densidad</td><td>Centro logístico</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material</td>
                            <td class="spec-value">Acero inoxidable 304 con recubrimiento antimicrobiano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga por estante</td>
                            <td class="spec-value">80-150 kg (configurable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones estándar</td>
                            <td class="spec-value">Alto 2100 × Ancho 900 × Fondo 450 mm (modular)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tipo</td>
                            <td class="spec-value">Estático, móvil manual o móvil motorizado</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estantes</td>
                            <td class="spec-value">Regulables cada 25 mm, bandejas extraíbles con divisores</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cerraduras</td>
                            <td class="spec-value">Mecánica con llave o electrónica RFID (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, ISO 22196, SEFA 8</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 módulos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Central de esterilización (CSSD): estantería móvil de alta densidad para almacenamiento de instrumental quirúrgico esterilizado, con bandejas ventiladas que mantienen la integridad del envoltorio estéril.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Farmacia hospitalaria: módulos con cerradura RFID para medicamentos controlados, estantes con divisores para gestión FIFO y bandejas con código de color por categoría farmacológica.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Quirófano y UCI: armarios empotrados en pared con frente de cristal para visualización rápida de material, situados en zona estéril con superficie de apoyo para preparación de instrumental.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los módulos móviles requieren obra civil para los rieles?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Los rieles del sistema móvil manual se instalan sobre el suelo existente con anclaje químico, sin necesidad de obra civil. Para el sistema motorizado, se recomienda un suelo nivelado con tolerancia de ±2 mm. El equipo técnico verifica la idoneidad del suelo antes de la producción.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El sistema incluye el software de gestión de inventario?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El sistema electrónico de cerraduras RFID incluye software básico de registro de accesos y trazabilidad. Para gestión integral de inventario, ofrecemos integración con el sistema de información de farmacia (PhIS) o el ERP del hospital mediante API REST.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede ampliar el sistema en el futuro?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el sistema es 100% modular. Se pueden añadir módulos adicionales en cualquier momento, tanto en configuración estática como móvil. Los rieles del sistema móvil se prolongan según sea necesario, y los nuevos módulos comparten el mismo sistema de cerraduras y etiquetado.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/carro-medico-movil-cajones-seguridad/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-07/med-07-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Carros Médicos</span>
            <h3>Carro Médico Móvil con Cajones de Seguridad para Hospital</h3>
          </div>
        </a>
        <a href="/productos-medicos/conjunto-mesa-silla-comedor-residencia-geriatrica/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-08/med-08-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Comedor Geriátrico</span>
            <h3>Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica</h3>
          </div>
        </a>
        <a href="/productos-medicos/sillones-espera-modulares-area-hospitalaria/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-09/med-09-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sala de Espera</span>
            <h3>Sillones de Espera Modulares para Área Hospitalaria</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-06-armario-organizador-material-cuidados-medicos.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
