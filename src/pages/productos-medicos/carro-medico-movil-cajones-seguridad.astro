---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Carro Médico Móvil Cajones Seguridad Hospital | Fabricante";
const pageDescription = "Carro médico móvil con cajones de seguridad centralizada para hospital. Estructura de acero antimicrobiano, ruedas de 125 mm silentes, carga 150 kg. Para urgencias y enfermería.";
const canonicalUrl = "/productos-medicos/carro-medico-movil-cajones-seguridad/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Carro Médico Móvil con Cajones de Seguridad para Hospital",
    "description": "Carro médico móvil con cajones de seguridad centralizada para hospital. Estructura de acero antimicrobiano, ruedas de 125 mm silentes, carga 150 kg. P",
    "category": "Carros Médicos",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Carro Médico Móvil con Cajones de Seguridad para Hospital"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Los cajones se pueden configurar con diferentes tamaños?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos configuraciones con cajones de diferentes alturas: 100, 150 y 200 mm. Cada cajón se puede solicitar con el tamaño que mejor se adapte al material almacenado. Los divisores interiores se ajustan sin herramientas."}}, {"@type": "Question", "name": "¿La cerradura electrónica RFID incluye software de gestión?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el sistema RFID incluye software básico de registro de accesos con fecha, hora y usuario. Para integración con el sistema de información de farmacia, ofrecemos API REST que sincroniza los datos con el PhIS del hospital."}}, {"@type": "Question", "name": "¿Se puede montar un ordenador portátil sobre el carro?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos soporte opcional para portátil con brazo articulado que se fija al lateral del carro. El soporte incluye bandeja regulable y gestión de cables para cargar el equipo durante el desplazamiento."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Carro Médico Móvil con Cajones de Seguridad para Hospital</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-07/med-07-01.jpg" alt="Carro Médico Móvil con Cajones de Seguridad para Hospital para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Carro Médico Móvil con Cajones de Seguridad para Hospital</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-07/med-07-01.jpg" alt="Carro Médico Móvil con Cajones de Seguridad para Hospital vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-07/med-07-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-07/med-07-02.jpg" alt="Carro Médico Móvil con Cajones de Seguridad para Hospital vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-07/med-07-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-07/med-07-03.jpg" alt="Carro Médico Móvil con Cajones de Seguridad para Hospital vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-07/med-07-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-07/med-07-04.jpg" alt="Carro Médico Móvil con Cajones de Seguridad para Hospital vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-07/med-07-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Carros Médicos</span>
        <h1>Carro Médico Móvil con Cajones de Seguridad para Hospital</h1>
        <p class="producto-intro">El carro médico móvil con cajones de seguridad está diseñado para el transporte y la organización de material clínico en el día a día del hospital. La estructura de acero con recubrimiento antimicrobiano, las ruedas silentes de 125 mm y el sistema de cerradura centralizada hacen de este carro una herramienta indispensable para enfermería, urgencias y farmacia hospitalaria.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero pulvirremetallado con recubrimiento antimicrobiano soporta 150 kg de carga total sin deformación. Las pruebas de fatiga superan los 50.000 ciclos de apertura de cajones, garantizando una vida útil superior a 8 años en uso hospitalario continuo con desinfección diaria.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las cuatro ruedas de 125 mm con rodamiento de bolas y material TPR silencioso permiten el desplazamiento por pasillos sin ruido, respetando el descanso del paciente. Dos ruedas tienen freno de pie y otras dos tienen dirección bloqueable para trazados rectos en traslados largos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El sistema de cerradura centralizada con cilindro de seguridad bloquea todos los cajones con una sola llave. La versión electrónica opcional con lector de tarjeta RFID registra cada apertura, ideal para carros de medicación controlada y material de alto valor.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los cajones con guías telescópicas de salida completa ofrecen capacidad de 30 a 45 kg cada uno. Los divisores interiores modulares se ajustan según el contenido: jeringas, viales, material de curas o instrumental. Las etiquetas de identificacción con código de color facilitan la localización del material durante la urgencia.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La superficie superior de ABS moldeado con bordes elevados sirve de área de trabajo improvisada para preparar medicación o material de curas. Incluye soporte para botella de suero y barra opcional para monitor portátil, adaptándose al uso en planta de hospitalización o urgencias.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Cajones</th><th>Cerradura</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Básico 4 cajones</td><td>4 × 30 kg</td><td>Mecánica centralizada</td><td>Enfermería planta</td></tr><tr><td>Urgencias 6 cajones</td><td>6 × 35 kg</td><td>Mecánica + sello</td><td>Urgencias/Código azul</td></tr><tr><td>Medicación 5 cajones</td><td>5 × 30 kg</td><td>Electrónica RFID</td><td>Farmacia hospitalaria</td></tr><tr><td>A medida</td><td>Configurable</td><td>Configurable</td><td>Proyectos específicos</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Dimensiones</td>
                            <td class="spec-value">750 × 475 × 920 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Acero pulvirremetallado con recubrimiento antimicrobiano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">ABS moldeado con bordes elevados, soporte para suero</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cajones</td>
                            <td class="spec-value">4-6 con guías telescópicas, 30-45 kg/cajón, divisores modulares</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cerradura</td>
                            <td class="spec-value">Centralizada mecánica o electrónica RFID (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">4 × 125 mm TPR silenciosas, 2 con freno, 2 con dirección</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga total</td>
                            <td class="spec-value">150 kg</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, BIFMA, SGS</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Planta de hospitalización: carro de enfermería para rondas diarias con material de curas, medicación y registro clínico, desplazándose silenciosamente entre habitaciones.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Urgencias y código azul: carro de parada equipado con desfibrilador, medicación de rescate y material de intubación, con cajones identificados por color para acceso inmediato.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Farmacia hospitalaria: carro de medicación controlada con cerradura electrónica RFID y divisores para gestión por paciente, registrado cada acceso para trazabilidad farmacéutica.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los cajones se pueden configurar con diferentes tamaños?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos configuraciones con cajones de diferentes alturas: 100, 150 y 200 mm. Cada cajón se puede solicitar con el tamaño que mejor se adapte al material almacenado. Los divisores interiores se ajustan sin herramientas.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La cerradura electrónica RFID incluye software de gestión?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el sistema RFID incluye software básico de registro de accesos con fecha, hora y usuario. Para integración con el sistema de información de farmacia, ofrecemos API REST que sincroniza los datos con el PhIS del hospital.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede montar un ordenador portátil sobre el carro?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos soporte opcional para portátil con brazo articulado que se fija al lateral del carro. El soporte incluye bandeja regulable y gestión de cables para cargar el equipo durante el desplazamiento.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/conjunto-mesa-silla-comedor-residencia-geriatrica/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-08/med-08-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Comedor Geriátrico</span>
            <h3>Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica</h3>
          </div>
        </a>
        <a href="/productos-medicos/sillones-espera-modulares-area-hospitalaria/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-09/med-09-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sala de Espera</span>
            <h3>Sillones de Espera Modulares para Área Hospitalaria</h3>
          </div>
        </a>
        <a href="/productos-medicos/mesita-noche-hospitalera-cajones-antimicrobiana/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-10/med-10-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesita Hospitalaria</span>
            <h3>Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-07-carro-auxiliar-ruedas-cuidados-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
