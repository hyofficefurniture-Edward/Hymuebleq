---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mesita Noche Hospitalera Cajones Antimicrobiana | Fabricante Médico";
const pageDescription = "Mesita de noche hospitalera con cajones, superficie antimicrobiana y cerradura. Diseñada para habitación hospitalaria. Acero y MDF E1, fabricación a medida, pedido mínimo 30.";
const canonicalUrl = "/productos-medicos/mesita-noche-hospitalera-cajones-antimicrobiana/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana",
    "description": "Mesita de noche hospitalera con cajones, superficie antimicrobiana y cerradura. Diseñada para habitación hospitalaria. Acero y MDF E1, fabricación a m",
    "category": "Mesita Hospitalaria",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿La superficie de Systone resiste líquidos calientes?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el Silestone antimicrobiano soporta temperaturas de hasta 250°C sin deformarse ni decolorarse. Un vaso de café caliente o una tisana no dañan la superficie, que se limpia con un paño tras el derrame."}}, {"@type": "Question", "name": "¿Se puede fabricar con medidas especiales?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, fabricamos a medida según las dimensiones de la habitación y la posición de la cama. Solo necesitamos las medidas de ancho, fondo y alto deseadas. El equipo técnico entrega planos a medida en 4 días hábiles."}}, {"@type": "Question", "name": "¿Los cajones se pueden configurar con divisores?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos divisores modulares de ABS que se ajustan en el interior de los cajones para separar objetos personales, medicamentos o material de higiene. Los divisores se colocan y retiran sin herramientas."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-10/med-10-01.jpg" alt="Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-10/med-10-01.jpg" alt="Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-10/med-10-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-10/med-10-02.jpg" alt="Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-10/med-10-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-10/med-10-03.jpg" alt="Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-10/med-10-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-10/med-10-04.jpg" alt="Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-10/med-10-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Mesita Hospitalaria</span>
        <h1>Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana</h1>
        <p class="producto-intro">La mesita de noche hospitalera está diseñada para el entorno exigente de la habitación hospitalaria. La superficie superior en Silestone antimicrobiano, los cajones con cierre suave y la estructura de MDF E1 con cantos sellados cumplen los protocolos de higiene hospitalaria. Cada mesita se fabrica bajo pedido con opciones de personalización según el nivel asistencial de la habitación.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La superficie superior en Silestone antimicrobiano no poroso resiste más de 10.000 ciclos de limpieza con desinfectantes hospitalarios sin degradación. El material no absorbe líquidos derramados, medicamentos o fluidos biológicos, facilitando la desinfección entre pacientes y reduciendo el riesgo de contaminación cruzada.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los dos cajones con guías telescópicas de cierre suave ofrecen capacidad de 30 kg cada uno. El cajón superior incluye cerradura con llave para objetos de valor del paciente, mientras que el inferior se utiliza para material de higiene personal. Las guías metálicas soportan 50.000 ciclos de apertura sin fallo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los cantos sellados con banda de ABS de 2 mm en color a juego eliminan las juntas visibles donde los patógenos se acumulan en mobiliario convencional. La tecnología de sellado por radiofrecuencia crea una barrera impermeable que impide la penetración de humedad y fluidos en el núcleo del tablero.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Las patas regulables en altura con tornillo de ajuste de 15 mm compensan desniveles del suelo hospitalario. La mesita se nivela perfectamente en cualquier posición de la habitación, y el diseño de la base permite la limpieza por debajo con fregona sin obstáculos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El diseño se personaliza según el nivel de la habitación: mesita estándar para planta general, versión premium con superficie en cristal templado para suites VIP, o configuración con barras de apoyo para geriatría. El equipo técnico entrega planos a medida en 4 días hábiles.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Nivel</th><th>Superficie</th><th>Cajones</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Estándar</td><td>Silestone antimicrobiano</td><td>2 con cerradura</td><td>Planta general</td></tr><tr><td>Premium</td><td>Cristal templado</td><td>3 con cerradura</td><td>Suite VIP</td></tr><tr><td>Geriatría</td><td>Madera + barras</td><td>2 sin cantos vivos</td><td>Residencia mayores</td></tr><tr><td>UCI</td><td>Acero inoxidable</td><td>1 sellado</td><td>Cuidados intensivos</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material</td>
                            <td class="spec-value">MDF E0 con cantos ABS 2 mm sellados por radiofrecuencia</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">Silestone antimicrobiano no poroso (opcional: cristal/acero)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones</td>
                            <td class="spec-value">450 × 400 × 750 mm (configurable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cajones</td>
                            <td class="spec-value">2 con guías telescópicas, cierre suave, 30 kg/cajón</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cerradura</td>
                            <td class="spec-value">Cajón superior con cilindro europeo, 2 llaves</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Patas</td>
                            <td class="spec-value">Regulables ±15 mm, base abierta para limpieza</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, ISO 22196, FSC</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Habitación de hospital general: mesita junto a la cama del paciente para objetos personales, medicamentos y material de higiene, con superficie de fácil desinfección entre ingresos.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Suite hospitalaria VIP: mesita premium con superficie en cristal y tres cajones para habitaciones privadas de alto nivel, con acabados en madera noble que complementan el diseño de la suite.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Residencia geriátrica: mesita con cantos redondeados, barras de apoyo integradas y altura reducida para residentes mayores que necesitan apoyarse al coger objetos de la mesita.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La superficie de Systone resiste líquidos calientes?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el Silestone antimicrobiano soporta temperaturas de hasta 250°C sin deformarse ni decolorarse. Un vaso de café caliente o una tisana no dañan la superficie, que se limpia con un paño tras el derrame.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede fabricar con medidas especiales?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, fabricamos a medida según las dimensiones de la habitación y la posición de la cama. Solo necesitamos las medidas de ancho, fondo y alto deseadas. El equipo técnico entrega planos a medida en 4 días hábiles.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los cajones se pueden configurar con divisores?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos divisores modulares de ABS que se ajustan en el interior de los cajones para separar objetos personales, medicamentos o material de higiene. Los divisores se colocan y retiran sin herramientas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/mesa-cama-hospitalaria-regulable-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-11/med-11-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesa de Cama</span>
            <h3>Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente</h3>
          </div>
        </a>
        <a href="/productos-medicos/biombo-medico-privacidad-hospitalaria-acero/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-12/med-12-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Privacidad Médica</span>
            <h3>Biombo Médico de Privacidad Hospitalaria con Estructura de Acero</h3>
          </div>
        </a>
        <a href="/productos-medicos/mobiliario-sala-consulta-medica-antibacteriano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-01/med-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Consulta Médica</span>
            <h3>Mobiliario para Sala de Consulta Médica Antibacteriano</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-10-mesita-noche-cuidados-paciente-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
