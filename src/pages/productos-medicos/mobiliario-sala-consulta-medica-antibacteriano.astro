---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Sala Consulta Médica Antibacteriano | Fabricante Hospital";
const pageDescription = "Mobiliario para sala de consulta médica con superficies antibacterianas. Escritorio clínico, almacenamiento y sillón para paciente. Fabricación a medida, pedido mínimo 20 unidades.";
const canonicalUrl = "/productos-medicos/mobiliario-sala-consulta-medica-antibacteriano/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario para Sala de Consulta Médica Antibacteriano",
    "description": "Mobiliario para sala de consulta médica con superficies antibacterianas. Escritorio clínico, almacenamiento y sillón para paciente. Fabricación a medi",
    "category": "Consulta Médica",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario para Sala de Consulta Médica Antibacteriano"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las superficies resisten la desinfección con alcohol isopropílico al 70%?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El recubrimiento HPL antibacteriano mantiene su integridad tras más de 10.000 ciclos de limpieza con IPA al 70%, lejía al 10% y desinfectantes hospitalarios estándar. No se produce decoloración ni degradación del material."}}, {"@type": "Question", "name": "¿Se puede adaptar el mobiliario a consultas de menos de 12 m²?", "acceptedAnswer": {"@type": "Answer", "text": "Por supuesto. Ofrecemos configuraciones compactas con escritorio en escueta, almacenamiento mural y sillón abatible. El equipo técnico necesita el plano de la consulta para diseñar la solución óptima en 5 días hábiles."}}, {"@type": "Question", "name": "¿Incluyen el montaje y la instalación en clínica?", "acceptedAnswer": {"@type": "Answer", "text": "Disponemos de dos modalidades: envío de kits premontados con manual (recomendado para menos de 30 unidades) o servicio completo de instalación con técnico desplazado. El montaje profesional de un conjunto de consulta toma 2-3 horas."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario para Sala de Consulta Médica Antibacteriano</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-01/med-01-01.jpg" alt="Mobiliario para Sala de Consulta Médica Antibacteriano para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario para Sala de Consulta Médica Antibacteriano</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-01/med-01-01.jpg" alt="Mobiliario para Sala de Consulta Médica Antibacteriano vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-01/med-01-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-01/med-01-02.jpg" alt="Mobiliario para Sala de Consulta Médica Antibacteriano vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-01/med-01-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-01/med-01-03.jpg" alt="Mobiliario para Sala de Consulta Médica Antibacteriano vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-01/med-01-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-01/med-01-04.jpg" alt="Mobiliario para Sala de Consulta Médica Antibacteriano vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-01/med-01-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Consulta Médica</span>
        <h1>Mobiliario para Sala de Consulta Médica Antibacteriano</h1>
        <p class="producto-intro">El mobiliario para sala de consulta médica combina funcionalidad clínica con un diseño que transmite calma al paciente. Cada pieza se fabrica con materiales de grado médico, superficies no porosas y cantos sellados que facilitan la desinfección. El escritorio del médico, el almacenamiento instrumental y el sillón de exploración forman un conjunto coherente que optimiza el flujo de trabajo durante la consulta diaria.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El escritorio clínico incorpora un tablero de 25 mm con recubrimiento HPL antibacteriano que soporta más de 10.000 ciclos de limpieza con productos hospitalarios sin perder integridad. La superficie mate antirreflectante facilita la lectura de monitores y reduce la fatiga visual del médico durante jornadas de 8 horas o más.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El sistema de gestión de cables integrado en el escritorio permite conectar doble monitor, ordenador clínico y dispositivos de diagnóstico sin cableado visible. Las tomas Schuko y puertos USB quedan embebidos en el tablero, cumpliendo la normativa de seguridad eléctrica en entornos sanitarios y evitando enredos que dificulten la limpieza.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El almacenamiento instrumental utiliza cajones con guías telescópicas de cierre suave y capacidad de 40 kg cada uno. Las cerraduras centralizadas con cilindro europeo permiten gestionar todo el módulo con una sola llave, mientras que los separadores interiores modulares se ajustan según el tipo de instrumental o material estéril almacenado.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El sillón de paciente cuenta con espuma de alta densidad ignífuga (norma CAL117), tapizado en vinilo médico soldado por radiofrecuencia sin costuras visibles. El respaldo ergonómico reduce la presión lumbar durante esperas prolongadas, y la altura del asiento facilita la transferencia de pacientes con movilidad reducida.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>Cada proyecto de consulta se personaliza según la especialidad médica: configuración en L para cardiología, isla central para medicina general o layout lineal para dermatología. El departamento técnico entrega planos CAD a medida en 5 días hábiles y fabrica prototipos para validación antes de la producción en serie.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Superficie</th><th>Higiene</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Lineal estándar</td><td>HPL antibacteriano</td><td>99.9% reducción bacteriana</td><td>Medicina general y familiar</td></tr><tr><td>Configuración en L</td><td>Laminado fenólico</td><td>Resistente a IPA 70%</td><td>Cardiología y diagnóstico</td></tr><tr><td>Isla central</td><td>Acero inoxidable</td><td>Resistente a lejía 10%</td><td>Consultas multidisciplinarias</td></tr><tr><td>A medida</td><td>Chapa antimicrobiana</td><td>ISO 22196 certificado</td><td>Clínicas privadas premium</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Tablero MDF E0 con recubrimiento HPL antibacteriano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones escritorio</td>
                            <td class="spec-value">Largo 1600 mm × Fondo 800 mm × Alto 750 mm (configurable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">HPL mate antirreflectante, resistente a desinfectantes hospitalarios</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Almacenamiento</td>
                            <td class="spec-value">Módulo de 3 cajones con guías telescópicas, carga 40 kg/cajón</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cerraduras</td>
                            <td class="spec-value">Centralizada con cilindro europeo de doble paletón</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Gestión de cables</td>
                            <td class="spec-value">Canal integrado, 2 tomas Schuko + 2 USB, tapa desenfundable</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, ISO 22196 (antibacteriano), CAL117 (ignífugo)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables según volumen</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Consulta de atención primaria: conjunto médico-paciente con escritorio para historia clínica electrónica, almacenamiento instrumental y sillón de exploración con acceso para silla de ruedas.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Consulta de especialista: configuración con monitores duales para diagnóstico por imagen, módulo de almacenamiento para instrumental específico y superficie ampliada para pruebas complementarias.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Hospital de día: mobiliario de alta resistencia para uso continuo en sesiones de mañana y tarde, con superficies de rápida desinfección entre pacientes y almacenamiento seguro de material estéril.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las superficies resisten la desinfección con alcohol isopropílico al 70%?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El recubrimiento HPL antibacteriano mantiene su integridad tras más de 10.000 ciclos de limpieza con IPA al 70%, lejía al 10% y desinfectantes hospitalarios estándar. No se produce decoloración ni degradación del material.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede adaptar el mobiliario a consultas de menos de 12 m²?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Por supuesto. Ofrecemos configuraciones compactas con escritorio en escueta, almacenamiento mural y sillón abatible. El equipo técnico necesita el plano de la consulta para diseñar la solución óptima en 5 días hábiles.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Incluyen el montaje y la instalación en clínica?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Disponemos de dos modalidades: envío de kits premontados con manual (recomendado para menos de 30 unidades) o servicio completo de instalación con técnico desplazado. El montaje profesional de un conjunto de consulta toma 2-3 horas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/mobiliario-sala-exploracion-clinica-modular/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-02/med-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sala de Exploración</span>
            <h3>Mobiliario para Sala de Exploración Clínica Modular</h3>
          </div>
        </a>
        <a href="/productos-medicos/equipamiento-habitacion-hospitalaria-curacion/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-03/med-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Habitación Hospitalaria</span>
            <h3>Equipamiento Integral de Habitación Hospitalaria de Curación</h3>
          </div>
        </a>
        <a href="/productos-medicos/mostrador-recepcion-hospitalaria-antimicrobiano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-04/med-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Recepción Hospitalaria</span>
            <h3>Mostrador de Recepción Hospitalaria Antimicrobiano Modular</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-01-conjunto-mobiliario-consultorio-medico.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
