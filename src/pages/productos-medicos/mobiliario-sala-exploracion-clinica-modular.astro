---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Sala Exploración Clínica Modular | Fabricante Sanitario";
const pageDescription = "Mobiliario modular para sala de exploración clínica. Camilla ajustable, cabinetería mural y estación de trabajo clínico. Materiales de grado médico, fabricación a medida.";
const canonicalUrl = "/productos-medicos/mobiliario-sala-exploracion-clinica-modular/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario para Sala de Exploración Clínica Modular",
    "description": "Mobiliario modular para sala de exploración clínica. Camilla ajustable, cabinetería mural y estación de trabajo clínico. Materiales de grado médico, f",
    "category": "Sala de Exploración",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario para Sala de Exploración Clínica Modular"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿La camilla de exploración incluye colchón?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, la camilla incluye colchón de espuma de alta densidad de 5 cm con funda de vinilo médico desmontable y lavable. El colchón está disponible en diferentes densidades según las necesidades de la especialidad médica."}}, {"@type": "Question", "name": "¿Se puede instalar la cabinetería mural en paredes con instalaciones empotradas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El equipo técnico realiza un levantamiento de las instalaciones de la pared (tomas eléctricas, oxígeno, vacío) y diseña la cabinetería con los pasos necesarios. La instalación incluye anclaje químico para soportar la carga completa de material almacenado."}}, {"@type": "Question", "name": "¿Cuál es el plazo para un proyecto completo de 20 salas de exploración?", "acceptedAnswer": {"@type": "Answer", "text": "El plazo estándar es de 35-45 días laborables desde la confirmación del proyecto y validación de planos. Para volúmenes superiores a 30 salas, se programa la producción por fases para asegurar la calidad de cada lote."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario para Sala de Exploración Clínica Modular</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-02/med-02-01.jpg" alt="Mobiliario para Sala de Exploración Clínica Modular para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario para Sala de Exploración Clínica Modular</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-02/med-02-01.jpg" alt="Mobiliario para Sala de Exploración Clínica Modular vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-02/med-02-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-02/med-02-02.jpg" alt="Mobiliario para Sala de Exploración Clínica Modular vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-02/med-02-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-02/med-02-03.jpg" alt="Mobiliario para Sala de Exploración Clínica Modular vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-02/med-02-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-02/med-02-04.jpg" alt="Mobiliario para Sala de Exploración Clínica Modular vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-02/med-02-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Sala de Exploración</span>
        <h1>Mobiliario para Sala de Exploración Clínica Modular</h1>
        <p class="producto-intro">El mobiliario para sala de exploración clínica modular está diseñado para optimizar el flujo entre el médico, el paciente y el equipo de diagnóstico. La camilla de exploración, la cabinetería mural y la estación de trabajo forman un triángulo funcional que reduce los desplazamientos del personal sanitario. Cada módulo se fabrica con materiales de grado médico y superficies no porosas que garantizan el control de infecciones.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La camilla de exploración soporta hasta 225 kg con estructura de acero reforzado y superficie de contacto antimicrobiana. El ajuste de altura electromecánico de 45 a 90 cm permite al médico trabajar en posición ergonómica, reduciendo la carga lumbar en un 35% durante exploraciones prolongadas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La cabinetería mural aprovecha la pared completa con módulos de almacenamiento verticales que liberan el suelo para la circulación de camillas y sillas de ruedas. Los frentes de cajones utilizan tiradores empotrados con sistema de cierre suave, evitando salientes que puedan causar lesiones al personal o pacientes en espacios reducidos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La estación de trabajo clínico integra un monitor de pared con brazo articulado que soporta pantallas de hasta 10 kg, permitiendo consultar la historia clínica electrónica sin interrumpir el contacto visual con el paciente. El teclado y el ratón se alojan en un cajón extraíble con cerradura.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los materiales cumplen la norma ISO 22196 de actividad antibacteriana, con superficies que mantienen una reducción del 99,9% de bacterias tras 24 horas. Los cantos están sellados con tecnología thermofoil sin juntas visibles, eliminando los puntos donde los patógenos suelen acumularse en mobiliario convencional.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El sistema modular permite reconfigurar la sala en menos de 2 horas sin obra civil. Los módulos estándar se intercambian entre consultas, lo que reduce los costes de renovación a largo plazo en un 30% frente al mobiliario fijo tradicional.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Camilla</th><th>Almacenamiento</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Básica lineal</td><td>Manual 225 kg</td><td>Mural 6 cajones</td><td>Medicina general</td></tr><tr><td>Ergonómica premium</td><td>Eléctrica 250 kg</td><td>Mural + isla</td><td>Especialidades</td></tr><tr><td>Compacta esquina</td><td>Hidráulica 200 kg</td><td>Mural vertical</td><td>Consultas pequeñas</td></tr><tr><td>A medida</td><td>Configurable</td><td>Bajo plano CAD</td><td>Proyectos hospitalarios</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">MDF E0 con laminado fenólico antimicrobiano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Camilla exploración</td>
                            <td class="spec-value">Carga 225 kg, ajuste altura 45-90 cm, superficie antimicrobiana</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cabinetería</td>
                            <td class="spec-value">Mural con 6-8 cajones, guías telescópicas, cierre suave</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estación trabajo</td>
                            <td class="spec-value">Brazo monitor 10 kg, cajón teclado con cerradura</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficies</td>
                            <td class="spec-value">Thermofoil sin juntas, ISO 22196 antibacteriano</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, ISO 22196, LEED V4 Healthcare</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">15 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables según configuración</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Consulta de medicina general: sala de exploración con camilla manual, cabinetería mural para material de curas y estación de trabajo para historia clínica electrónica.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Consulta de especialista: configuración con camilla eléctrica de altura regulable, módulo de diagnóstico integrado y almacenamiento específico para instrumental de la especialidad.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Urgencias de baja complejidad: mobiliario de alta resistencia para uso continuo, con superficies de desinfección rápida entre pacientes y almacenamiento de acceso inmediato para material de emergencia.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La camilla de exploración incluye colchón?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, la camilla incluye colchón de espuma de alta densidad de 5 cm con funda de vinilo médico desmontable y lavable. El colchón está disponible en diferentes densidades según las necesidades de la especialidad médica.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede instalar la cabinetería mural en paredes con instalaciones empotradas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. El equipo técnico realiza un levantamiento de las instalaciones de la pared (tomas eléctricas, oxígeno, vacío) y diseña la cabinetería con los pasos necesarios. La instalación incluye anclaje químico para soportar la carga completa de material almacenado.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Cuál es el plazo para un proyecto completo de 20 salas de exploración?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El plazo estándar es de 35-45 días laborables desde la confirmación del proyecto y validación de planos. Para volúmenes superiores a 30 salas, se programa la producción por fases para asegurar la calidad de cada lote.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/equipamiento-habitacion-hospitalaria-curacion/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-03/med-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Habitación Hospitalaria</span>
            <h3>Equipamiento Integral de Habitación Hospitalaria de Curación</h3>
          </div>
        </a>
        <a href="/productos-medicos/mostrador-recepcion-hospitalaria-antimicrobiano/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-04/med-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Recepción Hospitalaria</span>
            <h3>Mostrador de Recepción Hospitalaria Antimicrobiano Modular</h3>
          </div>
        </a>
        <a href="/productos-medicos/cama-hospitalaria-electrica-cinco-posiciones/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-05/med-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Cama Hospitalaria</span>
            <h3>Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-02-set-mobiliario-sala-reconocimiento-medico.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
