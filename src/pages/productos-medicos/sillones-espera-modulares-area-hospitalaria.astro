---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Sillones Espera Modulares Área Hospitalaria | Fabricante Médico";
const pageDescription = "Sillones de espera modulares para área hospitalaria. Estructura de acero, tapizado antimicrobiano, configuración de 2 a 5 plazas. Soporta 250 kg/plaza. Para hospital y clínica.";
const canonicalUrl = "/productos-medicos/sillones-espera-modulares-area-hospitalaria/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Sillones de Espera Modulares para Área Hospitalaria",
    "description": "Sillones de espera modulares para área hospitalaria. Estructura de acero, tapizado antimicrobiano, configuración de 2 a 5 plazas. Soporta 250 kg/plaza",
    "category": "Sala de Espera",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Sillones de Espera Modulares para Área Hospitalaria"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Los bancos se pueden fijar al suelo?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos kit de anclaje al suelo con tornillería de acero inoxidable y tacos químicos. Recomendamos el anclaje en salas de espera de alto tránsito para evitar desplazamientos accidentales y garantizar la estabilidad con pacientes de movilidad reducida."}}, {"@type": "Question", "name": "¿El tapizado está disponible en diferentes colores?", "acceptedAnswer": {"@type": "Answer", "text": "Ofrecemos más de 20 colores de vinilo médico ignífugo: tonos neutros (gris, beige, negro), cálidos (terracota, mostaza) y fríos (azul, verde). El departamento de diseño asesora en la elección cromática para crear un ambiente que reduzca la ansiedad del paciente."}}, {"@type": "Question", "name": "¿Se puede sustituir el tapizado de una plaza dañada?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, cada plaza se retapiza individualmente sin necesidad de desmontar el banco completo. Ofrecemos servicio de retapizado postventa con plazo de 5-7 días laborables, ideal para mantener la estética de la sala de espera tras daños por uso intensivo."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Sillones de Espera Modulares para Área Hospitalaria</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-09/med-09-01.jpg" alt="Sillones de Espera Modulares para Área Hospitalaria para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Sillones de Espera Modulares para Área Hospitalaria</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-09/med-09-01.jpg" alt="Sillones de Espera Modulares para Área Hospitalaria vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-09/med-09-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-09/med-09-02.jpg" alt="Sillones de Espera Modulares para Área Hospitalaria vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-09/med-09-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-09/med-09-03.jpg" alt="Sillones de Espera Modulares para Área Hospitalaria vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-09/med-09-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-09/med-09-04.jpg" alt="Sillones de Espera Modulares para Área Hospitalaria vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-09/med-09-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Sala de Espera</span>
        <h1>Sillones de Espera Modulares para Área Hospitalaria</h1>
        <p class="producto-intro">Los sillones de espera modulares para área hospitalaria están diseñados para el alto tránsito de salas de espera de centros sanitarios. La estructura de acero de 1,5 mm, el tapizado antimicrobiano y la configuración modular de 2 a 5 plazas permiten adaptar el mobiliario a cualquier tamaño de sala. Cada plaza soporta 250 kg de carga estática y pasa un test de fatiga de 200.000 ciclos.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero laminado en frío de 1,5 mm de espesor soporta 250 kg de carga estática por plaza. El test de fatiga de 200.000 ciclos simula 10 años de uso intensivo en sala de espera hospitalaria con 200 visitas diarias, garantizando la integridad estructural sin deformación.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El tapizado en vinilo médico con tratamiento antimicrobiano reduce la carga bacteriana en un 99,9% y resiste la desinfección con productos hospitalarios estándar. Las superficies no porosas se limpian en segundos entre pacientes, y el vinilo ignífugo cumple la norma CAL117/BS5852 para seguridad ante incendio en espacios públicos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El diseño ergonómico del respaldo contorneado reduce la presión lumbar en un 15% comparado con asientos de respaldo plano. La inclinación de 5 grados del asiento mantiene una postura relajada durante esperas de 30-60 minutos, reduciendo la ansiedad del paciente en la sala de espera.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La configuración modular permite crear bancos de 2 a 5 plazas con un mismo módulo base. Los pies de acero con protectores de guma anti-deslizante se anclan al suelo mediante kit opcional, y la separación entre plazas respeta el espacio personal mínimo de 600 mm por usuario.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El sistema de montaje entre módulos utiliza tornillería de acero inoxidable con unión por espiga metálica, permitiendo reconfigurar la disposición de la sala en menos de 30 minutos sin herramientas especiales. Los módulos dañados se reemplazan individualmente sin necesidad de cambiar el banco completo.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Plazas</th><th>Material</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Banco 2 plazas</td><td>2 × 250 kg</td><td>Acero + vinilo antimicrobiano</td><td>Consultas pequeñas</td></tr><tr><td>Banco 3 plazas</td><td>3 × 250 kg</td><td>Acero + vinilo ignífugo</td><td>Hospital general</td></tr><tr><td>Banco 4-5 plazas</td><td>4-5 × 250 kg</td><td>Acero + tela tratada</td><td>Sala espera grande</td></tr><tr><td>A medida</td><td>Configurable</td><td>Configurable</td><td>Proyectos institucionales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Acero laminado en frío 1,5 mm, pintura epoxi</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tapizado</td>
                            <td class="spec-value">Vinilo médico antimicrobiano ignífugo CAL117/BS5852</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Configuración</td>
                            <td class="spec-value">Modular de 2 a 5 plazas (separación 600 mm/plaza)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga por plaza</td>
                            <td class="spec-value">250 kg estática</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Test fatiga</td>
                            <td class="spec-value">200.000 ciclos (equivalente 10 años uso)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Dimensiones plaza</td>
                            <td class="spec-value">600 × 650 × 800 mm (ancho × fondo × alto)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pies</td>
                            <td class="spec-value">Acero con protector de goma, anclaje al suelo opcional</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, ISO 13485, CE, SGS, CAL117</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 plazas (equivalente a 5-10 bancos)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Sala de espera de hospital: bancos modulares de 3-4 plazas distribuidos para maximizar la capacidad de la sala, con pasillos de circulación de 120 cm para sillas de ruedas y camillas.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de espera de consulta privada: bancos de 2 plazas con separación amplia entre usuarios, tapizado en tonos cálidos que reducen la sensación de frío clínico.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Pasillo de urgencias: sillones individuales de perfil estrecho para pacientes en espera de pruebas, con protectores de goma en los pies para no dañar las paredes del pasillo.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los bancos se pueden fijar al suelo?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos kit de anclaje al suelo con tornillería de acero inoxidable y tacos químicos. Recomendamos el anclaje en salas de espera de alto tránsito para evitar desplazamientos accidentales y garantizar la estabilidad con pacientes de movilidad reducida.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El tapizado está disponible en diferentes colores?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Ofrecemos más de 20 colores de vinilo médico ignífugo: tonos neutros (gris, beige, negro), cálidos (terracota, mostaza) y fríos (azul, verde). El departamento de diseño asesora en la elección cromática para crear un ambiente que reduzca la ansiedad del paciente.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede sustituir el tapizado de una plaza dañada?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, cada plaza se retapiza individualmente sin necesidad de desmontar el banco completo. Ofrecemos servicio de retapizado postventa con plazo de 5-7 días laborables, ideal para mantener la estética de la sala de espera tras daños por uso intensivo.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/mesita-noche-hospitalera-cajones-antimicrobiana/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-10/med-10-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesita Hospitalaria</span>
            <h3>Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana</h3>
          </div>
        </a>
        <a href="/productos-medicos/mesa-cama-hospitalaria-regulable-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-11/med-11-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesa de Cama</span>
            <h3>Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente</h3>
          </div>
        </a>
        <a href="/productos-medicos/biombo-medico-privacidad-hospitalaria-acero/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-12/med-12-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Privacidad Médica</span>
            <h3>Biombo Médico de Privacidad Hospitalaria con Estructura de Acero</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-09-banco-espera-dos-plazas-consultorio.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
