---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Conjunto Mesa Silla Comedor Residencia Geriátrica | Fabricante";
const pageDescription = "Conjunto de mesa y silla para comedor de residencia geriátrica. Diseño accesible para silla de ruedas, superficies antimicrobianas, estructura reforzada. Pedido mínimo 30 conjuntos.";
const canonicalUrl = "/productos-medicos/conjunto-mesa-silla-comedor-residencia-geriatrica/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica",
    "description": "Conjunto de mesa y silla para comedor de residencia geriátrica. Diseño accesible para silla de ruedas, superficies antimicrobianas, estructura reforza",
    "category": "Comedor Geriátrico",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las sillas se pueden fijar al suelo para mayor estabilidad?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos kit de anclaje al suelo para sillas en comedores comunitarios donde se requiere máxima estabilidad. También disponemos de sillas con base lastrada de 15 kg que proporcionan estabilidad sin necesidad de anclaje."}}, {"@type": "Question", "name": "¿Se pueden personalizar los colores del tapizado?", "acceptedAnswer": {"@type": "Answer", "text": "Ofrecemos más de 30 colores de vinilo médico ignífugo, desde tonos neutros hasta colores cálidos que estimulan el apetito (terracota, mostaza, verde oliva). El departamento de diseño asesora en la elección cromática según el perfil de los residentes."}}, {"@type": "Question", "name": "¿Las mesas resisten derrames de líquidos calientes?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el laminado HPL antimicrobiano resiste temperaturas de hasta 180°C sin deformarse ni decolorarse. Los derrames de sopas, café o infusiones se limpian con un paño sin dejar marca, y los cantos sellados impiden la penetración de líquidos en el núcleo del tablero."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-08/med-08-01.jpg" alt="Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-08/med-08-01.jpg" alt="Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-08/med-08-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-08/med-08-02.jpg" alt="Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-08/med-08-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-08/med-08-03.jpg" alt="Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-08/med-08-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-08/med-08-04.jpg" alt="Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-08/med-08-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Comedor Geriátrico</span>
        <h1>Conjunto de Mesa y Silla para Comedor de Residencia Geriátrica</h1>
        <p class="producto-intro">El conjunto de mesa y silla para comedor de residencia geriátrica está diseñado para crear un espacio de comedor seguro, accesible y acogedor para los residentes. La mesa con altura de paso libre para silla de ruedas, las sillas con reposabrazos de apoyo y las superficies antimicrobianas de fácil limpieza responden a las necesidades específicas de los centros de mayores.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La mesa se fabrica con tablero de MDF E0 con superficie de laminado HPL antimicrobiano que soporta más de 12.000 ciclos de limpieza con desinfectantes hospitalarios. El borde de seguridad con radio de 3 mm y cantos sellados sin juntas previene lesiones en residentes con piel frágil, un factor crítico en geriatría.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El hueco de paso bajo la mesa es de 750 mm de altura, permitiendo el acceso cómodo de sillas de ruedas estándar y motorizadas. Las patas de la mesa están retraídas hacia el interior para maximizar el espacio de las piernas, y la estructura de acero reforzado soporta hasta 200 kg sobre la superficie sin tambalearse.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las sillas incorporan reposabrazos de madera maciza que soportan 150 kg de carga vertical, facilitando la incorporación del residente sin asistencia. El asiento a 46 cm de altura con espuma de alta densidad de 5 cm y respaldo ligeramente reclinado reducen la presión sobre la columna de los residentes durante comidas de 45-60 minutos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El tapizado en vinilo médico ignífugo (CAL117/BS5852) se suelda por radiofrecuencia sin costuras visibles, eliminando los puntos de acumulación bacteriana. El vinilo resiste manchas de alimentos y bebidas, y se limpia con desinfectante doméstico sin decolorarse tras miles de ciclos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El conjunto se personaliza según el proyecto: mesas redondas para 4-6 comensales, rectangulares para 8, o individuales para servicio en habitación. El departamento técnico diseña la distribución del comedor optimizando el espacio por residente (mínimo 2,5 m² según normativa) y los circuitos de servicio de comida.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Mesa</th><th>Silla</th><th>Capacidad</th></tr>
            </thead>
            <tbody>
              <tr><td>Individual</td><td>Redonda Ø80 cm</td><td>Con reposabrazos</td><td>1 residente</td></tr><tr><td>Pareja</td><td>Rectangular 120 cm</td><td>Con reposabrazos</td><td>2 residentes</td></tr><tr><td>Grupo</td><td>Redonda Ø150 cm</td><td>Reforzada bariátrica</td><td>4-6 residentes</td></tr><tr><td>A medida</td><td>Según plano</td><td>Configurable</td><td>Proyecto completo</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material mesa</td>
                            <td class="spec-value">MDF E0 con laminado HPL antimicrobiano, canto ABS radio 3 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Medidas mesa</td>
                            <td class="spec-value">Redonda Ø80-150 cm o rectangular 120-240 × 80 cm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Altura mesa</td>
                            <td class="spec-value">750 mm (paso libre para silla de ruedas)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura mesa</td>
                            <td class="spec-value">Acero reforzado, soporta 200 kg sobre superficie</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Silla</td>
                            <td class="spec-value">Madera maciza + espuma 5 cm + vinilo ignífugo CAL117</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Altura asiento</td>
                            <td class="spec-value">460 mm con reposabrazos a 660 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga silla</td>
                            <td class="spec-value">150 kg estática (versión bariátrica: 250 kg)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">BIFMA, SGS, CAL117, BS5852, ISO 9001, FSC</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 conjuntos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Comedor de residencia de mayores: conjunto de mesas redondas para 4-6 residentes con sillas de reposabrazos, distribuidas para permitir el acceso de sillas de ruedas y el tránsito del personal de atención.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de estar de centro de día: mesas individuales para actividades y comidas, con sillas ligeras pero estables que el residente puede desplazar manualmente sin riesgo de vuelco.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Comedor de unidad de memoria: conjunto con acabados no reflectantes y colores contrastados para facilitar la orientación visual de residentes con deterioro cognitivo, reduciendo la confusión durante las comidas.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las sillas se pueden fijar al suelo para mayor estabilidad?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos kit de anclaje al suelo para sillas en comedores comunitarios donde se requiere máxima estabilidad. También disponemos de sillas con base lastrada de 15 kg que proporcionan estabilidad sin necesidad de anclaje.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden personalizar los colores del tapizado?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Ofrecemos más de 30 colores de vinilo médico ignífugo, desde tonos neutros hasta colores cálidos que estimulan el apetito (terracota, mostaza, verde oliva). El departamento de diseño asesora en la elección cromática según el perfil de los residentes.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las mesas resisten derrames de líquidos calientes?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el laminado HPL antimicrobiano resiste temperaturas de hasta 180°C sin deformarse ni decolorarse. Los derrames de sopas, café o infusiones se limpian con un paño sin dejar marca, y los cantos sellados impiden la penetración de líquidos en el núcleo del tablero.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/sillones-espera-modulares-area-hospitalaria/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-09/med-09-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Sala de Espera</span>
            <h3>Sillones de Espera Modulares para Área Hospitalaria</h3>
          </div>
        </a>
        <a href="/productos-medicos/mesita-noche-hospitalera-cajones-antimicrobiana/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-10/med-10-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesita Hospitalaria</span>
            <h3>Mesita de Noche Hospitalera con Cajones y Superficie Antimicrobiana</h3>
          </div>
        </a>
        <a href="/productos-medicos/mesa-cama-hospitalaria-regulable-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-11/med-11-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mesa de Cama</span>
            <h3>Mesa de Cama Hospitalaria Regulable con Ruedas para Paciente</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-08-juego-mesa-silla-comedor-mayores.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
