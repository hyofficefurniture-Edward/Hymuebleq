---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mostrador Recepción Hospitalaria Antimicrobiano | Fabricante Médico";
const pageDescription = "Mostrador de recepción hospitalaria con superficies antimicrobianas de plata iónica. Diseño modular de doble nivel, gestión de cables integrada. Fabricación a medida para hospitales.";
const canonicalUrl = "/productos-medicos/mostrador-recepcion-hospitalaria-antimicrobiano/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mostrador de Recepción Hospitalaria Antimicrobiano Modular",
    "description": "Mostrador de recepción hospitalaria con superficies antimicrobianas de plata iónica. Diseño modular de doble nivel, gestión de cables integrada. Fabri",
    "category": "Recepción Hospitalaria",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Médico", "item": "https://hymueble.com/productos-medicos/"},
      {"@type": "ListItem", "position": 3, "name": "Mostrador de Recepción Hospitalaria Antimicrobiano Modular"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿El mostrador se puede instalar en curva o en ángulo?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Fabricamos módulos en ángulo de 45°, 90° y curvas de radio personalizado. El equipo técnico diseña la configuración según el plano de la planta para aprovechar al máximo el espacio disponible en el área de recepción."}}, {"@type": "Question", "name": "¿Las superficies resisten la desinfección con lejía?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el recubrimiento HPL con plata iónica mantiene su integridad y color tras la exposición continuada a lejía al 10%, alcohol isopropílico al 70% y desinfectantes hospitalarios estándar. No se produce decoloración ni degradación."}}, {"@type": "Question", "name": "¿Incluyen las tomas eléctricas y de red?", "acceptedAnswer": {"@type": "Answer", "text": "El mostrador se entrega con las canalizaciones preparadas para la instalación eléctrica. Las tomas Schuko, los puertos de red RJ45 y los pasos para tubing neumático se instalan según las especificaciones del hospital, coordinados con el instalador de obra."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-medicos/">Mobiliario Médico</a>
        <span aria-hidden="true">›</span>
        <span>Mostrador de Recepción Hospitalaria Antimicrobiano Modular</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-medicos/med-04/med-04-01.jpg" alt="Mostrador de Recepción Hospitalaria Antimicrobiano Modular para hospital y proyectos medicos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mostrador de Recepción Hospitalaria Antimicrobiano Modular</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-medicos/med-04/med-04-01.jpg" alt="Mostrador de Recepción Hospitalaria Antimicrobiano Modular vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-04/med-04-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-04/med-04-02.jpg" alt="Mostrador de Recepción Hospitalaria Antimicrobiano Modular vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-04/med-04-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-04/med-04-03.jpg" alt="Mostrador de Recepción Hospitalaria Antimicrobiano Modular vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-04/med-04-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-medicos/med-04/med-04-04.jpg" alt="Mostrador de Recepción Hospitalaria Antimicrobiano Modular vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-medicos/med-04/med-04-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Recepción Hospitalaria</span>
        <h1>Mostrador de Recepción Hospitalaria Antimicrobiano Modular</h1>
        <p class="producto-intro">El mostrador de recepción hospitalaria antimicrobiano está diseñado para los entornos de mayor tránsito de un centro sanitario. La superficie de doble nivel permite la atención de pie y sentada, mientras que el recubrimiento con tecnología de plata iónica reduce la carga bacteriana en un 99,9%. El sistema modular se adapta a la planta del hospital y se reconfigura según las necesidades del servicio.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La superficie del mostrador utiliza laminado de alta presión (HPL) con tratamiento de plata iónica que reduce el crecimiento bacteriano en un 99,9% en 24 horas. El material mantiene su eficacia tras más de 50.000 ciclos de limpieza con desinfectantes hospitalarios, incluyendo lejía al 10% y alcohol isopropílico al 70%.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>El diseño de doble nivel ofrece una zona de trabajo sentada a 750 mm para tareas administrativas y una zona de atención de pie a 1100 mm para la interacción con el paciente. Esta configuración ergonómica aumenta el rendimiento del personal de recepción en un 15-20% durante jornadas de 8 horas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El sistema de gestión de cables incluye canales profundos embebidos en la estructura del mostrador, con tapas de acceso para mantenimiento. Las tomas eléctricas, conexiones de red y pasos para tubing neumático quedan ocultos, manteniendo la imagen profesional del área de recepción.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero reforzado de 1,5 mm de espesor soporta cargas de hasta 150 kg sobre la superficie de trabajo, incluyendo monitores médicos dobles y equipos de registro. Los cajones y puertas pasan un test de 50.000 ciclos de apertura, garantizando una vida útil superior a 10 años en uso continuo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El mostrador se fabrica en longitudes estándar de 2400, 3600 y 4800 mm, ampliables mediante módulos adicionales. El departamento técnico adapta la configuración al plano de la planta, incluyendo secciones con altura reducida para cumplir la normativa de accesibilidad ADA.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Longitud</th><th>Superficie</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Lineal básico</td><td>2400 mm</td><td>HPL antimicrobiano</td><td>Clínicas pequeñas</td></tr><tr><td>Doble nivel</td><td>3600 mm</td><td>HPL + plata iónica</td><td>Hospital general</td></tr><tr><td>Isla central</td><td>4800 mm</td><td>Sólido + acero</td><td>Lobby hospitalario</td></tr><tr><td>A medida</td><td>Según plano</td><td>Configurable</td><td>Proyectos institucionales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material estructura</td>
                            <td class="spec-value">Acero reforzado 1,5 mm + MDF E1</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">HPL con tecnología de plata iónica, ISO 22196</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Niveles</td>
                            <td class="spec-value">Doble: 750 mm (sentado) + 1100 mm (de pie)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Longitudes</td>
                            <td class="spec-value">2400 / 3600 / 4800 mm (modular, ampliable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cajones</td>
                            <td class="spec-value">Guías telescópicas, 50.000 ciclos, carga 40 kg</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Gestión cables</td>
                            <td class="spec-value">Canal profundo con tapas de acceso, tomas integradas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, CE, ISO 22196, ADA accesibilidad</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">5 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos hospitalarios</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Recepción de urgencias hospitalarias: mostrador de isla central con gestión de cables para monitores de seguimiento de pacientes y acceso a historial clínico desde múltiples puntos.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Estación de enfermería de planta: mostrador lineal con doble nivel para atención administrativa y control visual de pasillo, integrado con sistema de llamadas de paciente.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Recepción de clínica ambulatoria: mostrador compacto con sección ADA a altura reducida para acceso de sillas de ruedas, gestión de citas y admisión de pacientes.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El mostrador se puede instalar en curva o en ángulo?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Fabricamos módulos en ángulo de 45°, 90° y curvas de radio personalizado. El equipo técnico diseña la configuración según el plano de la planta para aprovechar al máximo el espacio disponible en el área de recepción.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las superficies resisten la desinfección con lejía?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el recubrimiento HPL con plata iónica mantiene su integridad y color tras la exposición continuada a lejía al 10%, alcohol isopropílico al 70% y desinfectantes hospitalarios estándar. No se produce decoloración ni degradación.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Incluyen las tomas eléctricas y de red?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El mostrador se entrega con las canalizaciones preparadas para la instalación eléctrica. Las tomas Schuko, los puertos de red RJ45 y los pasos para tubing neumático se instalan según las especificaciones del hospital, coordinados con el instalador de obra.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-medicos/cama-hospitalaria-electrica-cinco-posiciones/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-05/med-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Cama Hospitalaria</span>
            <h3>Cama Hospitalaria Eléctrica de Cinco Posiciones para Paciente</h3>
          </div>
        </a>
        <a href="/productos-medicos/sistema-almacenamiento-medico-estanteria-antimicrobiana/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-06/med-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Almacenamiento Médico</span>
            <h3>Sistema de Almacenamiento Médico con Estantería Antimicrobiana</h3>
          </div>
        </a>
        <a href="/productos-medicos/carro-medico-movil-cajones-seguridad/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-medicos/med-07/med-07-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Carros Médicos</span>
            <h3>Carro Médico Móvil con Cajones de Seguridad para Hospital</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-medicos/med-04-mostrador-recepcion-clinica-privada.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
