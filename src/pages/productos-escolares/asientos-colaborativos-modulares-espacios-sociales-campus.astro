---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Asientos Modulares para Campus y Aulas | Fabricante";
const pageDescription = "Asientos colaborativos modulares para espacios sociales del campus y zonas de aprendizaje. Espuma de alta resiliencia, tejido de grado comercial y puertos USB integrados.";
const canonicalUrl = "/productos-escolares/asientos-colaborativos-modulares-espacios-sociales-campus/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Asientos Colaborativos Modulares para Espacios Sociales del Campus",
    "description": "Asientos colaborativos modulares para espacios sociales del campus y zonas de aprendizaje. Espuma de alta resiliencia, tejido de grado comercial y pue",
    "category": "Asientos Escolares",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Asientos Colaborativos Modulares para Espacios Sociales del Campus"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las fundas se pueden cambiar de color más adelante?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, las fundas de los asientos son desmontables y se pueden sustituir por fundas de otro color o tejido. Esta opción permite renovar la imagen de las zonas comunes sin comprar mobiliario nuevo."}}, {"@type": "Question", "name": "¿Los puertos USB necesitan instalación eléctrica previa?", "acceptedAnswer": {"@type": "Answer", "text": "Los módulos con carga USB requieren una toma de corriente cercana para la conexión de la fuente de alimentación. La instalación la realiza un electricista y el cableado queda oculto en la estructura del asiento."}}, {"@type": "Question", "name": "¿Qué mantenimiento requiere el tejido en zonas de uso intensivo?", "acceptedAnswer": {"@type": "Answer", "text": "Se recomienda aspirar el tejido una vez por semana y realizar una limpieza en seco cada trimestre. Las fundas desmontables se lavan en tintorería o a máquina según el tejido elegido, lo que prolonga la vida útil del asiento."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Asientos Colaborativos Modulares para Espacios Sociales del Campus</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-03/esc-03-01.jpg" alt="Asientos Colaborativos Modulares para Espacios Sociales del Campus para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Asientos Colaborativos Modulares para Espacios Sociales del Campus</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-03/esc-03-01.jpg" alt="Asientos Colaborativos Modulares para Espacios Sociales del Campus vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-03/esc-03-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-03/esc-03-02.jpg" alt="Asientos Colaborativos Modulares para Espacios Sociales del Campus vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-03/esc-03-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-03/esc-03-03.jpg" alt="Asientos Colaborativos Modulares para Espacios Sociales del Campus vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-03/esc-03-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-03/esc-03-04.jpg" alt="Asientos Colaborativos Modulares para Espacios Sociales del Campus vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-03/esc-03-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Asientos Escolares</span>
        <h1>Asientos Colaborativos Modulares para Espacios Sociales del Campus</h1>
        <p class="producto-intro">Los asientos colaborativos modulares están diseñados para convertir los espacios sociales del campus en zonas de encuentro y estudio. Las unidades de espuma de alta resiliencia con tejido de grado comercial soportan más de 50.000 ciclos de uso, mientras que los puertos de carga USB integrados responden a las necesidades digitales de los estudiantes. El sistema modular permite reorganizar una zona de aprendizaje completa en minutos, creando rincones de conversación, áreas de trabajo en grupo o zonas de descanso según la actividad del día.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El diseño 100% modular permite a los responsables del campus reconfigurar las zonas de aprendizaje en pocos minutos. Las encuestas de uso del campus indican que las disposiciones flexibles aumentan la actividad de los estudiantes un 35%, manteniendo el mobiliario útil conforme evolucionan los métodos de enseñanza.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La espuma de alta resiliencia mantiene su forma tras un uso intensivo y se combina con un tejido de grado comercial con más de 50.000 ciclos de abrasión. Las unidades de descanso se combinan con mesas de trabajo activo para crear entornos completos que reducen la fatiga durante los proyectos en equipo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las unidades ofrecen puertos de carga USB-C y tomas de corriente integrados de forma opcional. Un vestíbulo o zona común se convierte así en un punto de trabajo funcional donde los estudiantes cargan sus dispositivos mientras estudian o colaboran.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los materiales ignífugos con certificación cumplen los requisitos de seguridad para espacios públicos de gran afluencia. Las fundas desmontables se limpian y sustituyen sin desmontar la estructura, reduciendo el coste de mantenimiento de las zonas comunes del campus.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El sistema se personaliza con acabados de tejido, formas y colores corporativos del centro educativo. El equipo técnico colabora con arquitectos y contratistas en la planificación de espacios sociales para proyectos de universidades, institutos y centros de formación.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Tipo</th><th>Tejido</th><th>Carga</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Butaca individual</td><td>Grado comercial</td><td>Sin electrónica</td><td>Zonas de lectura</td></tr><tr><td>Módulo doble</td><td>50.000 ciclos</td><td>USB-C opcional</td><td>Vestíbulos y hall</td></tr><tr><td>Rincón modular</td><td>Ignífugo</td><td>Toma de corriente</td><td>Aulas polivalentes</td></tr><tr><td>A medida</td><td>Personalizado</td><td>Completo</td><td>Proyectos de campus</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Espuma de alta resiliencia, tejido de grado comercial</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Resistencia del tejido</td>
                            <td class="spec-value">Más de 50.000 ciclos de abrasión (Martindale)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Electrónica</td>
                            <td class="spec-value">Puertos USB-C y tomas de corriente (opcional)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Madera contrachapada reforzada o acero según modelo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Funda</td>
                            <td class="spec-value">Desmontable y lavable</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, ignífugo EN 1021, CE</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Vestíbulo de instituto: módulos de asientos con carga USB para que los estudiantes estudien y se relacionen entre clases.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Biblioteca universitaria: rincones de asientos modulares que crean zonas de lectura en grupo sin necesidad de obras ni tabiques.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Zona común de residencia de estudiantes: butacas resistentes para uso intensivo con tejido de fácil limpieza.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las fundas se pueden cambiar de color más adelante?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, las fundas de los asientos son desmontables y se pueden sustituir por fundas de otro color o tejido. Esta opción permite renovar la imagen de las zonas comunes sin comprar mobiliario nuevo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los puertos USB necesitan instalación eléctrica previa?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Los módulos con carga USB requieren una toma de corriente cercana para la conexión de la fuente de alimentación. La instalación la realiza un electricista y el cableado queda oculto en la estructura del asiento.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué mantenimiento requiere el tejido en zonas de uso intensivo?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Se recomienda aspirar el tejido una vez por semana y realizar una limpieza en seco cada trimestre. Las fundas desmontables se lavan en tintorería o a máquina según el tejido elegido, lo que prolonga la vida útil del asiento.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/estanterias-libreria-escolar-modulares-madera-e1/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-04/esc-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Biblioteca Escolar</span>
            <h3>Estanterías de Librería Escolar Modulares en Madera E1</h3>
          </div>
        </a>
        <a href="/productos-escolares/pupitres-escolares-flexibles-k12-aulas-modernas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-05/esc-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula K-12</span>
            <h3>Pupitres Escolares Flexibles K-12 para Aulas Modernas</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-escolar-modular-reconfigurable-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-06/esc-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula Modular</span>
            <h3>Mobiliario Escolar Modular Reconfigurable con Ruedas</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-03-butacas-sillas-zona-estudio-lectura-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
  .card-mini-cat { display: block; font-size: 11px; color: var(--color-text-light, #6B6358); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
