---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Estanterías Librería Escolar Madera E1 | Fabricante";
const pageDescription = "Estanterías para librería escolar de madera E1 con capacidad de 80 kg por balda. Sistema modular y antivuelco para bibliotecas y centros educativos. Fabricación a medida.";
const canonicalUrl = "/productos-escolares/estanterias-libreria-escolar-modulares-madera-e1/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Estanterías de Librería Escolar Modulares en Madera E1",
    "description": "Estanterías para librería escolar de madera E1 con capacidad de 80 kg por balda. Sistema modular y antivuelco para bibliotecas y centros educativos. F",
    "category": "Biblioteca Escolar",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Estanterías de Librería Escolar Modulares en Madera E1"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las estanterías se fijan a la pared?", "acceptedAnswer": {"@type": "Answer", "text": "Todas las estanterías superiores a 120 cm de altura incluyen sistema de anclaje antivuelco a la pared. La fijación se realiza con tacos y tornillos, y el equipo de montaje verifica la estabilidad tras la instalación."}}, {"@type": "Question", "name": "¿Se pueden mover las baldas de sitio?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, las baldas son regulables en altura con separaciones de 25 mm. Se deslizan sobre soportes metálicos y se recolocan sin herramientas para adaptar la estantería al tamaño de los libros o materiales."}}, {"@type": "Question", "name": "¿Qué capacidad de libros tiene una estantería de 180 cm?", "acceptedAnswer": {"@type": "Answer", "text": "Una estantería de 180 cm de alto, 90 cm de ancho y 5 baldas puede albergar entre 400 y 600 libros según el formato. La capacidad exacta depende de la profundidad elegida y del tamaño medio de los volúmenes."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Estanterías de Librería Escolar Modulares en Madera E1</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-04/esc-04-01.jpg" alt="Estanterías de Librería Escolar Modulares en Madera E1 para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Estanterías de Librería Escolar Modulares en Madera E1</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-04/esc-04-01.jpg" alt="Estanterías de Librería Escolar Modulares en Madera E1 vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-04/esc-04-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-04/esc-04-02.jpg" alt="Estanterías de Librería Escolar Modulares en Madera E1 vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-04/esc-04-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-04/esc-04-03.jpg" alt="Estanterías de Librería Escolar Modulares en Madera E1 vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-04/esc-04-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-04/esc-04-04.jpg" alt="Estanterías de Librería Escolar Modulares en Madera E1 vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-04/esc-04-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Biblioteca Escolar</span>
        <h1>Estanterías de Librería Escolar Modulares en Madera E1</h1>
        <p class="producto-intro">Las estanterías de librería escolar de madera E1 convierten las salas de lectura en espacios de aprendizaje multifuncionales. Los sistemas modulares de alta densidad almacenan hasta 80 kg por balda sin deformarse, gracias a los conectores de acero ocultos en la estructura. La madera con certificación medioambiental aporta calidez al ambiente de lectura, mientras que los anclajes antivuelco garantizan la seguridad en zonas de uso intensivo. El conjunto se completa con mesas y sillas de lectura a la altura ergonómica adecuada para cada etapa educativa.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Las baldas ajustables soportan hasta 80 kg cada una sin combarse, incluso en zonas de tránsito continuo. El marco modular aumenta la densidad de almacenamiento de libros un 30% frente a las estanterías convencionales, optimizando cada metro de la biblioteca escolar.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las mesas y sillas de lectura integradas en el conjunto se fabrican a la altura ergonómica correcta para reducir la tensión de espalda durante las sesiones largas de estudio. La ergonomía del mobiliario de biblioteca favorece la resistencia a la lectura y el rendimiento académico de los alumnos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los conectores de acero ocultos y los anclajes antivuelco garantizan la estabilidad estructural de las estanterías, incluso cuando se retiran varias baldas o se cargan de forma desigual. La seguridad es una prioridad en los proyectos de bibliotecas escolares con alumnos pequeños.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La madera E1 con acabados de alta resistencia mantiene su aspecto ante el uso diario y la limpieza con productos habituales. Los cantos sellados evitan la entrada de humedad y prolongan la vida útil del mobiliario en ambientes con mucha actividad.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El sistema modular permite ampliar la biblioteca por fases sin sustituir lo existente. Cada proyecto de librería escolar se planifica con el equipo técnico, que entrega planos de distribución, detalles de anclaje y presupuesto a medida para instituciones educativas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Capacidad</th><th>Madera</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Estantería simple</td><td>80 kg/balda</td><td>MDF E1</td><td>Aulas de lectura</td></tr><tr><td>Biblioteca modular</td><td>Doble cara</td><td>E1 + chapa</td><td>Bibliotecas escolares</td></tr><tr><td>Rincón de lectura</td><td>Con asientos</td><td>E1 reforzado</td><td>Educación infantil</td></tr><tr><td>A medida</td><td>Según plano</td><td>E0 opcional</td><td>Proyectos de centro</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Madera MDF E1 con acabados resistentes al uso</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Capacidad</td>
                            <td class="spec-value">80 kg por balda, baldas regulables</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Conectores de acero ocultos, anclaje antivuelco</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Alturas</td>
                            <td class="spec-value">900-2000 mm según modelo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Profundidad</td>
                            <td class="spec-value">300-450 mm, baldas simples o dobles</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Chapa de madera, melamina, lacados</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, E1, EN 16121</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Biblioteca de colegio: estanterías perimetrales de doble cara con zonas de lectura centrales para maximizar el aforo sin perder luz.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Aula de lectura: módulos bajos con baldas y asientos integrados para que los alumnos de infantil accedan a los libros con autonomía.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Mediateca universitaria: estanterías de alta densidad para fondos extensos con pasillos de circulación anchos y señalización clara.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las estanterías se fijan a la pared?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Todas las estanterías superiores a 120 cm de altura incluyen sistema de anclaje antivuelco a la pared. La fijación se realiza con tacos y tornillos, y el equipo de montaje verifica la estabilidad tras la instalación.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden mover las baldas de sitio?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, las baldas son regulables en altura con separaciones de 25 mm. Se deslizan sobre soportes metálicos y se recolocan sin herramientas para adaptar la estantería al tamaño de los libros o materiales.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué capacidad de libros tiene una estantería de 180 cm?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Una estantería de 180 cm de alto, 90 cm de ancho y 5 baldas puede albergar entre 400 y 600 libros según el formato. La capacidad exacta depende de la profundidad elegida y del tamaño medio de los volúmenes.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/pupitres-escolares-flexibles-k12-aulas-modernas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-05/esc-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula K-12</span>
            <h3>Pupitres Escolares Flexibles K-12 para Aulas Modernas</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-escolar-modular-reconfigurable-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-06/esc-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula Modular</span>
            <h3>Mobiliario Escolar Modular Reconfigurable con Ruedas</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-jardin-infancia-madera-abedul/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-07/esc-07-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Jardín de Infancia</span>
            <h3>Mobiliario para Jardín de Infancia en Madera de Abedul</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-04-estanteria-libros-rincon-lectura-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
