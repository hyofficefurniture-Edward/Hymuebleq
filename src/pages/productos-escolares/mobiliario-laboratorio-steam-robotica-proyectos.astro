---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Laboratorio STEAM Robótica | Fabricante";
const pageDescription = "Mobiliario para laboratorio STEAM de robótica y proyectos. Bancos de trabajo con tablero de arce o resina epoxi, ruedas de freno y almacenamiento modular. Fabricación a medida.";
const canonicalUrl = "/productos-escolares/mobiliario-laboratorio-steam-robotica-proyectos/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario para Laboratorio STEAM de Robótica y Proyectos",
    "description": "Mobiliario para laboratorio STEAM de robótica y proyectos. Bancos de trabajo con tablero de arce o resina epoxi, ruedas de freno y almacenamiento modu",
    "category": "Aula STEAM",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario para Laboratorio STEAM de Robótica y Proyectos"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Los tableros de resina epoxi resisten los productos químicos?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, la resina epoxi de grado industrial resiste ácidos, disolventes y productos de limpieza habituales en laboratorios escolares. Para trabajos de mecánica y carpintería se recomienda el tablero de arce macizo, que se lija y repinta con facilidad."}}, {"@type": "Question", "name": "¿Las tomas eléctricas están incluidas en el precio?", "acceptedAnswer": {"@type": "Answer", "text": "Las tomas eléctricas y los puertos USB se incluyen en los modelos con electrónica integrada. En los modelos básicos se puede añadir el kit eléctrico como opción, con instalación prevista en las canaletas del banco."}}, {"@type": "Question", "name": "¿Se puede planificar el aula STEAM completa?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el equipo técnico planifica el aula STEAM completa: distribución de bancos, puntos de corriente, almacenamiento y zonas de proyecto. Se entregan planos y presupuesto a medida en menos de una semana."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario para Laboratorio STEAM de Robótica y Proyectos</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-11/esc-11-01.jpg" alt="Mobiliario para Laboratorio STEAM de Robótica y Proyectos para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario para Laboratorio STEAM de Robótica y Proyectos</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-11/esc-11-01.jpg" alt="Mobiliario para Laboratorio STEAM de Robótica y Proyectos vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-11/esc-11-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-11/esc-11-02.jpg" alt="Mobiliario para Laboratorio STEAM de Robótica y Proyectos vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-11/esc-11-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-11/esc-11-03.jpg" alt="Mobiliario para Laboratorio STEAM de Robótica y Proyectos vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-11/esc-11-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-11/esc-11-04.jpg" alt="Mobiliario para Laboratorio STEAM de Robótica y Proyectos vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-11/esc-11-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Aula STEAM</span>
        <h1>Mobiliario para Laboratorio STEAM de Robótica y Proyectos</h1>
        <p class="producto-intro">El mobiliario para laboratorio STEAM está diseñado para unir la teoría y la práctica en el aula. Los bancos de trabajo con tablero de arce macizo o resina epoxi resistente a productos químicos soportan impresoras 3D, robots y herramientas de taller, mientras que las ruedas de freno de grado industrial permiten reconfigurar la sala en menos de cinco minutos. El almacenamiento modular y las tomas de corriente integradas completan un espacio de laboratorio escolar preparado para proyectos de ciencia, tecnología, ingeniería, arte y matemáticas.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El sistema modular reconfigura el laboratorio desde estaciones de prueba individuales hasta zonas de colaboración en grupo en menos de cinco minutos. Las encuestas de uso muestran un aumento del 35% en el nivel de participación cuando el mobiliario del aula de proyectos se adapta al plan de cada sesión.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los tableros de arce macizo de 38 mm o resina epoxi resistente a químicos soportan tareas de ingeniería de alto impacto y sustancias corrosivas. En las pruebas de esfuerzo, los bastidores soportaron hasta 1.200 libras de maquinaria pesada, como impresoras 3D y fresadoras CNC.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las ruedas de freno de grado industrial facilitan la movilidad de los bancos sin renunciar a la estabilidad durante el trabajo con herramientas. El diseño móvil permite que el laboratorio escolar evolucione junto con el currículo de robótica y proyectos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Las tomas de corriente y puertos USB integrados en los bancos alimentan los equipos de cada estación de trabajo. El cableado queda recogido en canaletas bajo el tablero, manteniendo el suelo libre de cables y reduciendo el riesgo de tropiezos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El almacenamiento modular con cajones y bandejas guarda las herramientas, componentes y material de cada proyecto. Cada grupo dispone de su módulo identificado, agilizando el inicio de la sesión y el orden al finalizar la clase.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Tablero</th><th>Carga</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Banco individual</td><td>Resina epoxi</td><td>600 kg</td><td>Robótica y electrónica</td></tr><tr><td>Banco doble</td><td>Arce macizo 38 mm</td><td>900 kg</td><td>Taller de proyectos</td></tr><tr><td>Isla central</td><td>Resina + arce</td><td>1.200 libras</td><td>Aulas STEAM completas</td></tr><tr><td>A medida</td><td>Configurable</td><td>Según plano</td><td>Centros de innovación</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Arce macizo 38 mm o resina epoxi química</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">De freno, grado industrial, no marcan el suelo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Carga</td>
                            <td class="spec-value">Bastidores probados hasta 1.200 libras</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Electrónica</td>
                            <td class="spec-value">Tomas de corriente y USB integrados en canaletas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Almacenamiento</td>
                            <td class="spec-value">Módulos con cajones y bandejas identificados</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, EN 16121, CE</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">15 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">35-45 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Aula de robótica: bancos con tomas eléctricas para programar y probar robots en cada estación de trabajo.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Laboratorio de ciencias: superficies resistentes a productos químicos para prácticas de química y física.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Taller de impresión 3D: bancos reforzados que soportan el peso de impresoras y equipos de fabricación digital.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los tableros de resina epoxi resisten los productos químicos?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, la resina epoxi de grado industrial resiste ácidos, disolventes y productos de limpieza habituales en laboratorios escolares. Para trabajos de mecánica y carpintería se recomienda el tablero de arce macizo, que se lija y repinta con facilidad.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las tomas eléctricas están incluidas en el precio?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Las tomas eléctricas y los puertos USB se incluyen en los modelos con electrónica integrada. En los modelos básicos se puede añadir el kit eléctrico como opción, con instalación prevista en las canaletas del banco.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede planificar el aula STEAM completa?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el equipo técnico planifica el aula STEAM completa: distribución de bancos, puntos de corriente, almacenamiento y zonas de proyecto. Se entregan planos y presupuesto a medida en menos de una semana.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/atril-podio-docente/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-12/esc-12-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Podio Docente</span>
            <h3>Atril y Podio para Docente de Madera con Altura Regulable</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-educacion-infantil-seguro-cantos-redondeados/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-01/esc-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Educación Infantil</span>
            <h3>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-modular-aprendizaje-colaborativo-aulas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-02/esc-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula Flexible</span>
            <h3>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-11-mesas-trabajo-resistentes-taller-creativo-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
