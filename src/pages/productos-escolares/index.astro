---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Escolar - Mobiliario Educativo para Colegios | HYMUEBLE";
const pageDescription = "Fabricante de mobiliario escolar y educativo. 12 productos para aulas, bibliotecas, laboratorios y comedores escolares. Fabricacion a medida para instituciones educativas.";
const canonicalUrl = "/productos-escolares/";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath={canonicalUrl}>
  <article class="producto-listing">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario Escolar</span>
      </div>
    </nav>

    <div class="listing-header">
      <div class="content-container">
        <h1>Mobiliario Escolar</h1>
        <p>Fabricante de mobiliario escolar y educativo con 12 productos especializados. Desde aulas de educacion infantil hasta pupitres de secundaria, pasando por bibliotecas, laboratorios y comedores escolares. Fabricacion a medida para proyectos de colegios e instituciones.</p>
      </div>
    </div>

    <section class="section">
      <div class="content-container">
        <div class="productos-grid">
        <a href="/productos-escolares/mobiliario-educacion-infantil-seguro-cantos-redondeados/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-escolares/esc-01/esc-01-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Educación Infantil</span>
            <h3>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</h3>
            <p>Mobiliario para educación infantil con cantos redondeados y materiales no tóxicos. Mesas redondas, a...</p>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-modular-aprendizaje-colaborativo-aulas/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-escolares/esc-02/esc-02-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Aula Flexible</span>
            <h3>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</h3>
            <p>Mobiliario modular para aprendizaje colaborativo en aulas. Mesas geométricas, sillas ergonómicas y a...</p>
          </div>
        </a>
        <a href="/productos-escolares/asientos-colaborativos-modulares-espacios-sociales-campus/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-escolares/esc-03/esc-03-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Asientos Escolares</span>
            <h3>Asientos Colaborativos Modulares para Espacios Sociales del Campus</h3>
            <p>Asientos colaborativos modulares para espacios sociales del campus y zonas de aprendizaje. Espuma de...</p>
          </div>
        </a>
        <a href="/productos-escolares/estanterias-libreria-escolar-modulares-madera-e1/" class="producto-card">
          <div class="producto-card-img" style="background-image: url(/images/productos-escolares/esc-04/esc-04-01.jpg); background-size: cover; background-position: center;"></div>
          <div class="producto-card-info">
            <span class="producto-card-cat">Biblioteca Escolar</span>
            <h3>Estanterías de Librería Escolar Modulares en Madera E1</h3>
            <p>Estanterías para librería escolar de madera E1 con capacidad de 80 kg por balda. Sistema modular y a...</p>
          </div>
        </a>
