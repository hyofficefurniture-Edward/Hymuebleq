---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Atril y Podio para Docente | Fabricante Escolar";
const pageDescription = "Atril y podio para docente de madera con altura regulable. Superficie inclinada para apuntes, balda portaobjetos y estructura antivuelco. Fabricación a medida para colegios y universidades.";
const canonicalUrl = "/productos-escolares/atril-podio-docente/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Atril y Podio para Docente de Madera con Altura Regulable",
    "description": "Atril y podio para docente de madera con altura regulable. Superficie inclinada para apuntes, balda portaobjetos y estructura antivuelco. Fabricación ",
    "category": "Podio Docente",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Atril y Podio para Docente de Madera con Altura Regulable"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿El podio soporta un portátil sobre la superficie inclinada?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, la superficie inclinada admite portátiles de hasta 15 pulgadas gracias al borde antideslizante. Para portátiles más grandes se recomienda la bandeja extraíble, que se coloca en la balda inferior sin ocupar la superficie de lectura."}}, {"@type": "Question", "name": "¿La altura se puede ajustar una vez instalado el podio?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el mecanismo de ajuste de altura funciona en cualquier momento. Se afloja la palanca, se coloca el podio a la altura deseada y se vuelve a fijar. El proceso toma menos de 30 segundos y no requiere herramientas."}}, {"@type": "Question", "name": "¿Se puede personalizar el acabado con el logo del centro?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, ofrecemos grabado del logo o del nombre del centro en la parte frontal del podio. El grabado se realiza en la fábrica y está disponible en madera natural o lacado bajo pedido."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Atril y Podio para Docente de Madera con Altura Regulable</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-12/esc-12-01.jpg" alt="Atril y Podio para Docente de Madera con Altura Regulable para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Atril y Podio para Docente de Madera con Altura Regulable</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-12/esc-12-01.jpg" alt="Atril y Podio para Docente de Madera con Altura Regulable vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-12/esc-12-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-12/esc-12-02.jpg" alt="Atril y Podio para Docente de Madera con Altura Regulable vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-12/esc-12-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-12/esc-12-03.jpg" alt="Atril y Podio para Docente de Madera con Altura Regulable vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-12/esc-12-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-12/esc-12-04.jpg" alt="Atril y Podio para Docente de Madera con Altura Regulable vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-12/esc-12-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Podio Docente</span>
        <h1>Atril y Podio para Docente de Madera con Altura Regulable</h1>
        <p class="producto-intro">El atril y podio para docente de madera ofrece al profesor una estación de trabajo estable y elegante frente al aula. La superficie inclinada facilita la lectura de apuntes y el manejo del portátil, mientras que la balda portaobjetos guarda libros, bolígrafos y material de clase. La altura regulable se adapta a la estatura de cada docente y la base antivuelco garantiza la estabilidad durante la exposición. Un elemento esencial del mobiliario de aula que ordena el espacio del profesor y transmite profesionalidad.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>La superficie inclinada con borde antideslizante mantiene los apuntes en su sitio durante la exposición y facilita la lectura sin forzar el cuello. El ángulo de inclinación está calculado para el uso continuado frente a la clase.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La altura regulable se ajusta a la estatura de cada docente en segundos. El mecanismo de ajuste es sencillo y silencioso, permitiendo adaptar el podio entre horas de clase sin interrumpir la dinámica del aula.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La balda portaobjetos inferior guarda el portátil, los libros y el material de clase al alcance de la mano. La bandeja delantera mantiene bolígrafos, rotuladores y punteros ordenados durante la sesión.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La estructura de madera maciza con base antivuelco soporta el apoyo del docente durante las clases largas sin moverse. Las aristas redondeadas y los cantos sellados garantizan la seguridad en aulas con alumnos pequeños.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El acabado en madera natural o lacado combina con el resto del mobiliario de aula y transmite una imagen profesional del centro educativo. El atril se fabrica a medida en las medidas y acabados del proyecto.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Altura</th><th>Material</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Atril fijo</td><td>Fija</td><td>Madera maciza</td><td>Aulas estándar</td></tr><tr><td>Podio regulable</td><td>Regulable</td><td>Madera + acero</td><td>Salas de conferencias</td></tr><tr><td>Atril con portátil</td><td>Regulable</td><td>Con bandeja</td><td>Aulas digitales</td></tr><tr><td>A medida</td><td>Según plano</td><td>Personalizable</td><td>Proyectos de centro</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Madera maciza con acabados al agua</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Altura</td>
                            <td class="spec-value">Regulable 950-1250 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">Inclinada con borde antideslizante</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Balda</td>
                            <td class="spec-value">Portaobjetos inferior, bandeja delantera</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Base</td>
                            <td class="spec-value">Antivuelco con protectores de suelo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Madera natural, lacados, melamina</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, EN 16121, CE</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">20-30 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Aula de colegio: podio regulable para el docente con espacio para apuntes, portátil y material de clase.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Sala de conferencias: atril de madera para ponencias, presentaciones y actos académicos del centro.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Aula universitaria: estación de trabajo del profesor con superficie inclinada para apuntes y bandeja para dispositivos.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El podio soporta un portátil sobre la superficie inclinada?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, la superficie inclinada admite portátiles de hasta 15 pulgadas gracias al borde antideslizante. Para portátiles más grandes se recomienda la bandeja extraíble, que se coloca en la balda inferior sin ocupar la superficie de lectura.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La altura se puede ajustar una vez instalado el podio?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el mecanismo de ajuste de altura funciona en cualquier momento. Se afloja la palanca, se coloca el podio a la altura deseada y se vuelve a fijar. El proceso toma menos de 30 segundos y no requiere herramientas.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede personalizar el acabado con el logo del centro?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, ofrecemos grabado del logo o del nombre del centro en la parte frontal del podio. El grabado se realiza en la fábrica y está disponible en madera natural o lacado bajo pedido.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/mobiliario-educacion-infantil-seguro-cantos-redondeados/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-01/esc-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Educación Infantil</span>
            <h3>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-modular-aprendizaje-colaborativo-aulas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-02/esc-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula Flexible</span>
            <h3>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</h3>
          </div>
        </a>
        <a href="/productos-escolares/asientos-colaborativos-modulares-espacios-sociales-campus/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-03/esc-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Asientos Escolares</span>
            <h3>Asientos Colaborativos Modulares para Espacios Sociales del Campus</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-12-atril-madera-presentaciones-casa.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
  .card-mini-info { padding: 16px 20px; }
