---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Pupitres Flexibles K-12 para Aulas | Fabricante Escolar";
const pageDescription = "Pupitres escolares flexibles K-12 para aulas modernas. Mesas reconfigurables, sillas modulares con respaldo ergonómico y mobiliario que crece con el alumno. Fabricación a medida.";
const canonicalUrl = "/productos-escolares/pupitres-escolares-flexibles-k12-aulas-modernas/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Pupitres Escolares Flexibles K-12 para Aulas Modernas",
    "description": "Pupitres escolares flexibles K-12 para aulas modernas. Mesas reconfigurables, sillas modulares con respaldo ergonómico y mobiliario que crece con el a",
    "category": "Aula K-12",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Pupitres Escolares Flexibles K-12 para Aulas Modernas"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las mesas se pueden apilar para guardarlas?", "acceptedAnswer": {"@type": "Answer", "text": "Las sillas se apilan hasta 8 unidades para su almacenamiento, y las mesas incluyen patas plegables en los modelos diseñados para salas polivalentes. El resto de modelos se apilan en carros de transporte con ruedas."}}, {"@type": "Question", "name": "¿Qué rango de alturas cubre la colección?", "acceptedAnswer": {"@type": "Answer", "text": "La colección cubre desde 460 mm de altura de mesa para educación infantil hasta 760 mm para bachillerato. Las sillas acompañan a cada mesa con asientos de 260 a 460 mm de altura."}}, {"@type": "Question", "name": "¿El mobiliario es adecuado para aulas con alumnos de alturas muy distintas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Existen modelos de altura regulable que se ajustan individualmente, ideales para aulas con alumnos de edades o alturas variadas. Cada alumno ajusta su pupitre en segundos sin herramientas."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Pupitres Escolares Flexibles K-12 para Aulas Modernas</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-05/esc-05-01.jpg" alt="Pupitres Escolares Flexibles K-12 para Aulas Modernas para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Pupitres Escolares Flexibles K-12 para Aulas Modernas</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-05/esc-05-01.jpg" alt="Pupitres Escolares Flexibles K-12 para Aulas Modernas vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-05/esc-05-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-05/esc-05-02.jpg" alt="Pupitres Escolares Flexibles K-12 para Aulas Modernas vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-05/esc-05-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-05/esc-05-03.jpg" alt="Pupitres Escolares Flexibles K-12 para Aulas Modernas vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-05/esc-05-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-05/esc-05-04.jpg" alt="Pupitres Escolares Flexibles K-12 para Aulas Modernas vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-05/esc-05-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Aula K-12</span>
        <h1>Pupitres Escolares Flexibles K-12 para Aulas Modernas</h1>
        <p class="producto-intro">La colección de pupitres escolares flexibles K-12 acompaña a los alumnos desde educación infantil hasta bachillerato, sustituyendo el modelo de talla única. Las mesas y sillas modulares se reorganizan en segundos para adaptarse al plan de cada clase: exámenes individuales, trabajo en grupo o proyectos colaborativos. Los respaldos flexibles y los bordes contorneados cuidan la postura y el bienestar físico durante toda la jornada escolar. El sistema completo está pensado para centros educativos que buscan modernizar sus aulas con mobiliario duradero y adaptable.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Las mesas reconfigurables pasan de estación de trabajo individual a grupos de alumnos en segundos, apoyando la metodología de aprendizaje activo. Los datos de aula muestran un aumento del 26% en el nivel de participación cuando el mobiliario permite cambiar la disposición sin fricción.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las sillas modulares con respaldo flexible y bordes contorneados promueven el flujo sanguíneo y la alineación de la columna durante las clases largas. Los centros que adoptan pupitres ergonómicos registran una reducción del 20% en el movimiento constante de los alumnos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El rango de tallas cubre todas las etapas K-12: desde sillas y mesas bajas para infantil hasta modelos de altura adulta para bachillerato. Cada alumno dispone de mobiliario a su medida, evitando posturas forzadas y problemas de espalda a largo plazo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero con recubrimiento en polvo soporta el uso diario de un centro educativo durante más de una década. Las superficies de melamina de alta presión resisten rayones, derrames y la limpieza con desinfectantes habituales.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>El mobiliario se vende por fases para adaptarse al presupuesto de cada centro: primero las aulas piloto y después la ampliación al resto del edificio. El equipo técnico asesora la planificación del proyecto educativo y coordina la fabricación con los plazos de obra.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Etapa</th><th>Mesas</th><th>Sillas</th><th>Acabado</th></tr>
            </thead>
            <tbody>
              <tr><td>Infantil</td><td>Bajas 460 mm</td><td>Fijas pequeñas</td><td>Colores vivos</td></tr><tr><td>Primaria</td><td>Regulables</td><td>Con respaldo flexible</td><td>Melamina clara</td></tr><tr><td>Secundaria</td><td>Altas 740 mm</td><td>Modulares</td><td>Melamina antirrayas</td></tr><tr><td>Bachillerato</td><td>Altura adulta</td><td>Con ruedas</td><td>Acabado profesional</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Tablero MDF E0 con melamina de alta presión</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesas</td>
                            <td class="spec-value">Altura regulable 460-760 mm según etapa</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Sillas</td>
                            <td class="spec-value">Respaldo flexible, estructura de acero</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Estructura</td>
                            <td class="spec-value">Acero de 1,2 mm con recubrimiento en polvo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Superficie</td>
                            <td class="spec-value">Antirrayas y resistente a desinfectantes</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, EN 16121, CE</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Aula de primaria: mesas individuales que se agrupan para trabajo por proyectos y vuelven a separarse para los exámenes en menos de un minuto.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Aula de secundaria: disposición modular para debates, presentaciones y trabajo en equipo con sillas ergonómicas de respaldo flexible.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Salón de actos polivalente: mobiliario apilable y ligero que se retira en minutos para dejar el espacio libre para eventos.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las mesas se pueden apilar para guardarlas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Las sillas se apilan hasta 8 unidades para su almacenamiento, y las mesas incluyen patas plegables en los modelos diseñados para salas polivalentes. El resto de modelos se apilan en carros de transporte con ruedas.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué rango de alturas cubre la colección?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>La colección cubre desde 460 mm de altura de mesa para educación infantil hasta 760 mm para bachillerato. Las sillas acompañan a cada mesa con asientos de 260 a 460 mm de altura.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El mobiliario es adecuado para aulas con alumnos de alturas muy distintas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Existen modelos de altura regulable que se ajustan individualmente, ideales para aulas con alumnos de edades o alturas variadas. Cada alumno ajusta su pupitre en segundos sin herramientas.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/mobiliario-escolar-modular-reconfigurable-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-06/esc-06-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula Modular</span>
            <h3>Mobiliario Escolar Modular Reconfigurable con Ruedas</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-jardin-infancia-madera-abedul/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-07/esc-07-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Jardín de Infancia</span>
            <h3>Mobiliario para Jardín de Infancia en Madera de Abedul</h3>
          </div>
        </a>
        <a href="/productos-escolares/estanterias-moviles-bibliotecas-escolares-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-08/esc-08-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Biblioteca Móvil</span>
            <h3>Estanterías Móviles para Bibliotecas Escolares con Ruedas</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-05-escritorios-escolares-flexibles-cuarto-estudio.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
  .card-mini-img { height: 160px; background: #EEF0F3; background-size: cover; background-position: center; }
