---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Modular Aprendizaje Colaborativo | Fabricante";
const pageDescription = "Mobiliario modular para aprendizaje colaborativo en aulas. Mesas geométricas, sillas ergonómicas y almacenamiento móvil para aulas interactivas. Fabricación a medida para proyectos educativos.";
const canonicalUrl = "/productos-escolares/mobiliario-modular-aprendizaje-colaborativo-aulas/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario Modular para Aprendizaje Colaborativo en Aulas",
    "description": "Mobiliario modular para aprendizaje colaborativo en aulas. Mesas geométricas, sillas ergonómicas y almacenamiento móvil para aulas interactivas. Fabri",
    "category": "Aula Flexible",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario Modular para Aprendizaje Colaborativo en Aulas"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Cuánto se tarda en cambiar la configuración del aula?", "acceptedAnswer": {"@type": "Answer", "text": "Un grupo de alumnos puede reconfigurar el aula completa en menos de 2 minutos. Las mesas se entrelazan sin herramientas y las sillas se desplazan por su propio peso. El paso de filas a islas de seis alumnos toma unos 60 segundos."}}, {"@type": "Question", "name": "¿Las mesas soportan ordenadores portátiles y tablets?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. La melamina de alta presión soporta el peso de portátiles, tablets y libros sin marcas. Las superficies son antirrayas y resisten el uso diario. Se puede añadir una bandeja portátil bajo el tablero para guardar los equipos."}}, {"@type": "Question", "name": "¿El sistema funciona en aulas de más de 40 alumnos?", "acceptedAnswer": {"@type": "Answer", "text": "El sistema se dimensiona según la superficie y el número de alumnos. Para aulas grandes se combinan agrupaciones de seis con zonas de trabajo individual, manteniendo siempre pasillos de circulación seguros para el docente."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-02/esc-02-01.jpg" alt="Mobiliario Modular para Aprendizaje Colaborativo en Aulas para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-02/esc-02-01.jpg" alt="Mobiliario Modular para Aprendizaje Colaborativo en Aulas vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-02/esc-02-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-02/esc-02-02.jpg" alt="Mobiliario Modular para Aprendizaje Colaborativo en Aulas vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-02/esc-02-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-02/esc-02-03.jpg" alt="Mobiliario Modular para Aprendizaje Colaborativo en Aulas vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-02/esc-02-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-02/esc-02-04.jpg" alt="Mobiliario Modular para Aprendizaje Colaborativo en Aulas vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-02/esc-02-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Aula Flexible</span>
        <h1>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</h1>
        <p class="producto-intro">El mobiliario modular para aprendizaje colaborativo convierte las aulas tradicionales en entornos de aprendizaje activo. Mesas geométricas que se entrelazan, sillas con basculación ergonómica y almacenamiento móvil permiten pasar de la instrucción directa al trabajo por proyectos en menos de un minuto. Cada pieza se fabrica con materiales de uso intensivo y acabados resistentes al desgaste de una jornada escolar completa. El sistema completo está pensado para colegios, universidades y centros de formación que buscan espacios de enseñanza flexibles y duraderos.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Las mesas geométricas entrelazadas permiten una reconfiguración de 360 grados: desde el trabajo individual hasta agrupaciones de seis alumnos en menos de un minuto. Los estudios de aula muestran un aumento de la participación del 25% frente a las filas fijas de pupitres tradicionales.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las sillas incorporan una basculación de 10 grados que favorece la postura activa durante las clases largas. Esta flexibilidad reduce la fatiga física y mejora la concentración sostenida de los estudiantes en sesiones de trabajo colaborativo y exposición de contenidos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>La estructura de acero con recubrimiento en polvo soporta el uso continuado de un centro educativo sin pérdida de acabado. Los cantos perimetrales de las mesas protegen a los alumnos y el mobiliario mantiene su aspecto durante años de rotación por distintas aulas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El almacenamiento móvil con ruedas de freno se desplaza sin esfuerzo entre zonas de trabajo. Los módulos con bandejas y cajones guardan material de clase, tablets y suministros cerca de cada grupo, eliminando los desplazamientos que interrumpen la dinámica de la sesión.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>Cada proyecto de aula interactiva se acompaña de un plano de distribución con distintas configuraciones: en U para debates, en islas para proyectos y en filas para exámenes. El equipo técnico asesora la elección de piezas según el número de alumnos y la superficie del aula.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Reconfiguración</th><th>Sillas</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Aula básica</td><td>Fila o grupo de 4</td><td>Fijas</td><td>Educación primaria</td></tr><tr><td>Aula interactiva</td><td>360° en 60 segundos</td><td>Basculación 10°</td><td>Secundaria y bachillerato</td></tr><tr><td>Aula de proyectos</td><td>Islas de 6 alumnos</td><td>Con ruedas</td><td>Universidad y formación</td></tr><tr><td>A medida</td><td>Según plano</td><td>Configurable</td><td>Proyectos institucionales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Tablero MDF E0 con laminado melamínico antirrayas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesas geométricas</td>
                            <td class="spec-value">Formas hexagonales y trapezoidales, tablero 25 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Sillas</td>
                            <td class="spec-value">Basculación 10°, estructura de acero con recubrimiento en polvo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Almacenamiento móvil</td>
                            <td class="spec-value">Módulos con ruedas de freno y bandejas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Melamina de alta presión, cantos ABS 2 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Capacidad</td>
                            <td class="spec-value">Hasta 6 alumnos por agrupación</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, EN 16121, CE</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Aula de secundaria: mobiliario que alterna la exposición del docente con el trabajo en grupos, facilitando el debate y la resolución de problemas en equipo.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Aula universitaria: mesas entrelazadas para seminarios y talleres, con almacenamiento móvil para material de prácticas y equipos informáticos.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Centro de formación profesional: configuración por islas para módulos prácticos, con superficies resistentes a herramientas y material técnico.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Cuánto se tarda en cambiar la configuración del aula?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Un grupo de alumnos puede reconfigurar el aula completa en menos de 2 minutos. Las mesas se entrelazan sin herramientas y las sillas se desplazan por su propio peso. El paso de filas a islas de seis alumnos toma unos 60 segundos.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las mesas soportan ordenadores portátiles y tablets?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. La melamina de alta presión soporta el peso de portátiles, tablets y libros sin marcas. Las superficies son antirrayas y resisten el uso diario. Se puede añadir una bandeja portátil bajo el tablero para guardar los equipos.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El sistema funciona en aulas de más de 40 alumnos?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El sistema se dimensiona según la superficie y el número de alumnos. Para aulas grandes se combinan agrupaciones de seis con zonas de trabajo individual, manteniendo siempre pasillos de circulación seguros para el docente.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/asientos-colaborativos-modulares-espacios-sociales-campus/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-03/esc-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Asientos Escolares</span>
            <h3>Asientos Colaborativos Modulares para Espacios Sociales del Campus</h3>
          </div>
        </a>
        <a href="/productos-escolares/estanterias-libreria-escolar-modulares-madera-e1/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-04/esc-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Biblioteca Escolar</span>
            <h3>Estanterías de Librería Escolar Modulares en Madera E1</h3>
          </div>
        </a>
        <a href="/productos-escolares/pupitres-escolares-flexibles-k12-aulas-modernas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-05/esc-05-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula K-12</span>
            <h3>Pupitres Escolares Flexibles K-12 para Aulas Modernas</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-02-mesas-modulares-espacio-estudio-compartido.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
