---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Estanterías Móviles Bibliotecas Escolares | Fabricante";
const pageDescription = "Estanterías móviles con ruedas para bibliotecas escolares y zonas de aprendizaje. Giro de 360 grados, rodamientos que no marcan el suelo y diseño curvo modular. Fabricación a medida.";
const canonicalUrl = "/productos-escolares/estanterias-moviles-bibliotecas-escolares-ruedas/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Estanterías Móviles para Bibliotecas Escolares con Ruedas",
    "description": "Estanterías móviles con ruedas para bibliotecas escolares y zonas de aprendizaje. Giro de 360 grados, rodamientos que no marcan el suelo y diseño curv",
    "category": "Biblioteca Móvil",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Estanterías Móviles para Bibliotecas Escolares con Ruedas"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Las estanterías móviles son estables cuando están cargadas?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, las ruedas incorporan frenos que se activan con un pedal y fijan la estantería de forma segura. La estructura con conectores de acero y el centro de gravedad bajo garantizan la estabilidad incluso con las baldas superiores cargadas."}}, {"@type": "Question", "name": "¿Se pueden usar sobre moqueta o alfombra?", "acceptedAnswer": {"@type": "Answer", "text": "Las ruedas de grado médico están diseñadas para suelos duros como vinilo, madera y microcemento. Para moqueta se pueden sustituir por ruedas de mayor diámetro bajo pedido, manteniendo la misma maniobrabilidad."}}, {"@type": "Question", "name": "¿Cuántas estanterías se necesitan para una biblioteca de 100 m²?", "acceptedAnswer": {"@type": "Answer", "text": "La cantidad depende del fondo bibliográfico y de la disposición elegida. Como referencia, una estantería de doble cara de 180 cm alberga entre 800 y 1.200 libros. El equipo técnico calcula la propuesta exacta con los planos de la sala."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Estanterías Móviles para Bibliotecas Escolares con Ruedas</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-08/esc-08-01.jpg" alt="Estanterías Móviles para Bibliotecas Escolares con Ruedas para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Estanterías Móviles para Bibliotecas Escolares con Ruedas</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-08/esc-08-01.jpg" alt="Estanterías Móviles para Bibliotecas Escolares con Ruedas vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-08/esc-08-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-08/esc-08-02.jpg" alt="Estanterías Móviles para Bibliotecas Escolares con Ruedas vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-08/esc-08-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-08/esc-08-03.jpg" alt="Estanterías Móviles para Bibliotecas Escolares con Ruedas vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-08/esc-08-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-08/esc-08-04.jpg" alt="Estanterías Móviles para Bibliotecas Escolares con Ruedas vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-08/esc-08-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Biblioteca Móvil</span>
        <h1>Estanterías Móviles para Bibliotecas Escolares con Ruedas</h1>
        <p class="producto-intro">Las estanterías móviles para bibliotecas escolares están diseñadas para los espacios de aprendizaje modernos. A diferencia de los estantes fijos, estas unidades sobre ruedas permiten reorganizar la biblioteca en minutos, adaptándose desde el estudio individual en silencio hasta los proyectos colaborativos de gran formato. Los acabados en madera se combinan con rodamientos de grado industrial que no marcan el suelo, y las formas curvas crean rincones de lectura semiprivados que reducen el ruido ambiental sin necesidad de paredes.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>Los rodamientos de giro de 360 grados permiten mover una estantería completamente cargada con un esfuerzo mínimo. Un solo miembro del personal convierte una sala llena de estanterías en un espacio de conferencias abierto en menos de diez minutos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las estanterías curvas modulares crean rincones de lectura semiprivados al colocarlas en forma de S o en grupos circulares. Esta disposición reduce el ruido ambiental un 25% y ofrece zonas de concentración profunda sin necesidad de obras ni tabiques.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Los rodamientos de grado médico no marcan ni rayan los suelos de vinilo, madera o microcemento de las bibliotecas. Las unidades soportan hasta 500 libras de carga y se desplazan sin esfuerzo incluso en pasillos estrechos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>La estructura de madera con conectores de acero soporta el uso intensivo de las zonas de aprendizaje con total estabilidad. Los frenos de las ruedas fijan la estantería de forma segura durante el uso diario y la consulta de libros.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>Cada proyecto de biblioteca escolar se planifica con la distribución de estanterías móviles, los recorridos de circulación y los puntos de descanso. El equipo técnico entrega planos y coordina la fabricación con el calendario del centro educativo.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Carga</th><th>Ruedas</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Estantería móvil simple</td><td>300 kg</td><td>Giro 360°</td><td>Aulas de lectura</td></tr><tr><td>Módulo curvo</td><td>500 libras</td><td>Grado médico</td><td>Zonas de aprendizaje</td></tr><tr><td>Grupo en S</td><td>500 libras</td><td>Con freno</td><td>Rincones de lectura</td></tr><tr><td>A medida</td><td>Configurable</td><td>Grado médico</td><td>Proyectos de centro</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Madera con conectores de acero</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Ruedas</td>
                            <td class="spec-value">Grado médico, giro 360°, no marcan el suelo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Capacidad</td>
                            <td class="spec-value">Hasta 500 libras por unidad</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Formas</td>
                            <td class="spec-value">Rectas y curvas modulares</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Alturas</td>
                            <td class="spec-value">900-2000 mm según modelo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Frenos</td>
                            <td class="spec-value">Integrados en las ruedas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, E1, EN 16121</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">10 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Mediateca escolar: estanterías móviles que liberan el centro de la sala para presentaciones y actividades extraescolares.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Biblioteca de instituto: módulos curvos que crean rincones de lectura semiprivados y zonas de trabajo en silencio.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Zona de aprendizaje polivalente: estanterías sobre ruedas que separan espacios por la mañana y se retiran para actos por la tarde.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las estanterías móviles son estables cuando están cargadas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, las ruedas incorporan frenos que se activan con un pedal y fijan la estantería de forma segura. La estructura con conectores de acero y el centro de gravedad bajo garantizan la estabilidad incluso con las baldas superiores cargadas.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se pueden usar sobre moqueta o alfombra?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Las ruedas de grado médico están diseñadas para suelos duros como vinilo, madera y microcemento. Para moqueta se pueden sustituir por ruedas de mayor diámetro bajo pedido, manteniendo la misma maniobrabilidad.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Cuántas estanterías se necesitan para una biblioteca de 100 m²?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>La cantidad depende del fondo bibliográfico y de la disposición elegida. Como referencia, una estantería de doble cara de 180 cm alberga entre 800 y 1.200 libros. El equipo técnico calcula la propuesta exacta con los planos de la sala.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/mobiliario-montessori-madera-aulas-diseno/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-09/esc-09-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mobiliario Montessori</span>
            <h3>Mobiliario Montessori en Madera para Aulas de Diseño</h3>
          </div>
        </a>
        <a href="/productos-escolares/pupitres-sillas-escolares-estructura-acero/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-10/esc-10-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Pupitres y Sillas</span>
            <h3>Pupitres y Sillas Escolares con Estructura de Acero</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-laboratorio-steam-robotica-proyectos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-11/esc-11-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula STEAM</span>
            <h3>Mobiliario para Laboratorio STEAM de Robótica y Proyectos</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-08-libreria-ruedas-rincon-lectura-hogar.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
