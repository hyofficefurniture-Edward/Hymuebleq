---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Jardín Infancia Madera Abedul | Fabricante";
const pageDescription = "Mobiliario para jardín de infancia en madera de abedul certificada FSC. Diseño biophilic, acabados sin VOC y sistemas modulares para aulas Montessori y Reggio Emilia.";
const canonicalUrl = "/productos-escolares/mobiliario-jardin-infancia-madera-abedul/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario para Jardín de Infancia en Madera de Abedul",
    "description": "Mobiliario para jardín de infancia en madera de abedul certificada FSC. Diseño biophilic, acabados sin VOC y sistemas modulares para aulas Montessori ",
    "category": "Jardín de Infancia",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario para Jardín de Infancia en Madera de Abedul"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿La madera de abedul es resistente a la limpieza con desinfectantes?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el barniz de poliuretano al agua con el que se sella la madera soporta la limpieza diaria con productos suaves y desinfectantes habituales. Se recomienda evitar lejías concentradas y productos abrasivos."}}, {"@type": "Question", "name": "¿Las estanterías se fijan a la pared?", "acceptedAnswer": {"@type": "Answer", "text": "Todas las estanterías de más de 80 cm de altura incluyen sistema de anclaje antivuelco. La fijación es sencilla y el equipo de montaje verifica la estabilidad de cada módulo tras la instalación."}}, {"@type": "Question", "name": "¿Qué diferencia a este mobiliario del de plástico?", "acceptedAnswer": {"@type": "Answer", "text": "La madera natural crea un ambiente cálido y reduce los contaminantes interiores. Además, el abedul es más resistente al desgaste, reparable y sostenible, ya que la madera certificada FSC proviene de bosques gestionados de forma responsable."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario para Jardín de Infancia en Madera de Abedul</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-07/esc-07-01.jpg" alt="Mobiliario para Jardín de Infancia en Madera de Abedul para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario para Jardín de Infancia en Madera de Abedul</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-07/esc-07-01.jpg" alt="Mobiliario para Jardín de Infancia en Madera de Abedul vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-07/esc-07-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-07/esc-07-02.jpg" alt="Mobiliario para Jardín de Infancia en Madera de Abedul vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-07/esc-07-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-07/esc-07-03.jpg" alt="Mobiliario para Jardín de Infancia en Madera de Abedul vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-07/esc-07-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-07/esc-07-04.jpg" alt="Mobiliario para Jardín de Infancia en Madera de Abedul vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-07/esc-07-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Jardín de Infancia</span>
        <h1>Mobiliario para Jardín de Infancia en Madera de Abedul</h1>
        <p class="producto-intro">El mobiliario para jardín de infancia en madera de abedul combina el minimalismo nórdico con la funcionalidad pedagógica. La colección utiliza contrachapado de abedul certificado FSC con acabados al agua sin compuestos volátiles, creando un ambiente natural que reduce el estrés y mejora la atención de los pequeños. Los sistemas modulares de mesas, estanterías y rincones de lectura se adaptan a las metodologías Montessori y Reggio Emilia, fomentando la independencia y la creatividad en los espacios de educación temprana.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El contrachapado de abedul certificado FSC con acabados al agua sin VOC reduce los contaminantes interiores del aula un 40% frente al mobiliario de plástico. La estética natural crea un ambiente de hogar que reduce la ansiedad y mejora la duración de la atención en los centros de educación temprana.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Los sistemas modulares de mesas permiten más de 15 configuraciones de aula distintas, pasando del trabajo individual al colaborativo en menos de tres minutos. Esta versatilidad hace del mobiliario de kindergarten una inversión a largo plazo para los proyectos escolares.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Cada pieza incorpora cantos redondeados por fresado CNC, eliminando aristas afiladas y reduciendo los accidentes en el aula un 30% frente al mobiliario estándar de plástico. La robustez de la madera soporta el uso intensivo de los grupos de infantil.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los rincones de lectura integrados y los centros de actividad modulares crean rincones de juego simbólico, lectura y manualidades dentro de la misma aula. Los módulos de madera natural se combinan con textiles suaves para crear espacios acogedores.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La colección se fabrica bajo pedido en las medidas y acabados de cada proyecto de kindergarten. El equipo técnico colabora en la planificación de los espacios de educación temprana, la selección de piezas y la entrega coordinada con el calendario de apertura del centro.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Madera</th><th>Metodología</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Aula básica</td><td>Abedul FSC</td><td>Estándar</td><td>Guarderías</td></tr><tr><td>Rincones de actividad</td><td>Abedul + textil</td><td>Montessori</td><td>Jardín de infancia</td></tr><tr><td>Aula modular</td><td>Abedul + tablero</td><td>Reggio Emilia</td><td>Centros de educación temprana</td></tr><tr><td>A medida</td><td>FSC certificado</td><td>Personalizada</td><td>Proyectos internacionales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Contrachapado de abedul certificado FSC</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Acabados</td>
                            <td class="spec-value">Barnices al agua sin VOC, no tóxicos</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cantos</td>
                            <td class="spec-value">Redondeados por fresado CNC, radio 8 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Módulos</td>
                            <td class="spec-value">Mesas, estanterías, rincones de lectura, centros de actividad</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Alturas</td>
                            <td class="spec-value">A medida de cada etapa (60-90 cm de estanterías)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">FSC, ISO 9001, EN 71-3, EN 16121</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">20 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">30-40 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Jardín de infancia Montessori: estanterías abiertas de 60-90 cm de altura al alcance del niño y mesas modulares para el trabajo autónomo por rincones.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Centro Reggio Emilia: rincones de lectura integrados y centros de actividad con material natural para fomentar la exploración sensorial.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Guardería corporativa: mobiliario de madera natural de fácil limpieza y alta resistencia para el cuidado de los hijos de los empleados.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿La madera de abedul es resistente a la limpieza con desinfectantes?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, el barniz de poliuretano al agua con el que se sella la madera soporta la limpieza diaria con productos suaves y desinfectantes habituales. Se recomienda evitar lejías concentradas y productos abrasivos.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Las estanterías se fijan a la pared?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Todas las estanterías de más de 80 cm de altura incluyen sistema de anclaje antivuelco. La fijación es sencilla y el equipo de montaje verifica la estabilidad de cada módulo tras la instalación.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué diferencia a este mobiliario del de plástico?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>La madera natural crea un ambiente cálido y reduce los contaminantes interiores. Además, el abedul es más resistente al desgaste, reparable y sostenible, ya que la madera certificada FSC proviene de bosques gestionados de forma responsable.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/estanterias-moviles-bibliotecas-escolares-ruedas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-08/esc-08-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Biblioteca Móvil</span>
            <h3>Estanterías Móviles para Bibliotecas Escolares con Ruedas</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-montessori-madera-aulas-diseno/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-09/esc-09-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Mobiliario Montessori</span>
            <h3>Mobiliario Montessori en Madera para Aulas de Diseño</h3>
          </div>
        </a>
        <a href="/productos-escolares/pupitres-sillas-escolares-estructura-acero/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-10/esc-10-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Pupitres y Sillas</span>
            <h3>Pupitres y Sillas Escolares con Estructura de Acero</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-07-muebles-infantiles-madera-habitacion-ninos.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
