---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Mobiliario Infantil Seguro Redondeado | Fabricante Escolar";
const pageDescription = "Mobiliario para educación infantil con cantos redondeados y materiales no tóxicos. Mesas redondas, almacenamiento colorido y asientos blandos. Fabricación a medida para colegios y guarderías.";
const canonicalUrl = "/productos-escolares/mobiliario-educacion-infantil-seguro-cantos-redondeados/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mobiliario para Educación Infantil Seguro con Cantos Redondeados",
    "description": "Mobiliario para educación infantil con cantos redondeados y materiales no tóxicos. Mesas redondas, almacenamiento colorido y asientos blandos. Fabrica",
    "category": "Educación Infantil",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Mobiliario para Educación Infantil Seguro con Cantos Redondeados"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Qué altura de mesa se recomienda para niños de 3 años?", "acceptedAnswer": {"@type": "Answer", "text": "Para niños de 3 a 4 años se recomienda una altura de asiento de 260 mm y mesa a 460 mm. Para niños de 5 a 6 años, asiento a 300 mm y mesa a 520 mm. Todas las medidas se ajustan en la fabricación según la edad del grupo."}}, {"@type": "Question", "name": "¿Los materiales son seguros si los niños se llevan las piezas a la boca?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Todos los acabados son no tóxicos, al agua y sin compuestos volátiles, con certificación EN 71-3 que regula la migración de elementos peligrosos en juguetes y mobiliario infantil. Las superficies son lisas y sin cantos afilados."}}, {"@type": "Question", "name": "¿Se puede pedir una sola aula completa o solo mesas?", "acceptedAnswer": {"@type": "Answer", "text": "Se fabrican tanto conjuntos completos de aula como piezas individuales. Para pedidos inferiores a 30 unidades se trabaja con precios de catálogo, y para proyectos de centro se ofrece presupuesto a medida con planos de distribución."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-01/esc-01-01.jpg" alt="Mobiliario para Educación Infantil Seguro con Cantos Redondeados para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-01/esc-01-01.jpg" alt="Mobiliario para Educación Infantil Seguro con Cantos Redondeados vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-01/esc-01-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-01/esc-01-02.jpg" alt="Mobiliario para Educación Infantil Seguro con Cantos Redondeados vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-01/esc-01-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-01/esc-01-03.jpg" alt="Mobiliario para Educación Infantil Seguro con Cantos Redondeados vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-01/esc-01-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-01/esc-01-04.jpg" alt="Mobiliario para Educación Infantil Seguro con Cantos Redondeados vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-01/esc-01-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Educación Infantil</span>
        <h1>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</h1>
        <p class="producto-intro">El mobiliario para educación infantil reúne mesas redondas, módulos de almacenamiento coloridos y asientos blandos pensados para los primeros años de aprendizaje. Cada pieza se diseña con cantos totalmente redondeados y superficies sin astillas para proteger a los niños durante el juego y la actividad diaria. Los materiales no tóxicos y sostenibles crean un entorno saludable donde los pequeños pueden aprender, relacionarse y moverse con confianza. La colección completa se adapta a aulas de guardería, centros de educación temprana y salas de juegos institucionales.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El diseño con el 100% de los cantos redondeados reduce los golpes y las magulladuras habituales en aulas de educación infantil. Cada mesa y banco pasa pruebas de estabilidad que evitan vuelcos durante el juego activo, cumpliendo las normas internacionales de seguridad para mobiliario escolar de primera infancia.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>La paleta de colores de los módulos de almacenamiento no es casual: los tonos vivos estimulan la atención y ayudan a los niños a aprender a clasificar y ordenar. Los baúles de colores primarios invitan a guardar juguetes y materiales, convirtiendo el orden en un hábito natural dentro de la rutina del aula infantil.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>Las mesas redondas de borde redondeado permiten configuraciones para cuentos, manualidades o juegos en grupo en pocos minutos. La forma circular favorece el contacto visual entre los pequeños y crea un ambiente colaborativo que refuerza las habilidades sociales en la educación temprana.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>Los materiales utilizados son no tóxicos, con acabados al agua sin compuestos volátiles y tableros con certificación E1. Las superficies lisas se limpian con facilidad con paños húmedos, lo que mantiene la higiene del aula y reduce el trabajo de mantenimiento del personal educativo.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>Cada proyecto de guardería o centro de educación infantil se adapta a la superficie disponible y al número de alumnos. El departamento técnico propone la distribución óptima del aula, entrega planos y fabrica las piezas a medida en los acabados que solicite la institución.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Configuración</th><th>Seguridad</th><th>Material</th><th>Uso recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td>Mesas redondas básicas</td><td>Cantos redondeados</td><td>MDF E1 no tóxico</td><td>Guarderías y preescolar</td></tr><tr><td>Rincón de cuentos</td><td>Antivuelco certificado</td><td>Abedul contrachapado</td><td>Aulas de 2 a 4 años</td></tr><tr><td>Aula modular completa</td><td>Pruebas de estabilidad</td><td>Tablero melamínico</td><td>Centros de educación temprana</td></tr><tr><td>A medida</td><td>Norma EN 16121</td><td>Acabados al agua</td><td>Proyectos institucionales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Tablero MDF E1 con acabados no tóxicos al agua</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesas redondas</td>
                            <td class="spec-value">Diámetro 800-1000 mm, altura 460-520 mm según edad</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Almacenamiento</td>
                            <td class="spec-value">Baúles y módulos con guías de cierre suave</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Asientos blandos</td>
                            <td class="spec-value">Espuma de alta densidad, funda lavable desmontable</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cantos</td>
                            <td class="spec-value">100% redondeados, radio 5 mm, sin astillas</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Colores</td>
                            <td class="spec-value">Paleta viva con tonos primarios (personalizable)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, EN 16121, EN 71-3 (seguridad infantil)</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">30 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Aula de guardería: conjunto de mesas redondas, baúles de colores y asientos blandos para actividades guiadas, juego libre y alimentación en grupos reducidos.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Centro de educación temprana: distribución modular que alterna rincones de lectura, manualidades y juego simbólico para estimular el desarrollo sensorial y motor.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Salas de juegos institucionales: mobiliario de alta resistencia para uso intensivo en ludotecas, asociaciones y espacios comunitarios para la primera infancia.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué altura de mesa se recomienda para niños de 3 años?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Para niños de 3 a 4 años se recomienda una altura de asiento de 260 mm y mesa a 460 mm. Para niños de 5 a 6 años, asiento a 300 mm y mesa a 520 mm. Todas las medidas se ajustan en la fabricación según la edad del grupo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los materiales son seguros si los niños se llevan las piezas a la boca?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí. Todos los acabados son no tóxicos, al agua y sin compuestos volátiles, con certificación EN 71-3 que regula la migración de elementos peligrosos en juguetes y mobiliario infantil. Las superficies son lisas y sin cantos afilados.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Se puede pedir una sola aula completa o solo mesas?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Se fabrican tanto conjuntos completos de aula como piezas individuales. Para pedidos inferiores a 30 unidades se trabaja con precios de catálogo, y para proyectos de centro se ofrece presupuesto a medida con planos de distribución.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/mobiliario-modular-aprendizaje-colaborativo-aulas/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-02/esc-02-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula Flexible</span>
            <h3>Mobiliario Modular para Aprendizaje Colaborativo en Aulas</h3>
          </div>
        </a>
        <a href="/productos-escolares/asientos-colaborativos-modulares-espacios-sociales-campus/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-03/esc-03-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Asientos Escolares</span>
            <h3>Asientos Colaborativos Modulares para Espacios Sociales del Campus</h3>
          </div>
        </a>
        <a href="/productos-escolares/estanterias-libreria-escolar-modulares-madera-e1/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-04/esc-04-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Biblioteca Escolar</span>
            <h3>Estanterías de Librería Escolar Modulares en Madera E1</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-01-muebles-aula-infantil-casa-coloridos-seguros.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
