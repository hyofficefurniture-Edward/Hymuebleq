---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Pupitres y Sillas Escolares Acero | Fabricante";
const pageDescription = "Pupitres y sillas escolares con estructura de acero de 1,5 mm y tablero de fibra de alta densidad. Diseño ergonómico y formas que se agrupan para el aprendizaje colaborativo.";
const canonicalUrl = "/productos-escolares/pupitres-sillas-escolares-estructura-acero/";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Pupitres y Sillas Escolares con Estructura de Acero",
    "description": "Pupitres y sillas escolares con estructura de acero de 1,5 mm y tablero de fibra de alta densidad. Diseño ergonómico y formas que se agrupan para el a",
    "category": "Pupitres y Sillas",
    "brand": {"@type": "Brand", "name": "HYMUEBLE"},
    "manufacturer": {"@type": "Organization", "name": "Hongye Furniture Group Co., Ltd."},
    "offers": {"@type": "Offer", "availability": "https://schema.org/InStock", "priceSpecification": {"@type": "PriceSpecification", "price": "Consultar", "priceCurrency": "USD"}}
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://hymueble.com/"},
      {"@type": "ListItem", "position": 2, "name": "Mobiliario Escolar", "item": "https://hymueble.com/productos-escolares/"},
      {"@type": "ListItem", "position": 3, "name": "Pupitres y Sillas Escolares con Estructura de Acero"}
    ]
  })}>
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type": "Question", "name": "¿Qué talla de pupitre corresponde a cada edad?", "acceptedAnswer": {"@type": "Answer", "text": "Se recomienda mesa de 580 mm y silla de 340 mm para 6-8 años; mesa de 640 mm y silla de 380 mm para 9-12 años; mesa de 700 mm y silla de 430 mm para 13-15 años; y mesa de 760 mm con silla de 460 mm para mayores de 16 años."}}, {"@type": "Question", "name": "¿Los pupitres se pueden encadenar entre sí?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, los pupitres rectangulares y trapezoidales se encadenan mediante enganches laterales para formar filas estables durante los exámenes. Los enganches se retiran cuando el aula necesita configuraciones de trabajo en grupo."}}, {"@type": "Question", "name": "¿El conjunto incluye el banco o la silla separada?", "acceptedAnswer": {"@type": "Answer", "text": "El conjunto incluye mesa y silla separadas. Para aulas de infantil ofrecemos bancos corridos, mientras que para primaria y secundaria se recomienda la silla individual por su mayor ergonomía y facilidad de movimiento."}}]
  })}>
  </script>

  <article class="producto-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-container">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/productos-escolares/">Mobiliario Escolar</a>
        <span aria-hidden="true">›</span>
        <span>Pupitres y Sillas Escolares con Estructura de Acero</span>
      </div>
    </nav>

    <!-- Product Hero -->
    <div class="producto-hero">
      <div class="producto-gallery">
        <div class="gallery-main">
          <img class="gallery-main-img" src="/images/productos-escolares/esc-10/esc-10-01.jpg" alt="Pupitres y Sillas Escolares con Estructura de Acero para aulas y proyectos educativos" loading="eager" width="600" height="600">
          <div class="gallery-main-content" style="display:none"><h4>Pupitres y Sillas Escolares con Estructura de Acero</h4>
            <p>Imagen principal del producto — 4 vistas disponibles</p>
          </div>
        </div>
        <div class="gallery-thumbs">
          <div class="gallery-thumb active"><img src="/images/productos-escolares/esc-10/esc-10-01.jpg" alt="Pupitres y Sillas Escolares con Estructura de Acero vista 1" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-10/esc-10-01.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-10/esc-10-02.jpg" alt="Pupitres y Sillas Escolares con Estructura de Acero vista 2" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-10/esc-10-02.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-10/esc-10-03.jpg" alt="Pupitres y Sillas Escolares con Estructura de Acero vista 3" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-10/esc-10-03.jpg'"></div><div class="gallery-thumb"><img src="/images/productos-escolares/esc-10/esc-10-04.jpg" alt="Pupitres y Sillas Escolares con Estructura de Acero vista 4" loading="lazy" width="120" height="120" onclick="document.querySelector('.gallery-main-img').src='/images/productos-escolares/esc-10/esc-10-04.jpg'"></div>
        </div>
      </div>

      <div class="producto-info">
        <span class="producto-categoria">Pupitres y Sillas</span>
        <h1>Pupitres y Sillas Escolares con Estructura de Acero</h1>
        <p class="producto-intro">El conjunto de pupitres y sillas escolares con estructura de acero está diseñado para soportar el uso diario de un centro educativo. El tablero de fibra de alta densidad con acabado en veta de madera se combina con un bastidor de acero laminado en frío de 1,5 mm, garantizando una durabilidad prolongada en aulas de gran afluencia. Las sillas con respaldo contorneado cuidan la postura del alumno, y las formas trapezoidal y rectangular de las mesas permiten pasar de filas tradicionales a grupos colaborativos en menos de dos minutos.</p>
        <div class="producto-cta-group">
          <a href="/contacto/" class="btn-primary">📋 Solicitar cotización</a>
          <a href="/contacto/" class="btn-secondary">📞 Contactar ventas</a>
        </div>
      </div>
    </div>

    <!-- Ventajas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Ventajas del producto</h2>
        <div class="ventajas-grid">
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🛡️</div>
                        <div class="ventaja-content">
                            <p>El respaldo contorneado de la silla se adapta a la curvatura natural de la columna y reduce la fatiga en las sesiones largas. Los estudios muestran que el mobiliario escolar ergonómico aumenta la concentración de los alumnos hasta un 25% y previene problemas posturales.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">📐</div>
                        <div class="ventaja-content">
                            <p>Las mesas trapezoidales y rectangulares se agrupan sin huecos para formar islas de trabajo colaborativo. El paso de filas a grupos se realiza en menos de dos minutos, convirtiendo el aula en el espacio adecuado para STEAM y el aprendizaje por proyectos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🔧</div>
                        <div class="ventaja-content">
                            <p>El bastidor de acero laminado en frío de 1,5 mm con recubrimiento en polvo soporta los golpes y el uso intensivo sin doblarse ni perder el acabado. Los protectores de las patas evitan el desgaste del suelo y reducen el ruido al mover las mesas.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">🎨</div>
                        <div class="ventaja-content">
                            <p>El tablero de fibra de alta densidad con veta de madera resiste rayones, derrames y la limpieza con desinfectantes habituales. Los cantos ABS sellados evitan la entrada de humedad y los bordes redondeados protegen a los alumnos.</p>
                        </div>
                    </div>
                    <div class="ventaja-item">
                        <div class="ventaja-icon">⚙️</div>
                        <div class="ventaja-content">
                            <p>La colección cubre todas las etapas escolares con tallas graduadas de mesa y silla. El rango de alturas se adapta desde educación primaria hasta bachillerato, y los pedidos se fabrican a medida para proyectos de centros completos.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- SEO Table -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Comparativa de configuraciones</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <thead>
              <tr><th>Tipo</th><th>Estructura</th><th>Tablero</th><th>Aplicación</th></tr>
            </thead>
            <tbody>
              <tr><td>Pupitre individual</td><td>Acero 1,5 mm</td><td>HDF 18 mm</td><td>Aulas de primaria</td></tr><tr><td>Mesa trapezoidal</td><td>Acero 1,5 mm</td><td>HDF con veta</td><td>Aprendizaje colaborativo</td></tr><tr><td>Silla ergonómica</td><td>Acero 1,5 mm</td><td>Contrachapado</td><td>Aulas estándar</td></tr><tr><td>A medida</td><td>Configurable</td><td>Personalizable</td><td>Proyectos de centro</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Especificaciones técnicas -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Especificaciones técnicas</h2>
        <div class="specs-wrapper">
          <table class="specs-table">
            <tbody>
                        <tr>
                            <td class="spec-label">Material principal</td>
                            <td class="spec-value">Tablero HDF 18 mm con veta de madera, bastidor de acero 1,5 mm</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Mesas</td>
                            <td class="spec-value">Trapezoidales y rectangulares, 650 × 450 mm superficie útil</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Sillas</td>
                            <td class="spec-value">Respaldo contorneado, estructura de acero con recubrimiento en polvo</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Cantos</td>
                            <td class="spec-value">ABS 2 mm sellados, bordes redondeados</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Protectores</td>
                            <td class="spec-value">Patas con protectores antirruido y antidesgaste</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Tallas</td>
                            <td class="spec-value">Graduadas para primaria, secundaria y bachillerato</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Certificaciones</td>
                            <td class="spec-value">ISO 9001, EN 16121, CE</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Pedido mínimo</td>
                            <td class="spec-value">40 unidades</td>
                        </tr>
                        <tr>
                            <td class="spec-label">Plazo fabricación</td>
                            <td class="spec-value">25-35 días laborables</td>
                        </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Aplicaciones en proyectos escolares</h2>
        <div class="usos-grid">
                        <div class="uso-card">
                            <span class="uso-num">01</span>
                            <p>Aula de primaria: pupitres individuales con talla adecuada que se agrupan en islas para el trabajo por proyectos.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">02</span>
                            <p>Aula de secundaria: mesas trapezoidales que se combinan para el trabajo colaborativo y los exámenes individuales.</p>
                        </div>
                        <div class="uso-card">
                            <span class="uso-num">03</span>
                            <p>Centro de formación y academia: conjunto resistente para uso intensivo con superficies de fácil limpieza.</p>
                        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Qué talla de pupitre corresponde a cada edad?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Se recomienda mesa de 580 mm y silla de 340 mm para 6-8 años; mesa de 640 mm y silla de 380 mm para 9-12 años; mesa de 700 mm y silla de 430 mm para 13-15 años; y mesa de 760 mm con silla de 460 mm para mayores de 16 años.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿Los pupitres se pueden encadenar entre sí?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Sí, los pupitres rectangulares y trapezoidales se encadenan mediante enganches laterales para formar filas estables durante los exámenes. Los enganches se retiran cuando el aula necesita configuraciones de trabajo en grupo.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>¿El conjunto incluye el banco o la silla separada?</span>
                            <span class="faq-arrow">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>El conjunto incluye mesa y silla separadas. Para aulas de infantil ofrecemos bancos corridos, mientras que para primaria y secundaria se recomienda la silla individual por su mayor ergonomía y facilidad de movimiento.</p>
                        </div>
                    </div>
        </div>
      </div>
    </section>

    <!-- Productos relacionados -->
    <section class="section">
      <div class="content-container">
        <h2 class="section-title">Productos relacionados</h2>
        <div class="related-grid">
        <a href="/productos-escolares/mobiliario-laboratorio-steam-robotica-proyectos/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-11/esc-11-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Aula STEAM</span>
            <h3>Mobiliario para Laboratorio STEAM de Robótica y Proyectos</h3>
          </div>
        </a>
        <a href="/productos-escolares/atril-podio-docente/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-12/esc-12-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Podio Docente</span>
            <h3>Atril y Podio para Docente de Madera con Altura Regulable</h3>
          </div>
        </a>
        <a href="/productos-escolares/mobiliario-educacion-infantil-seguro-cantos-redondeados/" class="producto-card-mini">
          <div class="card-mini-img" style="background-image: url(/images/productos-escolares/esc-01/esc-01-01.jpg)"></div>
          <div class="card-mini-info">
            <span class="card-mini-cat">Educación Infantil</span>
            <h3>Mobiliario para Educación Infantil Seguro con Cantos Redondeados</h3>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- Cross-domain link -->
    <section class="section cross-domain-link">
      <div class="content-container">
        <p>Este producto también está disponible en versión hogar en nuestra tienda online: <a href="https://hymobiliario.com/recursos/productos-escolares/esc-10-conjunto-mesa-silla-estudio-ergonomico-ninos.html" rel="noopener" target="_blank">Ver versión residencial →</a></p>
      </div>
    </section>

    <!-- CTA final -->
    <section class="cta-section">
      <div class="content-container">
        <h2>Solicite una cotización para su proyecto educativo</h2>
        <p>Respondemos en menos de 24 horas con presupuesto detallado, planos técnicos y muestras de materiales.</p>
        <a href="/contacto/" class="btn-primary">📋 Solicitar cotización ahora</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .producto-page { font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif); color: var(--color-text, #2C2416); background: var(--color-bg, #FDFCF9); line-height: 1.7; }
  .breadcrumb { background: var(--color-surface, #FFFFFF); border-bottom: 1px solid var(--color-border, #E8E3D9); padding: 12px 0; }
  .breadcrumb-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-light, #6B6358); }
  .breadcrumb a { color: var(--color-text-light, #6B6358); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary, #1a3a5c); }
  .breadcrumb span { color: var(--color-text, #2C2416); font-weight: 500; }
  .producto-hero { max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .gallery-main { background: #EEF0F3; border-radius: 8px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .gallery-main-img { width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .gallery-thumb { width: 72px; height: 54px; background: #EEF0F3; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; }
  .gallery-thumb:hover, .gallery-thumb.active { border-color: var(--color-accent, #c9a962); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .producto-info h1 { font-size: 32px; line-height: 1.25; color: var(--color-text, #2C2416); margin-bottom: 12px; letter-spacing: -0.3px; }
  .producto-categoria { display: inline-block; background: #EEF0F3; color: var(--color-primary, #1a3a5c); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 100px; margin-bottom: 16px; }
  .producto-intro { font-size: 16px; color: var(--color-text-light, #6B6358); line-height: 1.8; margin-bottom: 24px; }
  .producto-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--color-primary, #1a3a5c); color: #fff; border: none; padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .btn-primary:hover { background: #142d4a; }
  .btn-secondary { background: var(--color-surface, #FFFFFF); color: var(--color-primary, #1a3a5c); border: 2px solid var(--color-border, #E8E3D9); padding: 14px 32px; font-size: 15px; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-secondary:hover { border-color: var(--color-primary, #1a3a5c); }
  .content-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 48px 0; border-top: 1px solid var(--color-border, #E8E3D9); }
  .section-title { font-size: 24px; color: var(--color-text, #2C2416); margin-bottom: 28px; letter-spacing: -0.2px; }
  .ventajas-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ventaja-item { display: flex; gap: 16px; align-items: flex-start; padding: 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); }
  .ventaja-icon { font-size: 28px; flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #EEF0F3; border-radius: 8px; }
  .ventaja-content p { font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .specs-wrapper { background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .specs-table th { padding: 14px 20px; background: #f5f5f3; text-align: left; font-weight: 600; color: var(--color-text, #2C2416); border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .specs-table td { padding: 14px 20px; border-bottom: 1px solid var(--color-border, #E8E3D9); }
  .spec-label { font-weight: 600; color: var(--color-text, #2C2416); width: 30%; }
  .spec-value { color: var(--color-text-light, #6B6358); }
  .usos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uso-card { padding: 28px 24px; background: var(--color-surface, #FFFFFF); border-radius: 8px; box-shadow: 0 2px 12px rgba(44,36,22,0.06); position: relative; }
  .uso-num { font-size: 36px; color: #D8DDE3; font-weight: bold; line-height: 1; margin-bottom: 12px; display: block; }
  .uso-card p { font-size: 14px; color: var(--color-text-light, #6B6358); line-height: 1.7; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border: 1px solid var(--color-border, #E8E3D9); border-radius: 8px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
  .faq-question { width: 100%; background: none; border: none; padding: 18px 24px; font-size: 15px; font-weight: 600; color: var(--color-text, #2C2416); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-arrow { font-size: 20px; font-weight: 300; color: var(--color-text-light, #6B6358); transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-arrow { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-item.open .faq-answer { max-height: 500px; }
  .faq-answer p { padding: 0 24px 18px; font-size: 14.5px; color: var(--color-text-light, #6B6358); line-height: 1.75; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .producto-card-mini { text-decoration: none; color: inherit; display: block; background: var(--color-surface, #FFFFFF); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(44,36,22,0.06); transition: transform 0.2s, box-shadow 0.2s; }
  .producto-card-mini:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(44,36,22,0.12); }
