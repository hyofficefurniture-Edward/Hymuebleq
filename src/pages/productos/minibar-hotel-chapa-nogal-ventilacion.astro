---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
const data = {"title": "Mueble para zona de minibar hotelero", "description": "Referencia de selección para compra hotelera: alcance, planos y requisitos por confirmar para el modelo elegido.", "route": "/productos/minibar-hotel-chapa-nogal-ventilacion/", "reference": "minibar-hotel-chapa-nogal-ventilacion", "sections": [{"heading": "Definir el uso y el alcance", "text": "Defina si la solicitud incluye únicamente el mueble o también el aparato. Entregue las dimensiones verificadas del equipo seleccionado y su documentación de ventilación, acceso y mantenimiento antes de diseñar el alojamiento."}, {"heading": "Verificar las interfaces técnicas", "text": "Coordine el acceso a conexiones y la apertura de puertas con el plano del fabricante del aparato. La referencia de mobiliario no demuestra capacidad frigorífica, consumo, aislamiento acústico ni requisitos eléctricos."}, {"heading": "Confirmar materiales y muestras", "text": "Solicite una ficha identificable de la pieza propuesta, dibujos dimensionados y muestras antes de comparar ofertas. Materiales, acabados, prestaciones y certificados deben corresponder al modelo y a la configuración cotizados. Esta página no asigna un código de fabricante ni acredita esas características."}, {"heading": "Preparar una consulta comparable", "text": "Envíe cantidades, destino, planos disponibles y responsabilidades de transporte, descarga y montaje. Precio, disponibilidad y calendario se acuerdan en una propuesta de proyecto; no se publican como stock ni como plazo garantizado en esta referencia."}], "faq": [{"q": "¿Esta página identifica un modelo o SKU de fabricante?", "a": "No. Es una referencia de selección para un proyecto. La propuesta debe identificar la pieza y adjuntar la documentación verificable del modelo elegido."}, {"q": "¿Qué información necesito para solicitar una propuesta?", "a": "Comparta plano, cantidades, destino y alcance deseado. Las especificaciones, muestras y condiciones de suministro se confirman para esa solicitud."}]};
---
<BaseLayout title={data.title+' | Selección B2B Hymueble'} description={data.description} canonicalPath={data.route}>
<main class="selection-review"><div class="wrap"><p><a href="/productos/">Productos</a> · <a href="/catalogo/hoteles/">Catálogo hotelero</a></p><h1>{data.title}</h1><p class="selection-status">Referencia de selección · especificaciones del modelo por confirmar</p><p>Esta página ayuda a preparar una compra para un proyecto hotelero. No identifica por sí sola un modelo de fábrica. Las imágenes y especificaciones de la versión anterior no se muestran mientras no se complete su trazabilidad para esta referencia.</p>
{data.sections.map(s=><section><h2>{s.heading}</h2><p>{s.text}</p></section>)}
<section><h2>Preguntas para la compra</h2>{data.faq.map(f=><details class="product-faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
<p><a href="/hoteles/">Planificar un proyecto hotelero</a> · <a href="/proyectos/biblioteca/hos-015/">Referencia hotelera en China</a> · <a href="/proyectos/biblioteca/hos-017/">Referencia hotelera en Kinshasa</a></p><p>Los casos muestran contextos de proyecto; no prueban que esta selección concreta se haya suministrado en ellos.</p>
<section id="consulta-producto"><h2>Consultar esta selección</h2><ContactForm compact={true} idPrefix={'selection-'+data.reference}/></section></div></main>
<script define:vars={{reference:data.reference}}>document.querySelectorAll('.selection-review form.project-form').forEach(form=>{let input=document.createElement('input');input.type='hidden';input.name='product_reference';input.value=reference;form.appendChild(input)});</script>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebPage',name:data.title,description:data.description,url:'https://hymueble.com'+data.route,inLanguage:'es'})}/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:data.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})}/>
<style>.selection-review{padding:48px 0}.selection-review .wrap{max-width:1100px;margin:auto;padding:0 24px}.selection-review h1{overflow-wrap:anywhere}.selection-review section{margin:32px 0}.selection-review p{line-height:1.7}.selection-review details{padding:12px 0}.selection-status{font-weight:700}</style>
<style is:global>@media(min-width:1081px) and (max-width:1440px){.header .showroom-nav{display:none}.header .nav-shell{gap:12px}.header .nav-link{padding-inline:8px}}</style>
</BaseLayout>
