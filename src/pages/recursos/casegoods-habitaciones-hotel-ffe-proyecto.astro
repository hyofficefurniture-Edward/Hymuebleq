      "@type": "ImageObject",
      url: "https://hymueble.com/assets/hymueble/brand/hongye-shengda-logo.webp",
    },
  },
  image: ["https://hymueble.com/assets/hymueble/recursos/blog/images/hymD17-a234-hero.webp",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/d17a2-a234-s1.jpg",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/d17a2-a234-s2.jpg"],
  datePublished,
