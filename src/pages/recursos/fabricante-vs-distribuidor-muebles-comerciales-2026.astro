---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

const pageTitle = "Fabricante vs. distribuidor de muebles: guía B2B 2026";
const pageDescription = "Compare compra directa y distribución local por costos, plazos, control de calidad y gestión. Incluye un escenario orientativo para proyectos B2B.";
const keywords = [
  "fabricante vs distribuidor muebles",
  "comprar muebles directo de fábrica",
  "distribuidor de muebles B2B",
  "comparar proveedores de mobiliario",
  "importar muebles de China",
  "costo entregado de muebles",
  "HYMUEBLE",
];
const canonicalPath = "/recursos/fabricante-vs-distribuidor-muebles-comerciales-2026/";
const pageImage = "/assets/hymueble/recursos/blog/images/hym-04-img-01-linea-produccion-fabrica.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-07-20";
const dateModified = "2026-08-02";
const publicationDateLabel = "Actualizada el 2 de agosto de 2026";

const faqItems = [
  {
    question: "¿Comprar directamente al fabricante siempre cuesta menos?",
    answer: "No. El precio de fábrica puede ser menor, pero la comparación debe incluir inspección, agente si se utiliza, flete, seguro, aduana, transporte interno, montaje y tiempo del equipo comprador. El resultado depende del volumen, la personalización y la capacidad de gestionar la importación.",
  },
  {
    question: "¿Qué pedido mínimo exige un fabricante?",
    answer: "No existe un mínimo universal. Para preparar el presupuesto puede modelar un escenario de medio contenedor o entre 8,000 y 12,000 USD, pero el mínimo real debe confirmarse por producto, mezcla de referencias y calendario de producción.",
  },
  {
    question: "¿Un distribuidor puede ofrecer muebles personalizados?",
    answer: "Depende del modelo. Un representante o intermediario que trabaja contra pedido puede coordinar personalización; un distribuidor local que vende inventario suele limitarse a su catálogo disponible. La oferta debe identificar quién aprueba planos, muestras y cambios.",
  },
  {
    question: "¿Quién responde si aparecen defectos?",
    answer: "La responsabilidad depende del contrato. En compra directa se reclama a la entidad que fabrica y factura; con un intermediario o distribuidor, la reclamación sigue la cadena contractual acordada. Defina antes del pedido los criterios de aceptación, la inspección, la garantía, las exclusiones y el método de compensación.",
  },
  {
    question: "¿Necesito un agente de compras en China?",
    answer: "No es obligatorio. Un escenario de cálculo puede reservar entre 3% y 7% para ese servicio, pero la decisión depende de la experiencia del comprador, el número de fábricas, la complejidad técnica y el nivel de supervisión requerido. Solicite alcance y tarifa por escrito.",
  },
  {
    question: "¿Qué documentos debo pedir antes del embarque?",
    answer: "Como base, revise factura proforma, lista de empaque, fichas técnicas, planos aprobados, informe de inspección y documentos de origen o conformidad que correspondan al producto y al destino. ISO 9001 es un sistema de gestión; CARB o BS 5852 solo se solicitan cuando el material, producto y mercado los hacen aplicables.",
  },
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  author: {
    "@type": "Organization",
    name: "Hymueble",
    url: "https://hymueble.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Hymueble",
    logo: {
      "@type": "ImageObject",
      url: "https://hymueble.com/assets/hymueble/brand/hongye-shengda-logo.webp",
    },
  },
  image: [pageImageUrl],
  datePublished,
  dateModified,
  mainEntityOfPage: { "@type": "WebPage", "@id": "https://hymueble.com" + canonicalPath },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  canonicalPath={canonicalPath}
  image={pageImage}
  type="article"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)}></script>

  <div class="comparison-guide">
    <section class="section article-hero">
      <div class="container resource-hero-grid" style="align-items:center;">
        <div class="resource-hero-copy">
          <p class="eyebrow">Comparativa B2B &middot; {publicationDateLabel}</p>
          <h1>Fabricante vs. distribuidor: cómo elegir para un proyecto de mobiliario</h1>
          <p>La decisión no es simplemente “precio bajo contra servicio”. Cada ruta cambia quién define el producto, controla la calidad, coordina la importación y responde contractualmente cuando algo no coincide.</p>
          <p>Esta guía separa los modelos y conserva un escenario numérico para mostrar cómo calcular el costo entregado. <strong>Las cifras son supuestos de planificación, no un proyecto real, una cotización ni una promesa de ahorro.</strong></p>
        </div>
        <figure class="resource-hero-media">
          <img src="/assets/hymueble/recursos/blog/images/hym-04-img-01-linea-produccion-fabrica.webp" alt="Ilustración conceptual de compra directa a fábrica y compra mediante distribución local" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" />
          <figcaption>Ilustración conceptual generada con IA; no representa una fábrica, un distribuidor ni un proyecto específico de HYMUEBLE.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section alt article-section">
      <div class="container article-prose">
        <h2>Tres rutas que suelen confundirse</h2>
        <h3>1. Compra directa al fabricante</h3>
        <p>La fábrica cotiza y factura el producto. El comprador aprueba especificaciones y muestras, define la inspección y coordina la importación con su propio equipo o proveedores logísticos. Esta ruta da acceso directo a decisiones técnicas, pero exige más gestión.</p>

        <h3>2. Intermediario o empresa comercial en China</h3>
        <p>La empresa comercial coordina una o varias fábricas, consolida categorías o presta apoyo de compras. Puede facturar el pedido o cobrar una tarifa separada. El contrato debe aclarar quién fabrica, quién inspecciona y quién responde por cada producto.</p>

        <h3>3. Importador o distribuidor local</h3>
        <p>El proveedor vende en el país de destino, desde inventario o contra pedido. Puede simplificar aduana, entrega y atención local, pero su capacidad de personalización depende de la relación que tenga con la fábrica y del momento en que se incorpore al proyecto.</p>
      </div>
    </section>

    <section class="section article-section">
      <div class="container article-prose--wide">
        <h2>Comparación práctica: qué cambia en cada ruta</h2>
        <div class="methodology-table">
          <table>
            <thead>
              <tr><th>Criterio</th><th>Fabricante directo</th><th>Intermediario en China</th><th>Distribuidor local</th></tr>
            </thead>
            <tbody>
              <tr><td data-label="Criterio">Entidad que factura</td><td data-label="Fabricante">La fábrica</td><td data-label="Intermediario">El intermediario o cada fábrica</td><td data-label="Distribuidor">La empresa local</td></tr>
              <tr><td data-label="Criterio">Personalización</td><td data-label="Fabricante">Se define directamente con producción</td><td data-label="Intermediario">Depende de su control sobre la fábrica</td><td data-label="Distribuidor">Puede limitarse al catálogo o stock</td></tr>
              <tr><td data-label="Criterio">Pedido mínimo</td><td data-label="Fabricante">Se confirma por línea y mezcla</td><td data-label="Intermediario">Puede consolidar varias categorías</td><td data-label="Distribuidor">Puede vender cantidades menores desde stock</td></tr>
              <tr><td data-label="Criterio">Plazo</td><td data-label="Fabricante">Producción más tránsito</td><td data-label="Intermediario">Producción, consolidación y tránsito</td><td data-label="Distribuidor">Rápido con stock; variable contra pedido</td></tr>
              <tr><td data-label="Criterio">Control de calidad</td><td data-label="Fabricante">El comprador define acceso e inspección</td><td data-label="Intermediario">Puede coordinar inspección de varias fábricas</td><td data-label="Distribuidor">Debe explicar su control antes de entregar</td></tr>
              <tr><td data-label="Criterio">Importación</td><td data-label="Fabricante">A cargo del comprador salvo alcance acordado</td><td data-label="Intermediario">Puede coordinar documentos y embarque</td><td data-label="Distribuidor">Normalmente integrada en su oferta local</td></tr>
              <tr><td data-label="Criterio">Montaje y garantía</td><td data-label="Fabricante">Se cotizan y contratan por proyecto</td><td data-label="Intermediario">Debe identificar al responsable</td><td data-label="Distribuidor">Puede ofrecer recursos locales; debe constar en contrato</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section alt article-section">
      <div class="container article-prose--wide">
        <h2>Escenario orientativo de costo entregado</h2>
        <p>El siguiente cálculo conserva un proyecto tipo de 90 habitaciones en América Latina. Compara compra directa con una empresa comercial en China que aplica un 30% sobre el valor del producto. Para mantener una base coherente, el ejemplo calcula el arancel supuesto del 15% sobre el valor facturado en cada ruta.</p>
        <div class="methodology-table">
          <table>
            <thead>
              <tr><th>Concepto</th><th>Fabricante directo</th><th>Intermediario en China</th><th>Supuesto utilizado</th></tr>
            </thead>
            <tbody>
              <tr><td data-label="Concepto">Producto FOB</td><td data-label="Fabricante">$85,000</td><td data-label="Intermediario">$110,500</td><td data-label="Supuesto">30% sobre el producto</td></tr>
              <tr><td data-label="Concepto">Inspección</td><td data-label="Fabricante">$1,200</td><td data-label="Intermediario">$0 separado</td><td data-label="Supuesto">Incluida en la tarifa del intermediario</td></tr>
              <tr><td data-label="Concepto">Agente de compras</td><td data-label="Fabricante">$4,250</td><td data-label="Intermediario">$0 separado</td><td data-label="Supuesto">5% en la ruta directa</td></tr>
              <tr><td data-label="Concepto">Flete marítimo y seguro</td><td data-label="Fabricante">$4,800</td><td data-label="Intermediario">$4,800</td><td data-label="Supuesto">Misma ruta y volumen</td></tr>
              <tr><td data-label="Concepto">Arancel de ejemplo</td><td data-label="Fabricante">$12,750</td><td data-label="Intermediario">$16,575</td><td data-label="Supuesto">15% del valor FOB facturado</td></tr>
              <tr><td data-label="Concepto">Transporte interno</td><td data-label="Fabricante">$1,500</td><td data-label="Intermediario">$1,200</td><td data-label="Supuesto">Cotización logística de referencia</td></tr>
              <tr><td data-label="Concepto">Tiempo interno del comprador</td><td data-label="Fabricante">$3,000</td><td data-label="Intermediario">$800</td><td data-label="Supuesto">Valor interno asignado a la gestión</td></tr>
              <tr><td data-label="Concepto">Total del escenario</td><td data-label="Fabricante"><strong>$112,500</strong></td><td data-label="Intermediario"><strong>$133,875</strong></td><td data-label="Supuesto"><strong>Diferencia: $21,375, aproximadamente 16.0%</strong></td></tr>
            </tbody>
          </table>
        </div>
        <p><small>Este ejercicio no incluye todas las variables posibles y no constituye una cotización. El arancel, la base aduanera, el flete, el tipo de cambio, la inspección y la tarifa del agente deben sustituirse por datos vigentes del proyecto.</small></p>
      </div>
    </section>

    <section class="section article-section">
      <div class="container article-prose--wide">
        <figure class="article-figure">
          <img src="/assets/hymueble/recursos/blog/images/hym-04-img-02-control-calidad-muebles.webp" alt="Ilustración conceptual de inspección dimensional y revisión de acabados de un mueble" width="1536" height="1024" loading="lazy" decoding="async" />
          <figcaption>Ilustración conceptual generada con IA para explicar una inspección; no documenta un control de calidad realizado por HYMUEBLE.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section alt article-section">
      <div class="container article-prose--wide">
        <h2>Escenarios que ayudan a elegir</h2>
        <p>Los umbrales siguientes sirven para organizar la conversación, no para decidir automáticamente.</p>
        <div class="methodology-table">
          <table>
            <thead>
              <tr><th>Escenario de referencia</th><th>Ruta que conviene evaluar primero</th><th>Qué debe confirmarse</th></tr>
            </thead>
            <tbody>
              <tr><td data-label="Escenario">Hotel de 80 o más habitaciones con acabados personalizados</td><td data-label="Ruta">Fabricante directo o intermediario técnico</td><td data-label="Confirmar">Capacidad, mock-up, uniformidad y costo entregado</td></tr>
              <tr><td data-label="Escenario">Renovación de 20-40 puestos con plazo corto</td><td data-label="Ruta">Distribuidor local con stock</td><td data-label="Confirmar">Inventario, compatibilidad, entrega y montaje</td></tr>
              <tr><td data-label="Escenario">300 o más pupitres y mobiliario de laboratorio</td><td data-label="Ruta">Fabricante o integrador especializado</td><td data-label="Confirmar">Normas, medidas, materiales e inspección por categoría</td></tr>
              <tr><td data-label="Escenario">Clínica con mobiliario sujeto a requisitos locales</td><td data-label="Ruta">Distribuidor o especialista con soporte local</td><td data-label="Confirmar">Documentación aplicable y responsabilidad posventa</td></tr>
              <tr><td data-label="Escenario">Hotel boutique de 30-50 habitaciones a medida</td><td data-label="Ruta">Fabricante directo con gestión técnica</td><td data-label="Confirmar">Si el volumen y la complejidad justifican la ruta</td></tr>
              <tr><td data-label="Escenario">Entrega requerida en menos de 6 semanas</td><td data-label="Ruta">Distribuidor con inventario confirmado</td><td data-label="Confirmar">Existencia real y fecha de entrega contractual</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section article-section">
      <div class="container article-prose--wide">
        <h2>Riesgos que deben quedar asignados por escrito</h2>
        <div class="methodology-table">
          <table>
            <thead>
              <tr><th>Riesgo</th><th>Pregunta contractual</th><th>Control recomendado</th></tr>
            </thead>
            <tbody>
              <tr><td data-label="Riesgo">Diferencia entre muestra y lote</td><td data-label="Pregunta">¿Qué documento define la muestra aprobada?</td><td data-label="Control">Muestra identificada, planos y criterios de aceptación</td></tr>
              <tr><td data-label="Riesgo">Defecto detectado después del embarque</td><td data-label="Pregunta">¿Quién recibe la reclamación y qué pruebas exige?</td><td data-label="Control">Inspección, fotos por lote y procedimiento de reclamación</td></tr>
              <tr><td data-label="Riesgo">Retraso de producción</td><td data-label="Pregunta">¿Cuándo empieza a contar el plazo?</td><td data-label="Control">Hitos de muestra, anticipo, materiales y embarque</td></tr>
              <tr><td data-label="Riesgo">Documentación aduanera incompleta</td><td data-label="Pregunta">¿Quién prepara y quién revisa cada documento?</td><td data-label="Control">Lista acordada con el agente aduanal antes de producir</td></tr>
              <tr><td data-label="Riesgo">Montaje no incluido</td><td data-label="Pregunta">¿Qué llega armado y quién instala?</td><td data-label="Control">Alcance, manuales, herramientas, personal y costo separados</td></tr>
              <tr><td data-label="Riesgo">Garantía ambigua</td><td data-label="Pregunta">¿Qué cubre, por cuánto tiempo y con qué exclusiones?</td><td data-label="Control">Anexo de garantía firmado, sin depender de mensajes comerciales</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section alt article-section">
      <div class="container article-prose--wide">
        <figure class="article-figure">
          <img src="/assets/hymueble/recursos/blog/images/hym-04-img-03-contenedor-exportacion.webp" alt="Ilustración conceptual de muebles protegidos y preparados para carga marítima" width="1536" height="1024" loading="lazy" decoding="async" />
          <figcaption>Ilustración conceptual generada con IA para explicar embalaje y logística; no muestra un embarque real de HYMUEBLE.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section article-section">
      <div class="container article-prose">
        <h2>Seis preguntas antes de decidir</h2>
        <ol class="editorial-list">
          <li><strong>¿Quién fabrica y quién factura?</strong> Pida la razón social de ambas partes cuando no coincidan.</li>
          <li><strong>¿Qué nivel de personalización necesita?</strong> Distinga cambios de color de un desarrollo realmente a medida.</li>
          <li><strong>¿Qué plazo admite la obra?</strong> Separe producción, consolidación, tránsito, aduana, entrega y montaje.</li>
          <li><strong>¿Quién puede gestionar la importación?</strong> Identifique la experiencia y tiempo disponibles en su equipo.</li>
          <li><strong>¿Cómo se verificará la calidad?</strong> Defina muestra, inspección y criterios antes del lote.</li>
          <li><strong>¿Quién responde en destino?</strong> Garantía, repuestos, montaje y reclamaciones deben aparecer en la oferta.</li>
        </ol>
        <p>Para entender cómo HYMUEBLE plantea fabricación, muestras y control, consulte la página de <a href="/fabrica/">fabricante de muebles a medida</a>. La disponibilidad y el alcance se confirman únicamente después de revisar cada proyecto.</p>
      </div>
    </section>

    <section class="section alt article-section article-faq">
      <div class="container article-prose">
        <h2>Preguntas frecuentes</h2>
        {faqItems.map((item) => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <CTA
      title="¿Quiere comparar una propuesta directa con una oferta de distribuidor?"
      text="Comparta cantidades, categorías, destino, plazo y nivel de personalización. Podemos ayudarle a ordenar los supuestos y a identificar qué costos o responsabilidades faltan antes de cotizar."
    />

    <section class="section brand-signature">
      <div class="container" style="text-align:center;">
        <p><em>HYMUEBLE | Hongye Furniture Group Co., Ltd. (Guangdong)</em><br />
        <em>Fabricación de mobiliario comercial para proyectos</em><br />
        <em>Plazos, garantía, instalación, importación y soporte se confirman por escrito según cada alcance</em><br />
        <em>Solicite una revisión inicial: <a href="/contacto/">hymueble.com/contacto</a></em></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .comparison-guide {
    --article-ink: #121a22;
    --article-muted: #596672;
    --article-gold: #987848;
    --article-line: #e7e2d9;
    --article-warm: #f8f7f4;
  }

  .comparison-guide img {
    height: auto;
  }

  .comparison-guide .article-hero {
    padding-block: clamp(64px, 6vw, 96px);
    background: linear-gradient(180deg, #fff 0%, #f8f7f4 100%);
  }

  .comparison-guide .article-hero .resource-hero-grid {
    grid-template-columns: minmax(0, .88fr) minmax(480px, 1.12fr);
    gap: clamp(42px, 5vw, 78px);
  }

  .comparison-guide .article-section {
    padding-block: clamp(68px, 6vw, 88px);
  }

  .comparison-guide .article-prose {
    width: min(840px, calc(100% - 48px));
  }

  .comparison-guide .article-prose--wide {
    width: min(980px, calc(100% - 48px));
  }

  .comparison-guide .article-wide {
    width: min(1240px, calc(100% - 48px));
  }

  .comparison-guide .article-section h2 {
    margin: 0 0 22px;
  }

  .comparison-guide .article-section h3 {
    margin: 24px 0 10px;
  }

  .comparison-guide .article-section h4 {
    margin: 30px 0 10px;
  }

  .comparison-guide .article-hero h1,
  .comparison-guide .article-section h2,
  .comparison-guide .article-section h3,
  .comparison-guide .article-section h4 {
    overflow-wrap: anywhere;
  }

  .comparison-guide .article-section p,
  .comparison-guide .article-section li {
    color: var(--article-muted);
    line-height: 1.74;
  }

  .comparison-guide .article-section p {
    margin: 0 0 18px;
  }

  .comparison-guide .article-section ol:not(.compact-list),
  .comparison-guide .article-section ul:not(.compact-list) {
    padding-left: 22px;
    margin: 0 0 22px;
  }

  .comparison-guide .article-section ol li,
  .comparison-guide .article-section ul li {
    margin-bottom: 12px;
  }

  .comparison-guide .article-section strong {
    color: var(--article-ink);
    font-weight: 700;
  }

  .comparison-guide .methodology-table {
    margin: 28px 0;
    overflow-x: auto;
  }

  .comparison-guide .methodology-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.6;
  }

  .comparison-guide .methodology-table thead th {
    padding: 14px 16px;
    border-bottom: 2px solid var(--article-gold);
    color: var(--article-ink);
    font-weight: 800;
    text-align: left;
    font-size: 13px;
    letter-spacing: .03em;
    text-transform: uppercase;
  }

  .comparison-guide .methodology-table tbody td {
    padding: 13px 16px;
    border-bottom: 1px solid var(--article-line);
    color: var(--article-muted);
    vertical-align: top;
  }

  .comparison-guide .methodology-table tbody td:first-child {
    color: var(--article-ink);
    font-weight: 700;
  }

  .comparison-guide .methodology-table tbody tr:nth-child(even) {
    background: var(--article-warm);
  }

  .comparison-guide .article-figure {
    margin: 28px 0;
  }

  .comparison-guide .article-figure img {
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--article-line);
  }

  .comparison-guide .article-figure figcaption {
    margin: 12px 0 0;
    color: var(--article-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .comparison-guide .faq-item {
    padding: 24px 0;
    border-top: 1px solid var(--article-line);
    border-bottom: 0;
  }

  .comparison-guide .faq-item h3 {
    margin: 0 0 10px;
  }

  .comparison-guide .faq-item p {
    display: block;
    margin: 0;
  }

  .comparison-guide .brand-signature {
    padding-block: clamp(34px, 4vw, 50px);
    border-top: 1px solid var(--article-line);
  }

  @media (max-width: 900px) {
    .comparison-guide .article-hero .resource-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .comparison-guide .article-hero,
    .comparison-guide .article-section {
      padding-block: 52px;
    }

