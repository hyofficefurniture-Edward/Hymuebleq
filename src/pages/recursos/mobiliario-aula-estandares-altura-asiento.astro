import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

const pageTitle = "Estándares de mobiliario de aula: EN 1729, BIFMA y altura del asiento";
const pageDescription = "Guía de estándares de mobiliario de aula: tallas EN 1729 0-6, pruebas BIFMA X5.1 y tabla de altura de asiento por grado para licitaciones escolares.";
const keywords = [
  "estándares de mobiliario de aula",
  "EN 1729",
  "altura del asiento",
  "BIFMA X5.1",
  "mobiliario escolar regulable",
  "licitación de mobiliario educativo"
];
const canonicalPath = "/recursos/mobiliario-aula-estandares-altura-asiento/";
const pageImage = "/assets/hymueble/recursos/blog/images/hym-03-img-01-aula-escolar.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-09-17";
const dateModified = "2026-09-17";
const publicationDateLabel = "Publicada el 17 de septiembre de 2026";

const faqItems = [
    { question: "¿Qué altura de asiento corresponde a kínder y primer grado?", answer: "Especifique 310-350 mm, que corresponde a las tallas 1 y 2 de EN 1729. Para salas de maternal y preescolar baje a la talla 0, con 260 mm. Antes de fijar un número, verifique la dispersión real de edades del grupo." },
    { question: "¿EN 1729 o BIFMA: cuál conviene a mi proyecto escolar?", answer: "Depende del mercado. Los proyectos europeos y la mayoría de los internacionales especifican EN 1729-1 y -2; los norteamericanos y los colegios con currículo de EE. UU. especifican ANSI/BIFMA X5.1, normalmente junto con GREENGUARD Gold. El doble cumplimiento es habitual y poco costoso para fabricantes consolidados." },
    { question: "¿Compro sillas escolares regulables o de altura fija?", answer: "Elija regulables cuando las aulas atienden varios grupos de edad, como laboratorios y salas compartidas. Elija altura fija cuando cada aula tiene un solo grupo: suele costar entre un 15 y un 25 % menos por unidad y tiene menos piezas que mantener." },
    { question: "¿Cuál es el pedido mínimo (MOQ) para mobiliario de aula?", answer: "Hongye Furniture Group acompaña programas de FF&E escolar desde lotes piloto pequeños; las corridas estándar suelen iniciar en 100-200 unidades por modelo, con consolidación de varios modelos para llenar contenedores de forma eficiente. Envíenos su programa de aulas y le confirmamos el MOQ exacto por artículo." },
    { question: "¿Cuánto tarda un pedido completo de mobiliario para un colegio?", answer: "El plazo de producción estándar es de 45-60 días tras la aprobación de planos y muestras, según volumen y complejidad de acabados. El envío desarmado reduce el volumen marítimo entre un 40 y un 60 % frente a unidades totalmente ensambladas." },
    { question: "¿El mobiliario escolar se envía desarmado o ensamblado?", answer: "Ambas opciones. La mayoría de los proyectos de exportación viaja desarmado (knock-down) para reducir el flete, con sillas preensambladas o de montaje simple con 4 tornillos en obra. La entrega totalmente ensamblada está disponible para proyectos con mano de obra limitada en sitio." },
    { question: "¿Qué garantía debo exigir en una licitación de mobiliario escolar?", answer: "Pida 5 años de garantía estructural para bastidores y 2 años para mecanismos o pistones de gas, con repuestos garantizados durante 7 años. Exija esas condiciones en el documento de oferta, no solo en el folleto del proveedor." }
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  author: {
    "@type": "Organization",
    name: "Hymueble",
    url: "https://hymueble.com/",
  },
