const keywords = ["recepción mobiliario hotelero", "acta de recepción hotel", "checklist mobiliario contract", "inspección muebles hotel", "montaje hotelero", "lista de pendientes"];
const canonicalPath = "https://hymueble.com/recursos/recepcion-mobiliario-hotelero-checklist/";
const pageImage = "/assets/hymueble/recursos/blog/images/hymD39-a281-hero.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-11-14";
const dateModified = "2026-11-14";

const faqItems = [
    { question: "¿Cuánto tiempo debe durar la inspección de recepción de un lote de habitaciones?", answer: "Para un lote de 30-50 habitaciones, entre tres y cinco días de inspección por fases es un rango realista. Un lote más pequeño puede cerrarse en dos días si el mobiliario es sencillo y el acceso a las plantas está libre." },
    { question: "¿Se puede firmar el acta con pendientes abiertos?", answer: "Sí, y en la mayoría de proyectos es lo recomendable. El acta con reservas permite liberar la apertura y mantener una retención de pago hasta que los pendientes se resuelvan. Lo que no conviene es firmar sin lista de pendientes." },
    { question: "¿Quién paga la reparación de un golpe detectado en la recepción?", answer: "Depende de la evidencia. Si el embalaje está intacto, se trata como defecto de fabricación y lo asume el proveedor. Si el embalaje está dañado, entra el seguro de transporte. La foto del bulto cerrado antes de abrirlo es la prueba que decide." },
    { question: "¿Es necesario desembalar todo el mobiliario en la recepción?", answer: "No es necesario abrir el cien por cien, pero sí una caja por tipología y todas las que presenten golpes o humedad en el embalaje. El resto puede quedar cerrado hasta el momento del montaje, siempre que el packing list esté cotejado." },
    { question: "¿Qué hacer si falta un herraje o un accesorio?", answer: "Se anota como pendiente crítico si bloquea el montaje, se solicita el envío urgente y se documenta la referencia exacta. Si el faltante afecta a una sola habitación, el montaje puede continuar en el resto de la planta." },
    { question: "¿Cómo se controla el color de la tapicería entre lotes?", answer: "Se compara la pieza instalada con la muestra patrón aprobada, poniendo ambas a la luz del ventanal. Si hay diferencia visible, se revisa el número de baño de tela y se separa el lote para que no se mezcle en la misma zona." },
    { question: "¿Qué documentación debe entregarse al cerrar la recepción?", answer: "Fichas técnicas, instrucciones de limpieza y mantenimiento, certificados de materiales, listado de repuestos con referencias y el acta con la lista de pendientes cerrada o con plazos comprometidos." }
