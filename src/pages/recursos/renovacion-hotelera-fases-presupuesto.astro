import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

const pageTitle = "Renovación hotelera por fases: guía y presupuesto FF&E";
const pageDescription = "Renovación hotelera por fases sin cerrar el hotel: cómo dividir alas y plantas, presupuestar el FF&E por etapa y fijar el calendario de instalación.";
const keywords = [
  "renovación hotelera por fases",
  "renovación de hotel sin cerrar",
  "renovación hotelera por etapas",
  "presupuesto FF&E por etapas",
  "calendario de instalación FF&E",
  "proveedor FF&E hotelero"
];
const canonicalPath = "/recursos/renovacion-hotelera-fases-presupuesto/";
const pageImage = "/assets/hymueble/recursos/blog/images/hymD2-es16-hero.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-10-02";
const dateModified = "2026-10-02";
const publicationDateLabel = "Publicada el 2 de octubre de 2026";

const faqItems = [
    { question: "¿Qué significa renovar por fases sin cerrar el hotel?", answer: "Significa dividir la obra en tramos de 40-80 habitaciones o de 1-2 plantas y trabajar en ellos mientras el resto del hotel sigue operando. Cada tramo tiene su propia ventana de obra, su Bill of Materials y su orden de compra. Las áreas comunes y las rutas de evacuación se mantienen libres durante toda la etapa." },
    { question: "¿Cómo se dividen las etapas de una renovación hotelera?", answer: "Lo habitual es cortar por ala del edificio o por planta completa, en bloques de 40-80 habitaciones. La unidad de trabajo suele fijarla la instalación compartida: si dos plantas comparten retorno de aire o montante de fontanería, conviene cerrarlas juntas. La primera etapa se recomienda como planta piloto, de 1-2 plantas." },
    { question: "¿Cuánto dura la producción del FF&E de cada etapa?", answer: "El plazo de producción de referencia es de 45-60 días, contado desde la aprobación por escrito de la muestra de acabado. A ese plazo hay que sumar flete, seguro, despacho y la ventana de instalación de 8-12 semanas por etapa. Por eso el calendario se planifica hacia atrás desde la fecha de reapertura de cada bloque." },
    { question: "¿Cómo se reparte el presupuesto FF&E entre etapas?", answer: "No se reparte en partes iguales. Como referencia de planificación, el casegoods fijo concentra el 45-55 %, el mobiliario suelto y asientos el 20-25 %, y los textiles el 10-15 %. Conviene reservar un 5-8 % de contingencia desde la primera etapa y añadir el utillaje en la etapa piloto." },
    { question: "¿Qué documentos y normas debe entregar el proveedor por etapa?", answer: "Informes de ensayo por lote, no solo certificados de planta. Para tableros y mesas, BIFMA X5.5-2021; para asientos, BIFMA X5.1-2011. En madera con origen trazable, FSC-STD-40-004 V3-1; en emisiones de formaldehído, EPA TSCA Título VI y CARB Fase 2." },
    { question: "¿Cómo se controla la seguridad en obra con huéspedes alojados?", answer: "Con barreras físicas entre zonas, rutas de materiales separadas de las de huéspedes y salidas de evacuación siempre libres. En proyectos alineados con práctica estadounidense, la referencia es NFPA 101, Life Safety Code, que rige las condiciones de ocupación durante la obra. El horario de los trabajos ruidosos debe coordinarse con la operación del hotel." },
    { question: "¿Cuánto se ahorra comprando a fábrica frente a Europa?", answer: "La ventaja de coste de referencia es del 30-50 % sobre el precio FOB, no sobre el precio final puesto en obra. A ese ahorro hay que sumar flete, seguro, arancel e instalación para obtener el coste total. Compare siempre sobre un Bill of Materials común, porque un alcance distinto invalida la comparación." }
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
