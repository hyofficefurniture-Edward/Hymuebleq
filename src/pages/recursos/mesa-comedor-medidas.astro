---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

const pageTitle = "Medidas de mesa de comedor: guía para 4, 6, 8 y 10 personas";
const pageDescription = "Medidas de mesa de comedor para 4, 6, 8 y 10 personas: tamaño del tablero, altura, espacio libre y pasillos según la forma y el material.";
const keywords = [
  "medidas mesa de comedor",
  "mesa de comedor 6 personas",
  "tamaño de mesa para 8 personas",
  "altura mesa de comedor",
  "mesa comedor redonda o rectangular",
  "espacio pasillo comedor"
];
const canonicalPath = "/recursos/mesa-comedor-medidas/";
const pageImage = "/assets/hymueble/recursos/blog/images/hymD1-es25-hero.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-10-01";
const dateModified = "2026-10-01";
const publicationDateLabel = "Publicada el 1 de octubre de 2026";

const faqItems = [
    { question: "¿Cuánto mide una mesa de comedor para 4 personas?", answer: "Para cuatro personas, la medida de referencia es 120 × 80 cm, con 60 cm de ancho por comensal. Si el espacio lo permite, una mesa de 130 a 140 cm ofrece más holgura para fuentes y bandejas. El fondo de 80 cm es el mínimo cómodo; por debajo, el centro de la mesa queda demasiado ajustado." },
    { question: "¿Qué tamaño de mesa necesito para 6 u 8 personas?", answer: "Para seis personas, 160 × 90 cm; para ocho, 200 × 100 cm. Estas medidas asumen 60 cm de ancho por plaza y un fondo que permite colocar una fuente central. Si su sala es estrecha, considere una mesa extensible que pase de 120 a 180 cm solo en ocasiones." },
    { question: "¿Cuánto espacio libre hay que dejar alrededor de la mesa?", answer: "Deje 90 cm en cada lado con sillas y 110 cm donde haya circulación hacia la cocina o la entrada. Esas distancias se miden desde el borde del tablero, con la silla retirada en posición de uso. Sin ellas, la mesa cabe en el plano pero no se usa con comodidad." },
    { question: "¿A qué altura debe estar el tablero de una mesa de comedor?", answer: "El tablero se sitúa a 75 cm del suelo y el asiento a 45 cm, con 62 a 65 cm libres entre el asiento y la parte inferior del tablero. Esa relación permite apoyar los codos y cruzar las piernas. Confirme que sus sillas actuales respetan los 45 cm antes de comprar la mesa." },
    { question: "¿Es mejor una mesa redonda o rectangular?", answer: "La rectangular aprovecha mejor los comedores alargados y permite usar los extremos, mientras la redonda reparte mejor las distancias y evita esquinas. Hasta seis personas, la redonda funciona muy bien; por encima de ocho, la rectangular de 200 a 240 cm es más práctica. La forma de la sala suele decidir el empate." },
    { question: "¿Qué material de tablero conviene para el uso diario?", answer: "La madera maciza se puede lijar y recuperar, la chapa sobre núcleo estable mantiene tableros grandes sin deformarse y la piedra o el compacto resisten mejor las manchas y el calor. Cada uno tiene un coste de mantenimiento distinto. Con niños pequeños y comidas diarias, la madera con acabado protector suele ser la opción más equilibrada." },
    { question: "¿Se puede fabricar una mesa de comedor a medida?", answer: "Sí, y se justifica cuando el comedor es irregular o necesita un tamaño intermedio entre los estándar. La fabricación a medida mantiene el plazo de producción de 45-60 días y una ventaja de coste del 30-50 % frente a la compra minorista. Conviene definir medidas, forma y material antes de confirmar el pedido." }
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  author: {
    "@type": "Organization",
    name: "Hymueble",
    url: "https://hymueble.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Hymueble",
    logo: {
      "@type": "ImageObject",
      url: "https://hymueble.com/assets/hymueble/brand/hongye-shengda-logo.webp",
    },
  },
  image: ["https://hymueble.com/assets/hymueble/recursos/blog/images/hymD1-es25-hero.webp",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/d1001-es25-s1.jpg",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/d1001-es25-s2.jpg"],
  datePublished,
  dateModified,
  mainEntityOfPage: { "@type": "WebPage", "@id": "https://hymueble.com" + canonicalPath },
