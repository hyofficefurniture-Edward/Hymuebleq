  "matriz de proveedores y anexo de contrato",
  "packing de exportación y ensayo de caída",
  "verificar certificaciones CARB P2 y FSC",
  "calendario de la feria primera fase y segunda fase",
  "cotización FF&E para proyecto hotelero",
  "plazo de producción 30-45 días desde la muestra aprobada"
];
const canonicalPath = "/recursos/visitar-fabricas-mobiliario-china-feria-canton-2026/";
const pageImage = "/assets/hymueble/recursos/blog/images/hymD14-a228-hero.jpg";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-10-16";
