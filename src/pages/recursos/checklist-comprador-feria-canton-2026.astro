const pageDescription = "Checklist del comprador FF&E para la Feria de Cantón 2026: especificaciones, proveedores, presupuesto y visita a fábrica antes de volar a Guangzhou.";
const keywords = [
  "checklist comprador feria de cantón",
  "preparación feria de cantón 2026",
  "lista de especificaciones ffe hotel",
  "pre-registro comprador feria de cantón",
  "lista corta de proveedores mobiliario",
  "visita a fábrica guangdong muebles"
