import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

const pageTitle = "Escritorios elevables: especificaciones de compra para empresas";
const pageDescription = "Guía de compra de escritorios elevables eléctricos: motores, ciclo de trabajo, norma BIFMA X5.5, garantías y control de calidad para pedidos corporativos.";
const keywords = [
  "escritorios elevables eléctricos",
  "escritorio elevable dual motor",
  "ciclo de trabajo escritorio",
  "norma BIFMA X5.5",
  "proveedor de escritorios al por mayor",
  "mobiliario de oficina ergonómico"
];
const canonicalPath = "/recursos/escritorios-elevables-especificaciones-compra/";
const pageImage = "/assets/hymueble/recursos/blog/images/hym-02-oficina-ergonomica.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-09-17";
const dateModified = "2026-09-17";
const publicationDateLabel = "Publicada el 17 de septiembre de 2026";

const faqItems = [
    { question: "¿Cuál es la cantidad mínima de pedido (MOQ) para escritorios elevables corporativos?", answer: "Para modelos dual motor estándar, Hongye Furniture Group acepta MOQ desde 50 unidades por contenedor mixto; las especificaciones totalmente personalizadas (tamaño de tablero, laminado, marcaje en panel) suelen partir de 100-200 unidades. Los contenedores mixtos con otras líneas de mobiliario de oficina son habituales en proyectos de una sola sede." },
    { question: "¿Cuánto tarda la producción de un pedido mayorista de escritorios elevables?", answer: "El plazo de producción estándar es de 45-60 días desde el depósito y la aprobación de planos, según el volumen del pedido y la disponibilidad de materiales del tablero. Para pedidos en temporada alta (primer y último trimestre), conviene confirmar con 2-3 semanas de anticipación." },
    { question: "¿Cómo se maneja la garantía en envíos internacionales?", answer: "La garantía se desglosa por componente: típicamente 10 años en estructuras, 5 años en motores y 2-3 años en electrónica. Los reclamos se procesan por análisis de lote y los repuestos viajan con su próximo pedido o por mensajería; para flotas grandes también negociamos paquetes de repuestos del 1-2 %." },
    { question: "¿Los escritorios cumplen las certificaciones eléctricas para Estados Unidos y la Unión Europea?", answer: "Sí. Motores, cajas de control y mandatos llevan conformidad CE para el mercado europeo, y los productos se ensayan bajo ANSI/BIFMA X5.5 en seguridad estructural y mecánica. La documentación, incluidos los informes de ensayo, se entrega con el embarque para su expediente de cumplimiento." },
    { question: "¿Qué ciclo de trabajo necesito realmente para una oficina normal?", answer: "Un ciclo del 10 % con 2 minutos de operación continua basta para el uso típico de 4-8 ajustes diarios. Especificaciones de ciclo superior solo importan en salas de demostración, showrooms o entornos de capacitación donde muchos usuarios ciclan los escritorios con frecuencia." },
    { question: "¿Cómo se organiza el envío de contenedores completos de escritorios?", answer: "Embarcamos FOB, CIF o DDP según la preferencia del comprador, con carga en caja plana optimizada a unas 150-220 unidades por contenedor de 40 pies según el tablero. Todas las cajas se someten a prueba de caída e incluyen herrajes e instrucciones de ensamblaje por puesto de trabajo." },
    { question: "¿Se puede personalizar la marca de los paneles y del embalaje?", answer: "Sí. El marcaje del panel, las memorias de altura preconfiguradas antes del despacho y el embalaje con su marca están disponibles en volumen OEM. Solicitar alturas de memoria de fábrica, según su estudio ergonómico, reduce la fricción de configuración del personal durante el despliegue." }
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  author: {
    "@type": "Organization",
    name: "Hymueble",
    url: "https://hymueble.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Hymueble",
    logo: {
      "@type": "ImageObject",
      url: "https://hymueble.com/assets/hymueble/brand/hongye-shengda-logo.webp",
    },
  },
  image: ["https://hymueble.com/assets/hymueble/recursos/blog/images/hym-02-oficina-ergonomica.webp",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/hmo-10-img-01.png",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/hmo-14-img-01.png"],
