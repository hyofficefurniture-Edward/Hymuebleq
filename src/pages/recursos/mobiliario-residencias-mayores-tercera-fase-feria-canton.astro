              <tr><td data-label="M">Giro de silla de ruedas</td><td data-label="e">150 cm de diámetro libre</td><td data-label="d">Maniobra completa sin marcha atrás</td><td data-label="i">Prueba con silla en el ambiente real</td></tr>
              <tr><td data-label="M">Ruedas y frenos</td><td data-label="e">Bloqueo en las cuatro ruedas</td><td data-label="d">Evita desplazamientos al sentarse</td><td data-label="i">Empuje con el freno puesto</td></tr>
              <tr><td data-label="M">Fijación antivuelco</td><td data-label="e">Anclaje a pared en armarios de más de 120 cm</td><td data-label="d">Evita el vuelco por apoyo o tracción</td><td data-label="i">Revisión del anclaje y prueba de tracción</td></tr>
              <tr><td data-label="M">Luz de paso e interruptores</td><td data-label="e">Interruptores a 90-110 cm y luz baja a 20-30 cm</td><td data-label="d">Alcance sin bajarse de la cama</td><td data-label="i">Prueba nocturna en la habitación muestra</td></tr>
