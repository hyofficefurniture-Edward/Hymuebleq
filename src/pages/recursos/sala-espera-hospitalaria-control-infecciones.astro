---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

const pageTitle = "Mobiliario para sala de espera hospitalaria y control de infecciones";
const pageDescription = "Guía de especificación de mobiliario para sala de espera hospitalaria: telas antimicrobianas, vinilos aptos para lejía, costuras termofusionadas e ICRA.";
const keywords = [
  "mobiliario sala de espera hospitalaria",
  "control de infecciones",
  "tela antimicrobiana",
  "vinilo apto para lejía",
  "poliuretano integral",
  "ICRA"
];
const canonicalPath = "/recursos/sala-espera-hospitalaria-control-infecciones/";
const pageImage = "/assets/hymueble/recursos/blog/images/hym-05-img-01-marco-sofa-taller.webp";
const pageImageUrl = `https://hymueble.com${pageImage}`;
const datePublished = "2026-09-17";
const dateModified = "2026-09-17";
const publicationDateLabel = "Publicada el 17 de septiembre de 2026";

const faqItems = [
    { question: "¿Qué ciclo mínimo de desinfección debe soportar el tapizado de una sala de espera?", answer: "Especifique al menos 10 ciclos de desinfección diarios durante la vida del producto, lo que en la práctica equivale a 500-1.000 ciclos documentados al año. Exija que el informe de resistencia química del proveedor indique ciclos probados frente a amonio cuaternario y lejía 1:10, no solo frente a limpiadores de base acuosa." },
    { question: "¿Basta la tela antimicrobiana por sí sola para el control de infecciones?", answer: "No. Los agentes antimicrobianos frenan el crecimiento microbiano en superficie, pero no sustituyen la limpieza mecánica ni una barrera frente a fluidos. La tela antimicrobiana es adecuada para asientos de consulta de bajo riesgo; las salas expuestas a fluidos corporales deben usar vinilo apto para lejía o poliuretano integral." },
    { question: "¿Qué significa exactamente «vinilo apto para lejía» en un pliego?", answer: "Significa que el vinilo lleva una capa superior reticulada probada frente a hipoclorito sódico a dilución 1:10 (unos 5.000 ppm) durante cientos de ciclos sin agrietarse, amarillear ni perder el recubrimiento. Pida el informe de ensayo que indique la concentración de lejía y el número de ciclos." },
    { question: "¿Por qué fallan las costuras cosidas en los asientos sanitarios?", answer: "Cada perforación de aguja es un microcanal por el que los fluidos ascienden hasta la espuma, donde no se pueden desinfectar y se convierten en un reservorio de contaminación permanente. Las costuras termofusionadas o invertidas, o el poliuretano completamente sin costuras, eliminan esa vía." },
    { question: "¿Cuál es el MOQ y el plazo de producción para pedidos de proyecto?", answer: "Hongye Furniture Group atiende desde paquetes de vestíbulo de un solo lote en adelante, con un plazo de producción estándar de 45-60 días desde la confirmación del pedido para asientos sanitarios certificados BIFMA, incluida la inspección previa al embarque y la carga de contenedor desde nuestras plantas de Guangdong." },
    { question: "¿Cómo se gestionan el envío y la garantía en proyectos sanitarios internacionales?", answer: "El mobiliario viaja montado o desmontado con protección de cantos y asegurado según los términos comerciales pactados. La garantía estructural habitual es de 5 años en estructuras y 2 años en tapizados, con la documentación GREENGUARD Gold y CE aportada en cada embarque para revisiones de aduanas y acreditación." },
    { question: "¿Cómo debe referenciar el ICRA al proveedor de mobiliario?", answer: "Adjunte en la fase de RFQ la especificación de materiales, la declaración de compatibilidad con desinfectantes, los certificados de bajas emisiones y el plan de secuencia de montaje al expediente del ICRA, de modo que el equipo de prevención de infecciones revise y apruebe antes de emitir las órdenes de compra." }
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  author: {
    "@type": "Organization",
    name: "Hymueble",
    url: "https://hymueble.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Hymueble",
    logo: {
      "@type": "ImageObject",
      url: "https://hymueble.com/assets/hymueble/brand/hongye-shengda-logo.webp",
    },
  },
  image: ["https://hymueble.com/assets/hymueble/recursos/blog/images/hym-05-img-01-marco-sofa-taller.webp",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/hmo-08-img-01.png",
  "https://hymueble.com/assets/hymueble/recursos/blog/images/hmo-05-img-01.png"],
  datePublished,
  dateModified,
  mainEntityOfPage: { "@type": "WebPage", "@id": "https://hymueble.com" + canonicalPath },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
