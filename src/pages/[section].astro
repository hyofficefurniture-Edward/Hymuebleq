---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import TrustStrip from "../components/TrustStrip.astro";
import ProductosDestacados from "../components/ProductosDestacados.astro";
import CTA from "../components/CTA.astro";
import { categories, projects, sectorCatalogs, sectorPages, showrooms } from "../data/site";

const featuredProductsBySection: Record<string, { listHref: string; listLabel: string; items: { url: string; img: string; title: string }[] }> = {
  oficinas: {
    listHref: "/productos-oficina/",
    listLabel: "Ver todos los productos de oficina",
    items: [
      { url: "/productos-oficina/escritorio-ejecutivo-gerente-chapa-madera/", img: "/images/productos-oficina/of-01/of-01-01.jpg", title: "Escritorio Ejecutivo para Gerente con Chapa de Madera" },
      { url: "/productos-oficina/estacion-trabajo-modular-oficina-abierta/", img: "/images/productos-oficina/of-02/of-02-01.jpg", title: "Estación de Trabajo Modular para Oficina Abierta" },
      { url: "/productos-oficina/mesa-reuniones-modular-corporativos/", img: "/images/productos-oficina/of-03/of-03-01.jpg", title: "Mesa de Reuniones Modular para Corporativos" },
      { url: "/productos-oficina/silla-ergonomica-oficina-soporte-lumbar/", img: "/images/productos-oficina/of-04/of-04-01.jpg", title: "Silla Ergonómica de Oficina con Soporte Lumbar" },
    ],
  },
  salud: {
    listHref: "/productos-medicos/",
    listLabel: "Ver todos los productos médicos",
    items: [
      { url: "/productos-medicos/mobiliario-sala-consulta-medica-antibacteriano/", img: "/images/productos-medicos/med-01/med-01-01.jpg", title: "Mobiliario para Sala de Consulta Médica Antibacteriano" },
      { url: "/productos-medicos/mobiliario-sala-exploracion-clinica-modular/", img: "/images/productos-medicos/med-02/med-02-01.jpg", title: "Mobiliario para Sala de Exploración Clínica Modular" },
      { url: "/productos-medicos/equipamiento-habitacion-hospitalaria-curacion/", img: "/images/productos-medicos/med-03/med-03-01.jpg", title: "Equipamiento Integral de Habitación Hospitalaria de Curación" },
      { url: "/productos-medicos/mostrador-recepcion-hospitalaria-antimicrobiano/", img: "/images/productos-medicos/med-04/med-04-01.jpg", title: "Mostrador de Recepción Hospitalaria Antimicrobiano Modular" },
    ],
  },
  educacion: {
    listHref: "/productos-escolares/",
    listLabel: "Ver todos los productos escolares",
    items: [
      { url: "/productos-escolares/mobiliario-educacion-infantil-seguro-cantos-redondeados/", img: "/images/productos-escolares/esc-01/esc-01-01.jpg", title: "Mobiliario para Educación Infantil Seguro con Cantos Redondeados" },
      { url: "/productos-escolares/mobiliario-modular-aprendizaje-colaborativo-aulas/", img: "/images/productos-escolares/esc-02/esc-02-01.jpg", title: "Mobiliario Modular para Aprendizaje Colaborativo en Aulas" },
      { url: "/productos-escolares/asientos-colaborativos-modulares-espacios-sociales-campus/", img: "/images/productos-escolares/esc-03/esc-03-01.jpg", title: "Asientos Colaborativos Modulares para Espacios Sociales del Campus" },
      { url: "/productos-escolares/estanterias-libreria-escolar-modulares-madera-e1/", img: "/images/productos-escolares/esc-04/esc-04-01.jpg", title: "Estanterías de Librería Escolar Modulares en Madera E1" },
    ],
  },
  residencial: {
    listHref: "/productos-residenciales/",
    listLabel: "Ver todos los productos residenciales",
    items: [
      { url: "/productos-residenciales/suite-completa-mobiliario-apartamento-madera-natural/", img: "/images/productos-residenciales/res-01/res-01-01.jpg", title: "Suite Completa de Mobiliario para Apartamento con Madera Natural" },
      { url: "/productos-residenciales/mobiliario-penthouse-lujo-medida-ffe-integral/", img: "/images/productos-residenciales/res-02/res-02-01.jpg", title: "Mobiliario de Penthouse de Lujo a Medida con FF&E Integral" },
      { url: "/productos-residenciales/isla-cocina-medida-residencias-lujo-piedra-natural/", img: "/images/productos-residenciales/res-03/res-03-01.jpg", title: "Isla de Cocina a Medida con Encimera de Piedra Natural" },
      { url: "/productos-residenciales/mobiliario-salon-dormitorio-moderno-madera-certificada/", img: "/images/productos-residenciales/res-04/res-04-01.jpg", title: "Mobiliario de Salón y Dormitorio Moderno con Madera Certificada FSC" },
    ],
  },
};
const featuredEyebrowLabels: Record<string, string> = {
  oficinas: "Productos de oficina",
  salud: "Productos médicos",
  educacion: "Productos escolares",
  residencial: "Productos residenciales",
};
const featuredSectionTitles: Record<string, string> = {
  oficinas: "Mobiliario de oficina listo para cotizar",
  salud: "Mobiliario médico listo para cotizar",
  educacion: "Mobiliario escolar listo para cotizar",
  residencial: "Mobiliario residencial listo para cotizar",
};
const featuredSectionTexts: Record<string, string> = {
  oficinas: "Revisa escritorios, estaciones de trabajo, sillas y cabinas con especificaciones técnicas para incluirlos en tu cotización.",
  salud: "Revisa consultorios, camas hospitalarias y mobiliario clínico con superficies antibacterianas y especificaciones técnicas.",
  educacion: "Revisa pupitres, sillas, estanterías y mobiliario Montessori con certificación de seguridad infantil.",
  residencial: "Revisa suites de apartamento, mobiliario de villa y soluciones llave en mano para proyectos residenciales.",
};

export function getStaticPaths() {
  return Object.keys(sectorPages).map((section) => ({ params: { section } }));
}

const section = Astro.params.section ?? "oficinas";
const featuredData = featuredProductsBySection[section];
const data = sectorPages[section as keyof typeof sectorPages];
const category = categories.find((item) => item.href.endsWith(`/${section}/`)) ?? categories[1];
const catalogItems = sectorCatalogs[section as keyof typeof sectorCatalogs] ?? [];
const showroomBySection = {
  oficinas: showrooms[1],
  salud: showrooms[2],
  educacion: showrooms[3],
};
const sectorShowroom = showroomBySection[section as keyof typeof showroomBySection];
const sectorProjects = projects.filter((project) => {
  const normalized = project.sector.toLowerCase();
  return normalized === category.title.toLowerCase() || normalized === section;
});
const hasSectorProjects = sectorProjects.length > 0;
const showcaseImage = sectorShowroom?.image ?? category.projectImage;
const catalogAudienceLabels = {
  oficinas: "oficinas",
  salud: "salud",
  educacion: "educación",
  residencial: "proyectos residenciales",
};
const projectContextLabels = {
  oficinas: "de oficina",
  salud: "de salud",
  educacion: "educativo",
  residencial: "residencial",
};
const trustCopy = {
  oficinas: {
    title: "Experiencia para oficinas corporativas, campus y compras institucionales",
    text: "Fabricación directa, documentación de proyecto, control de materiales y capacidad para espacios de trabajo.",
    partnerEyebrow: "Referencias de oficina",
    partnerTitle: "Referencias para sedes, parques industriales y equipos corporativos",
    partnerText: "Casos y referencias útiles para abrir conversación comercial. Alcance, cantidades y documentación se revisan al avanzar la consulta.",
    partnerBrands: [
      { name: "Macwell", tone: "wide" },
      { name: "Walmart Costa Rica", tone: "condensed" },
      { name: "BYD", tone: "wide" },
      { name: "Alibaba Group", tone: "serif" },
      { name: "Kuwait Oil Company", tone: "condensed" },
      { name: "Trinidad y Tobago", tone: "soft" },
    ],
  },
  salud: {
    title: "Mobiliario para hospitales, clínicas y espacios médicos",
    text: "Muebles para salas de espera, habitaciones, estaciones de enfermería, áreas clínicas y espacios de atención.",
    partnerEyebrow: "Referencias de salud",
    partnerTitle: "Referencias para hospitales públicos, privados e internacionales",
    partnerText: "Puedes revisar escala, áreas visibles y tipo de mobiliario antes de preparar una cotización médica.",
    partnerBrands: [
      { name: "Woodlands Health", tone: "serif" },
      { name: "Saudi German", tone: "wide" },
      { name: "Heshan Hospital", tone: "condensed" },
      { name: "Ganjiang Hospital", tone: "soft" },
      { name: "Yueda Ruikang", tone: "wide" },
      { name: "Maternal & Child", tone: "serif" },
    ],
  },
  educacion: {
    title: "Experiencia para escuelas, universidades y campus educativos",
    text: "Muebles para aulas, auditorios, bibliotecas, comedor, dormitorios y espacios de aprendizaje.",
    partnerEyebrow: "Referencias educativas",
    partnerTitle: "Referencias para colegios, universidades y academias",
    partnerText: "Puedes comparar espacios, instalación, durabilidad y soporte por lote antes de cotizar.",
    partnerBrands: [
      { name: "Huntington Lagos", tone: "serif" },
      { name: "SIT Singapore", tone: "wide" },
      { name: "Charterhouse Lagos", tone: "condensed" },
      { name: "Rwanda Academy", tone: "soft" },
      { name: "BBK School", tone: "wide" },
      { name: "AUB Baghdad", tone: "serif" },
    ],
  },
  residencial: {
    title: "Experiencia para apartamentos, residencias y compras por proyecto",
    text: "Muebles a medida para apartamentos, lobby, salas, dormitorios, almacenaje y compras residenciales por lote.",
    partnerEyebrow: "Referencias residenciales",
    partnerTitle: "Referencias para apartamentos y espacios residenciales",
    partnerText: "Los casos documentados ayudan a revisar estilo, almacenamiento, materiales y alcance antes de cotizar.",
    partnerBrands: [
      { name: "Lingkong Talent", tone: "wide" },
      { name: "Wutong Village", tone: "serif" },
      { name: "Jiafu Talent", tone: "condensed" },
      { name: "Apartamentos", tone: "soft" },
      { name: "Vestidores", tone: "wide" },
      { name: "Salas lounge", tone: "serif" },
    ],
  },
};
const catalogAudienceLabel = catalogAudienceLabels[section as keyof typeof catalogAudienceLabels] ?? category.title.toLowerCase();
const projectContextLabel = projectContextLabels[section as keyof typeof projectContextLabels] ?? `de ${category.title.toLowerCase()}`;
const trust = trustCopy[section as keyof typeof trustCopy];
const showroomHeading =
  sectorShowroom
    ? `Revisa el showroom de ${sectorShowroom.sector.toLowerCase()} antes de cotizar`
    : `Comparte referencias visuales para tu proyecto ${projectContextLabel}`;
const showroomNote =
  sectorShowroom
    ? `${sectorShowroom.description} Puedes usarlo para revisar referencias antes de definir cantidades, acabados y tiempos.`
    : "Puedes enviar imágenes, planos o referencias para revisar estilo, cantidades, acabados y próximos pasos antes de cotizar.";
const contactLabel = "Enviar datos iniciales";
const projectReferenceText =
  hasSectorProjects
    ? "Referencias para comparar espacios, alcance y capacidad antes de cotizar."
    : "Puedes enviar datos iniciales para preparar referencias comparables sin usar casos de otro sector.";
---
<BaseLayout title={`${data.title} | Hymueble`} description={data.seoDescription ?? data.lead} keywords={data.seoKeywords} image={data.image}>
  <Hero
    eyebrow={data.eyebrow}
    title={data.title}
    lead={data.lead}
    image={data.image}
    badgeTitle="Solución por proyecto"
    badgeText="Catálogo, personalización, producción y exportación desde China."
    primaryLabel="Solicitar cotización"
    primaryHref="/contacto/"
    secondaryLabel="Ver catálogo"
    secondaryHref={data.catalogHref}
  />

  <section class="section alt">
    <div class="container">
      <SectionHead
        eyebrow="Catálogo"
        title={`Catálogo de muebles para ${catalogAudienceLabel}`}
        text="Elige el espacio a equipar y revisa familias de muebles adaptables a materiales, acabados y medidas del proyecto."
      />
      <div class="hotel-catalog-tiles">
        {catalogItems.map((item) => (
          <a class="hotel-catalog-tile" href={item.href}>
            <img src={encodeURI(item.image)} alt={item.alt ?? item.title} loading="lazy" decoding="async" />
            <span>{item.title}</span>
            <small>{item.description}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-band">
      <div>
        <p class="eyebrow">Showroom virtual</p>
        <h2>{showroomHeading}</h2>
        <p class="section-note">{showroomNote}</p>
        <div class="btn-row section-actions">
          {sectorShowroom ? (
            <a class="btn primary" href={sectorShowroom.href} data-showroom-modal data-showroom-title={`Showroom virtual de ${sectorShowroom.sector}`}>Ver showroom virtual</a>
          ) : (
            <a class="btn primary" href="/contacto/">Enviar referencias</a>
          )}
          <a class="btn line" href="/contacto/">{contactLabel}</a>
        </div>
      </div>
      <img src={encodeURI(showcaseImage)} alt={sectorShowroom ? `Showroom virtual para ${sectorShowroom.sector}` : category.projectAlt} loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <SectionHead
        eyebrow="Proyectos"
        title={`Proyectos y referencias para ${catalogAudienceLabel}`}
        text={projectReferenceText}
      />
      {hasSectorProjects ? (
        <div class="card-grid">
          {sectorProjects.map((project) => <ProjectCard project={project} imageField="listingImage" />)}
        </div>
      ) : (
        <div class="proof-grid">
          {data.proof.map((item) => (
            <div class="info-card compact">
              <strong>{item}</strong>
              <span>Enfoque por proyecto para compras por lote, remodelaciones, nuevos proyectos y distribución.</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TrustStrip
        eyebrow="Cooperación y respaldo"
        title={trust.title}
        text={trust.text}
        partnerBrands={trust.partnerBrands}
        partnerEyebrow={trust.partnerEyebrow}
        partnerTitle={trust.partnerTitle}
        partnerText={trust.partnerText}
        compact
      />
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <SectionHead
        eyebrow="Proceso"
        title="Proceso de suministro para proyectos"
        text="El proceso conserva los pasos principales para compras por proyecto: cotización, diseño, producción, inspección y logística."
      />
      <ProcessSteps />
    </div>
  </section>

  {featuredData && (
    <ProductosDestacados
      eyebrow={featuredEyebrowLabels[section] ?? "Productos destacados"}
      title={featuredSectionTitles[section] ?? "Productos listos para cotizar"}
      text={featuredSectionTexts[section] ?? "Revisa productos con especificaciones, fotos y tablas técnicas para incluirlos en tu cotización por proyecto."}
      products={featuredData.items}
      listHref={featuredData.listHref}
      listLabel={featuredData.listLabel}
    />
  )}

  <CTA />
</BaseLayout>