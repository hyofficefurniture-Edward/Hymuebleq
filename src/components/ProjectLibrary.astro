---
import projects from '../data/project-library.json';
import copies from '../data/project-library-copy.json';
const {lang='es',base='/en/',id='',featured=false}=Astro.props;
const t=(copies as Record<string,string[]>)[lang]||copies.es;
const sector=(v:string)=>t[({hospitality:12,office:13,healthcare:14,education:15,resort:16} as Record<string,number>)[v]]||v;
const region=(v:string)=>t[({'central-asia':17,africa:18,'middle-east':19,'southeast-asia':20,china:21,other:22,caribbean:23,'latin-america':26} as Record<string,number>)[v]]||v;
const selected=projects.find(c=>c.id===id);
const detailCopy=(selected as any)?.localized?.[lang];
const list=featured?projects.slice(0,6):projects;
const location=(c:any)=>c.country==='Asia'?(lang==='ru'?'Азия — страна уточняется':lang==='kk'?'Азия — ел нақтыланады':lang==='uz'?'Osiyo — mamlakat aniqlanadi':lang==='mn'?'Ази — улсыг тодруулна':'Asia — país por confirmar'):c.country;
const regional=base.startsWith('/ru/')||base.startsWith('/mn/');
const productSlug=selected?({hospitality:'catalogo/hoteles',resort:'catalogo/hoteles',office:'catalogo/oficinas',education:'catalogo/educacion',healthcare:'catalogo/salud'} as Record<string,string>)[selected.industry]:'hotel-furniture';
const canonical='https://hymueble.com'+base+'proyectos/biblioteca/'+(id?id+'/':'');
---
<section class="section project-library"><div class="wrap">
{selected ? <><p><a href={`${base}proyectos/`}>{t[0]}</a></p><h1>{selected.name}</h1><p class="section__lead">{location(selected)} · {sector(selected.industry)}</p><figure><img src={selected.image} alt={`${selected.name} — ${sector(selected.industry)}`} width={(selected as any).imageWidth||1400} height={(selected as any).imageHeight||1000}/><figcaption>{t[9]}</figcaption></figure><h2>{t[6]}</h2><p>{detailCopy?.intro||t[11]}</p>{detailCopy&&<ul>{detailCopy.spaces.map((space:string)=><li>{space}</li>)}</ul>}<p>{selected.name} · {location(selected)} · {sector(selected.industry)}</p><h2>{t[7]}</h2><p>{t[10]}</p>{detailCopy&&<ul>{detailCopy.questions.map((q:string)=><li>{q}</li>)}</ul>}<div class="grid grid--3">{(selected as any).gallery?.slice(1).map((g:any)=><figure><img src={g.image} alt={selected.name} loading="lazy" width="900" height="650"/></figure>)}</div><p><a class="btn btn--primary" href={`${base}contacto/?reference=${selected.id}`}>{t[8]}</a> <a class="btn btn--ghost" href={`${base}${productSlug}/`}>{t[24]}</a></p>{(selected as any).sourceUrl&&<p><a href="/project-knowledge.json" target="_blank" rel="noopener">{t[27]} ↗</a></p>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:selected.name,description:detailCopy?.intro||t[11],inLanguage:lang,url:canonical,image:'https://hymueble.com'+selected.image,author:{'@type':'Organization',name:'Hongye Furniture Group'}})}/></> : <>
{featured?<h2>{t[0]}</h2>:<h1>{t[0]}</h1>}<p>{t[25]}</p>{!featured&&<div class="project-library-controls">{[['region',1],['country',2],['industry',3]].map(([key,label])=><label>{t[Number(label)]}<select data-project-select={key}><option value="">{t[4]}</option>{[...new Set(projects.map(c=>(c as any)[key]))].map(v=><option value={v}>{key==='region'?region(v):key==='industry'?sector(v):v==='Asia'?'Asia — país por confirmar':v}</option>)}</select></label>)}<p data-project-count aria-live="polite">{projects.length}</p></div>}
<div class="grid grid--3">{list.map(c=><article class="project-library-card" data-region={c.region} data-country={c.country} data-industry={c.industry}><a href={`${base}proyectos/biblioteca/${c.id}/`}><img src={c.image} alt={`${c.name} — ${location(c)}`} loading="lazy" width="900" height="650"/><div><p>{location(c)} · {sector(c.industry)}</p><h3>{c.name}</h3><span>{t[5]} ↗</span></div></a></article>)}</div>{featured&&<p><a class="btn btn--ghost" href={`${base}proyectos/`}>{t[0]} · {projects.length} ↗</a></p>}</>}
</div></section>
<style>.project-library .wrap{max-width:1240px;margin:auto;padding:0 20px}.project-library .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.project-library figure{margin:0 0 24px}.project-library img{width:100%;height:auto}.project-library-card{border:1px solid #d8ddd8;min-width:0;background:white;border-radius:12px;overflow:hidden}.project-library-card img{aspect-ratio:1.4;object-fit:cover}.project-library-card div{padding:20px}.project-library-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 0}.project-library-controls select{display:block;width:100%;padding:12px}.project-library-card[hidden]{display:none}.project-library h1{overflow-wrap:anywhere}@media(max-width:760px){.project-library .grid,.project-library-controls{grid-template-columns:1fr}}</style>
<script is:inline>document.querySelectorAll('.project-library').forEach(root=>{const selects=[...root.querySelectorAll('[data-project-select]')];const cards=[...root.querySelectorAll('.project-library-card')];selects.forEach(s=>s.addEventListener('change',()=>{cards.forEach(c=>{c.hidden=selects.some(f=>f.value&&c.dataset[f.dataset.projectSelect]!==f.value)});root.querySelector('[data-project-count]').textContent=cards.filter(c=>!c.hidden).length}))});</script>
